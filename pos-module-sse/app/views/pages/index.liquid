---
slug: /
method: get
layout: application
---
{% liquid
  assign sender_name = context.current_user.email | default: 'Anonymous'
%}
<section class="pos-card pos-card-highlighted">
  <h1 class="pos-heading-3">Live activity feed</h1>
  <p class="pos-supplementary">Posting as <strong>{{ sender_name }}</strong>. Open this page in a second tab to watch events arrive there too — delivery lands within about a second, since it's powered by the browser reconnecting to the stream roughly every second rather than a held-open socket (see the module README for why).</p>
  <p id="pos-sse-status" class="pos-supplementary">Connecting…</p>

  <form id="pos-sse-form" class="pos-form pos-form-simple">
    <fieldset>
      <label for="sse-text" class="pos-visually-hidden">Message</label>
      <input type="text" id="sse-text" placeholder="Post an update…" class="pos-form-input" autocomplete="off">
    </fieldset>
    <fieldset class="pos-form-actions">
      <button type="submit" class="pos-button pos-button-primary">Publish</button>
    </fieldset>
  </form>

  <ul id="pos-sse-feed"></ul>
</section>

<script type="module">
  (function() {
    var channel = 'activity';
    var senderName = {{ sender_name | json }};
    var status = document.getElementById('pos-sse-status');
    var feed = document.getElementById('pos-sse-feed');
    var form = document.getElementById('pos-sse-form');
    var input = document.getElementById('sse-text');

    function prependEvent(text) {
      var li = document.createElement('li');
      li.textContent = new Date().toLocaleTimeString() + ' — ' + text;
      feed.prepend(li);
    }

    window.pos.modules.active.sse.connect(channel, {
      onOpen: function() { status.textContent = 'Connected.'; },
      onError: function() { status.textContent = 'Reconnecting…'; },
      onMessage: function(data) { prependEvent(data); }
    });

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var text = input.value.trim();
      if (!text) return;
      input.value = '';

      var body = new URLSearchParams({
        channel: channel,
        data: senderName + ': ' + text
      });
      fetch('/sse/events', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString()
      });
    });
  })();
</script>
