---
metadata:
  name: SSE Init
  params:
    stream_url: "/sse/stream"
---
{% doc %}
  Sets up window.pos.modules.sse, a thin wrapper over the browser's native
  EventSource. There's no manual reconnect logic here — EventSource already
  auto-reconnects (tuned by the `retry:` field the server sends) and resumes
  via the `Last-Event-ID` header it resends automatically, so wiring this up
  once behaves like a single persistent connection.

  Every reconnect is a real HTTP request, so an open, visible tab costs
  roughly (1 / retryMs-in-seconds) requests/sec for as long as it's open —
  see modules/sse/README.md "Load characteristics" before picking a
  retryMs for anything with many concurrent viewers. Backgrounded tabs cost
  nothing: by default this pauses the connection on visibilitychange and
  resumes it when the tab is foregrounded again.

  API:
    window.pos.modules.sse.connect(channel, {
      onMessage, onOpen, onError,
      retryMs,            // default 1000 — how often an idle tab reconnects
      pauseWhenHidden      // default true — close the connection while the tab is backgrounded
    }) -> { close() }
{% enddoc %}
{% liquid
  assign stream_url = stream_url | default: '/sse/stream'
%}
<script type="module">
  if (!window.pos) window.pos = {};
  if (!window.pos.modules) window.pos.modules = {};
  if (!window.pos.modules.active) window.pos.modules.active = {};

  window.pos.modules.sse = {
    connect: function(channel, callbacks) {
      callbacks = callbacks || {};
      var retryMs = callbacks.retryMs || 1000;
      var pauseWhenHidden = callbacks.pauseWhenHidden !== false;
      var url = '{{ stream_url }}' + '?channel=' + encodeURIComponent(channel) + '&retry=' + encodeURIComponent(retryMs);
      var source = null;
      var closedByCaller = false;

      function open() {
        if (closedByCaller || source) return;
        source = new EventSource(url);
        if (callbacks.onOpen) source.onopen = callbacks.onOpen;
        if (callbacks.onError) source.onerror = callbacks.onError;
        if (callbacks.onMessage) source.onmessage = function(e) { callbacks.onMessage(e.data, e); };
      }

      function pause() {
        if (source) { source.close(); source = null; }
      }

      function onVisibilityChange() {
        if (document.hidden) {
          pause();
        } else {
          open();
        }
      }

      open();

      if (pauseWhenHidden) {
        document.addEventListener('visibilitychange', onVisibilityChange);
      }

      return {
        close: function() {
          closedByCaller = true;
          pause();
          if (pauseWhenHidden) document.removeEventListener('visibilitychange', onVisibilityChange);
        }
      };
    }
  };

  window.pos.modules.active.sse = window.pos.modules.sse;
</script>
