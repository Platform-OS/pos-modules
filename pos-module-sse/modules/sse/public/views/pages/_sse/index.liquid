---
slug: _sse
method: get
layout: ''
---
{% doc %}
  Dev/staging-only page to test the SSE stream end-to-end without a demo
  app: opens a live EventSource against channel "_sse_test" and lets you
  publish test events into it. Mirrors the `_push_notifications` convention
  used by pos-module-push-notifications (same env gate, same standalone
  page with no dependency on the tests module).
{% enddoc %}
{% if context.environment == 'staging' or context.environment == 'development' %}
  {% assign published = context.params.published %}
<!DOCTYPE html>
<html lang="{{ context.language }}">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <title>SSE — Test</title>
    <style>
      body { font-family: ui-sans-serif, system-ui, sans-serif; max-width: 40rem; margin: 2rem auto; color: #374151; }
      h1 { font-size: 1.25rem; }
      .notice { padding: .75rem 1rem; border-radius: .25rem; margin-bottom: 1rem; background: #ecfdf5; border: 1px solid #a7f3d0; }
      label { display: block; margin-top: .75rem; font-weight: 600; }
      input[type="text"] { width: 100%; padding: .5rem; margin-top: .25rem; border: 1px solid #d1d5db; border-radius: .25rem; }
      button { margin-top: 1rem; padding: .5rem 1rem; border: 0; border-radius: .25rem; background: #111827; color: #fff; cursor: pointer; }
      #pos-sse-log { margin-top: 1.5rem; padding: .75rem 1rem; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: .25rem; min-height: 6rem; white-space: pre-wrap; font-family: ui-monospace, monospace; font-size: .8rem; }
    </style>
  </head>
  <body>
    <h1>SSE — Test</h1>

    {% if published != blank %}
      <p class="notice">Published.</p>
    {% endif %}

    <form method="post" action="/_sse">
      <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
      <label for="pos-sse-data">Message</label>
      <input type="text" id="pos-sse-data" name="data" value="Hello from the SSE test page.">
      <button type="submit">Publish test event</button>
    </form>

    <div id="pos-sse-log">(connecting…)</div>

    <script type="module">
      var log = document.getElementById('pos-sse-log');
      var source = new EventSource('/sse/stream?channel=_sse_test');
      source.onopen = function() { log.textContent = '(connected, waiting for events)'; };
      source.onmessage = function(e) {
        var line = new Date().toLocaleTimeString() + ' — ' + e.data;
        log.textContent = log.textContent === '(connected, waiting for events)' ? line : log.textContent + '\n' + line;
      };
    </script>
  </body>
</html>
{% endif %}
