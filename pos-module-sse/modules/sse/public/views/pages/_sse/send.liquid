---
slug: _sse
method: post
---
{% doc %}
  Handles the test-publish form from `_sse/index.liquid`: publishes to the
  "_sse_test" channel and redirects back.
{% enddoc %}
{% liquid
  unless context.environment == 'staging' or context.environment == 'development'
    return
  endunless

  assign data = context.params.data | default: 'Hello from the SSE test page.'

  function result = 'modules/sse/commands/events/publish', channel: '_sse_test', event: null, data: data

  redirect_to '/_sse?published=1'
%}
