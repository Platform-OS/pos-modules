---
slug: sse/events
method: post
format: json
layout: ''
---
{% doc %}
  Publishes an event to a channel. Public by default (no auth) — override
  this file (Module Override System) to add authorization.

  Body params: channel (required), event (optional, default "message"), data (required)
{% enddoc %}
{% liquid
  function result = 'modules/sse/commands/events/publish',
    channel: context.params.channel,
    event: context.params.event,
    data: context.params.data

  if result.valid == false
    assign response = { "ok": false, "errors": result.errors }
  else
    assign response = { "ok": true, "id": result.id, "created_at": result.created_at }
  endif
%}{{ response | json }}
