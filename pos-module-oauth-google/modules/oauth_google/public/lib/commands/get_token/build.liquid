{% doc %}
  @param {object} object - The object containing token request data
  @param {string} location - The redirect URI location
{% enddoc %}
{% parse_json object %}
  {
    "grant_type": "authorization_code",
    "code": {{ object.code | json }},
    "client_id": {{ object.client_id | json }},
    "client_secret": {{ object.client_secret | json }},
    "redirect_uri": {{ location | json }}
  }
{% endparse_json %}
{% return object %}
  