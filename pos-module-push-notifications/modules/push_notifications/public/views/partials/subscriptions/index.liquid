---
metadata:
  name: Push Subscriptions List
  params:
    subscriptions: []
---
{% if subscriptions == blank %}
  <p class="pos-supplementary">No active push subscriptions.</p>
{% else %}
  <section class="pos-table" id="pos-push-subscriptions-table">
    <header>
      <div>Browser</div>
      <div>Created</div>
      <div></div>
      <div></div>
    </header>
    <div class="pos-table-content">
      {% for sub in subscriptions %}
      <ul data-pos-push-subscription-id="{{ sub.id }}">
        <li>
          <span class="pos-table-content-heading">Browser</span>
          {{ sub.browser | capitalize }}
        </li>
        <li>
          <span class="pos-table-content-heading">Created</span>
          {{ sub.created_at | date: '%Y-%m-%d' }}
        </li>
        <li class="pos-push-subscription-device"></li>
        <li>
          <form method="post" action="/push_notifications/subscriptions/destroy">
            <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
            <input type="hidden" name="id" value="{{ sub.id }}">
            <input type="hidden" name="return_to" value="{{ context.location.pathname }}">
            <button type="submit" class="pos-button pos-button-small">Delete</button>
          </form>
        </li>
      </ul>
      {% endfor %}
    </div>
  </section>
  <script>
    (function() {
      var container = document.getElementById('pos-push-subscriptions-table');
      if (!container) return;

      (async function() {
        var registration = null;
        try {
          registration = await navigator.serviceWorker.getRegistration();
          if (registration) registration = await navigator.serviceWorker.ready;
        } catch (e) {}

        var localEndpoint = null;
        if (registration) {
          try {
            var localSub = await registration.pushManager.getSubscription();
            localEndpoint = localSub ? localSub.endpoint : null;
          } catch (e) {}
        }
        if (!localEndpoint) return;

        var serverSubscriptions = [];
        try {
          var resp = await fetch('/push_notifications/subscriptions');
          serverSubscriptions = resp.ok ? await resp.json() : [];
        } catch (e) {}

        var match = serverSubscriptions.find(function(s) { return s.endpoint === localEndpoint; });
        if (!match) return;

        var row = container.querySelector('[data-pos-push-subscription-id="' + match.id + '"]');
        var cell = row && row.querySelector('.pos-push-subscription-device');
        if (cell) {
          cell.innerHTML = '<span class="pos-tag pos-tag-confirmation">This browser</span>';
        }
      })();
    })();
  </script>
{% endif %}
