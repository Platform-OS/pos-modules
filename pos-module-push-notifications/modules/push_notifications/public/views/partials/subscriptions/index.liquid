---
metadata:
  name: Push Subscriptions List
  params:
    subscriptions: []
---
{% if subscriptions == blank %}
  <p class="pos-supplementary">No active push subscriptions.</p>
{% else %}
  <section class="pos-table pos-push-subscriptions" id="pos-push-subscriptions-table">
    <header>
      <div>Browser</div>
      <div>Created</div>
      <div></div>
      <div></div>
    </header>
    <div class="pos-table-content">
      {% for sub in subscriptions %}
      <ul data-pos-push-subscription-id="{{ sub.id }}">
        <li>
          <span class="pos-table-content-heading">Browser</span>
          {{ sub.browser | capitalize }}
        </li>
        <li>
          <span class="pos-table-content-heading">Created</span>
          {{ sub.created_at | date: '%Y-%m-%d' }}
        </li>
        <li class="pos-push-subscription-device"></li>
        <li>
          <form method="post" action="/push_notifications/subscriptions/destroy">
            <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
            <input type="hidden" name="id" value="{{ sub.id }}">
            <input type="hidden" name="return_to" value="{{ context.location.pathname }}">
            <button type="submit" class="pos-button pos-button-small pos-button-danger">Delete</button>
          </form>
        </li>
      </ul>
      {% endfor %}
    </div>
  </section>
{% endif %}
