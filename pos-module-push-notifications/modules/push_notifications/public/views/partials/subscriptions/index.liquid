{% doc %}
  Renders a table listing all the subscriptions for current user

  @param {object} subscriptions - list of subscriptions
{% enddoc %}



{% if subscriptions == blank %}
  <p class="pos-supplementary">No active push subscriptions.</p>
{% else %}
  <section class="pos-table pos-push-list">
    <header>
      <div>{{ 'modules/push_notifications/list.heading.browser' | t }}</div>
      <div>{{ 'modules/push_notifications/list.heading.created_at' | t }}</div>
      <div></div>
      <div></div>
    </header>
    <div class="pos-table-content">
      {% for sub in subscriptions %}
      <ul data-pos-push-subscription-id="{{ sub.id }}">
        <li>
          <span class="pos-table-content-heading">{{ 'modules/push_notifications/list.heading.browser' | t }}</span>
          {{ sub.browser | capitalize }}
        </li>
        <li>
          <span class="pos-table-content-heading">{{ 'modules/push_notifications/list.heading.created_at' | t }}</span>
          {{ sub.created_at | date: '%Y-%m-%d' }}
        </li>
        <li>
          <span class="pos-tag pos-tag-confirmation pos-push-list-current-mark">This browser</span>
        </li>
        <li>
          <form method="post" action="/push_notifications/subscriptions/destroy">
            <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
            <input type="hidden" name="id" value="{{ sub.id }}">
            <input type="hidden" name="return_to" value="{{ context.location.pathname }}">
            <button type="submit" class="pos-button pos-button-small pos-button-danger">Delete</button>
          </form>
        </li>
      </ul>
      {% endfor %}
    </div>
  </section>
{% endif %}
