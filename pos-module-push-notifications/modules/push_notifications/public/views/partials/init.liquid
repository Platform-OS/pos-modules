{% doc %}
  Initializes push notifications module by registering corresponding JavaScript and CSS

  Render it in the <head>: it sets up `pos.modules.push.ready` right away, so scripts that run
  before pos-push.js is loaded can wait for the module with `await pos.modules.push.ready`.

  @param {string} [subscribe_url] - endpoint URL for creating a subscription
  @param {string} [destroy_url] - endpoint URL for removing a subscription
  @param {string} [rotate_url] - endpoint URL to refresh the subscription
  @param {string} [service_worker_path] - path to the service worker that handles push notifications
  @param {string} [vapid_public_key] - public VAPID key used to sign push notification data; defaults to the modules/push_notifications/VAPID_PUBLIC_KEY constant
{% enddoc %}


{% liquid
  assign subscribe_url = subscribe_url | default: '/push_notifications/subscriptions'
  assign destroy_url = destroy_url | default: '/push_notifications/subscriptions/destroy'
  assign rotate_url = rotate_url | default: '/push_notifications/subscriptions/rotate'
  assign service_worker_path = service_worker_path | default: '/sw.js'
  assign vapid_public_key = vapid_public_key | default: context.constants['modules/push_notifications/VAPID_PUBLIC_KEY']
%}

<link rel="stylesheet" href="{{ 'modules/push_notifications/style/pos-push.css' | asset_url }}">

<script>
  /* namespace - set up right away, not on DOMContentLoaded: deferred scripts run before it, so they
     can't count on pos-push.js being loaded and wait for it instead - `await pos.modules.push.ready`
     resolves with the 'pos-push' instance once it initialized (push is unavailable in the browser
     when its settings.error is set), or with null when the page has no push ui or pos-push.js
     couldn't be loaded */
  window.pos = window.pos || {};
  window.pos.modules = window.pos.modules || {};
  window.pos.modules.active = window.pos.modules.active || {};
  window.pos.modules.push = window.pos.modules.push || {};

  if(!window.pos.modules.push.ready){
    let resolveReady;
    window.pos.modules.push.ready = new Promise(resolve => { resolveReady = resolve; });

    /* selectively load modules */
    document.addEventListener('DOMContentLoaded', () => {
      const toggles = document.querySelectorAll('.pos-push-toggle');
      const lists = document.querySelectorAll('.pos-push-list');

      if(!toggles.length && !lists.length && !document.querySelector('.pos-push-subscriptions')){
        resolveReady(null);

        return;
      }

      import('{{ 'modules/push_notifications/js/pos-push.js' | asset_url }}').then(() => {
        /* created first, the toggles and lists read its state */
        const push = window.pos.modules.active['pos-push'] = new window.pos.modules.push({
          id: `pos-push`,
          subscribeUrl: '{{ subscribe_url }}',
          destroyUrl: '{{ destroy_url }}',
          serviceWorkerPath: '{{ service_worker_path }}',
          rotateUrl: '{{ rotate_url }}',
          vapidPublicKey: '{{ vapid_public_key }}'
        });

        /* subscribe/unsubscribe toggle button */
        toggles.forEach((element, index) => {
          window.pos.modules.active[element.id || `pos-push-toggle-${index}`] = new window.pos.modules.push.toggle({
            container: element,
            id: element.id || `pos-push-toggle-${index}`
          });
        });

        /* subscriptions list, highlights the current browser's row */
        lists.forEach((element, index) => {
          window.pos.modules.active[element.id || `pos-push-list-${index}`] = new window.pos.modules.push.list({
            container: element,
            id: element.id || `pos-push-list-${index}`,
            subscribeUrl: '{{ subscribe_url }}'
          });
        });

        push.ready.then(resolveReady);
      }).catch(error => {
        console.error('Push notifications could not be loaded', error);
        resolveReady(null);
      });
    });
  }
</script>
