---
metadata:
  name: Push Notifications Init
  params:
    subscribe_url: "/push_notifications/subscriptions"
    destroy_url: "/push_notifications/subscriptions/destroy"
    service_worker_path: "" # defaults to /sw.js (root scope; platformOS serves assets/sw-X.js at the domain root)
    rotate_url: "" # defaults to /push_notifications/subscriptions/rotate
---
{% liquid
  assign subscribe_url = subscribe_url | default: '/push_notifications/subscriptions'
  assign destroy_url = destroy_url | default: '/push_notifications/subscriptions/destroy'
  assign rotate_url = rotate_url | default: '/push_notifications/subscriptions/rotate'
  assign service_worker_path = service_worker_path | default: '/sw.js'
  assign vapid_public_key = context.constants['modules/push_notifications/VAPID_PUBLIC_KEY']
%}

<link rel="stylesheet" href="{{ 'modules/push_notifications/style/pos-push.css' | asset_url }}">

<script>
  /* selectively load modules */
  document.addEventListener('DOMContentLoaded', () => {

    /* subscribe/unsubscribe toggle button */
    if(document.querySelector('.pos-push')){
      import('{{ 'modules/push_notifications/js/pos-push.js' | asset_url }}').then(module => {
        document.querySelectorAll('.pos-push').forEach((element, index) => {
          window.pos.modules.active[element.id || `pos-push-${index}`] = new window.pos.modules.push({
            container: element,
            id: element.id || `pos-push-${index}`,
            subscribeUrl: '{{ subscribe_url }}',
            destroyUrl: '{{ destroy_url }}',
            serviceWorkerPath: '{{ service_worker_path }}',
            rotateUrl: '{{ rotate_url }}',
            vapidPublicKey: '{{ vapid_public_key }}'
          });
        });
      });
    }

    /* subscriptions list, highlights the current browser's row */
    if(document.querySelector('.pos-push-subscriptions')){
      import('{{ 'modules/push_notifications/js/pos-push.js' | asset_url }}').then(module => {
        document.querySelectorAll('.pos-push-subscriptions').forEach((element, index) => {
          window.pos.modules.active[element.id || `pos-push-subscriptions-${index}`] = new window.pos.modules.pushSubscriptionsList({
            container: element,
            id: element.id || `pos-push-subscriptions-${index}`,
            subscribeUrl: '{{ subscribe_url }}'
          });
        });
      });
    }

  });
</script>
