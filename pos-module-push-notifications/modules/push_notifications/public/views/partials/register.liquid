{% doc %}
  Renders a subscribe/unsubscribe button for push notifications.
  Requires modules/push_notifications/init to be rendered in the page <head>.
{% enddoc %}

<div class="pos-push" id="pos-push-register">
  <button
    type="button"
    class="pos-push-subscribe-btn pos-button pos-button-primary"
    disabled
  >
    Subscribe to Notifications
  </button>
</div>
