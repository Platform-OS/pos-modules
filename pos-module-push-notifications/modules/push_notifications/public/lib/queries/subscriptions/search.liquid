{% doc %}
  Searches push subscriptions with optional filters.
  @param {string} [user_id]   - Filter by a single user ID
  @param {string[]} [user_ids] - Filter by a list of user IDs (OR'd with user_id)
  @param {boolean} active  - Filter by active status
  @param {number} [limit]  - Results per page (default: 20)
  @param {number} [page]   - Page number (default: 1)
  @returns {object} Paginated results: {total_entries, total_pages, results}
{% enddoc %}
{% liquid
  assign limit = limit | default: 20
  assign page = page | default: 1

  graphql r = 'modules/push_notifications/subscriptions/search', user_id: user_id, user_ids: user_ids, active: active, limit: limit, page: page

  return r.records
%}
