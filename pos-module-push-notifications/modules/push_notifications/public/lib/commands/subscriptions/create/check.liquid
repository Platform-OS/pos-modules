{% doc %}
  @param {object} object - Built subscription object
{% enddoc %}
{% liquid
  assign c = { "errors": {}, "valid": true }

  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'user_id'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'endpoint'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'p256dh'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'auth'

  unless object.endpoint == blank
    assign endpoint_is_https = object.endpoint | start_with: 'https://'
    function endpoint_allowed = 'modules/push_notifications/helpers/endpoint_allowed', endpoint: object.endpoint
    if endpoint_is_https != true
      assign c.valid = false
      assign c.errors = c.errors | hash_merge: {"endpoint": ["must start with https://"]}
    elsif endpoint_allowed != true
      assign c.valid = false
      assign c.errors = c.errors | hash_merge: {"endpoint": ["is not a supported push service"]}
    endif
  endunless

  assign object.valid = c.valid
  assign object.errors = c.errors

  return object
%}
