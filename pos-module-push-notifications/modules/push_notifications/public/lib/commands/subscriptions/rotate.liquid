{% doc %}
  Rotates a push subscription in place when the browser/push service
  invalidates it (pushsubscriptionchange) and a new endpoint/keys are issued.

  Authenticates by requiring the full previous credentials (old_endpoint +
  old_p256dh + old_auth) to match a stored record, rather than the current
  session/CSRF token: this command is meant to be called from the service
  worker in the background, which may run with no page open to source a
  fresh authenticity_token from. Possession of the old subscription's own
  secret (auth) is what proves the caller is entitled to rotate it.

  @param {string} old_endpoint - Previous push endpoint identifying the record
  @param {string} old_p256dh   - Previous client public key (must match stored value)
  @param {string} old_auth     - Previous client auth secret (must match stored value)
  @param {string} endpoint     - New push service endpoint URL
  @param {string} p256dh       - New client EC public key (base64url)
  @param {string} auth         - New client auth secret (base64url)
  @returns {object} Updated record (with .valid true), or {"valid": false, "errors": {...}}
{% enddoc %}
{% liquid
  assign not_found = { "valid": false, "errors": { "old_endpoint": ["Subscription not found"] } }

  if old_endpoint == blank or old_p256dh == blank or old_auth == blank
    return not_found
  endif

  function sub = 'modules/push_notifications/queries/subscriptions/find', endpoint: old_endpoint

  if sub == blank or sub.p256dh != old_p256dh or sub.auth != old_auth
    return not_found
  endif

  graphql r = 'modules/push_notifications/subscriptions/update', id: sub.id, endpoint: endpoint, p256dh: p256dh, auth: auth, active: true
  assign object = r.record
  assign object.valid = true

  assign event_payload = { "subscription_id": object.id, "user_id": object.user_id, "endpoint": object.endpoint, "browser": object.browser }
  function _ = 'modules/core/commands/events/publish', type: 'push_subscription_rotated', object: event_payload, delay: null, max_attempts: null

  return object
%}
