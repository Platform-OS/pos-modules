{% doc %}
  @param {object} object - Built notification send object
{% enddoc %}
{% liquid
  assign c = { "errors": {}, "valid": true }

  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'subscription_id'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'payload'

  assign allowed_urgency = 'very-low,low,normal,high' | split: ','
  unless allowed_urgency contains object.urgency
    assign object.urgency = 'normal'
  endunless

  assign object.valid = c.valid
  assign object.errors = c.errors

  return object
%}
