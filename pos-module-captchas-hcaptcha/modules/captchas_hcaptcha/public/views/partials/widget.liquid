{% doc %}
  @description Renders the hCaptcha widget (loader script + widget div) into a form.
    Part of the captchas provider contract: dispatched via include by modules/captchas/widget.
  @param {string} site_key - hCaptcha public site key.
  @param {object} [options] - Widget options: theme (light|dark), size (normal|compact), tabindex,
    callback (JS fn name), expired_callback, chalexpired_callback, error_callback, open_callback,
    close_callback, language (hl script param, applied on first load), class_name (extra CSS classes),
    html_id (id attribute).
{% enddoc %}
{%- unless context.exports.captcha.hcaptcha_script_loaded -%}
<script src="https://js.hcaptcha.com/1/api.js{% if options['language'] != blank %}?hl={{ options['language'] | url_encode }}{% endif %}" async defer></script>
{%- assign hcaptcha_script_loaded = true -%}
{%- export hcaptcha_script_loaded, namespace: 'captcha' -%}
{%- endunless -%}
<div class="h-captcha{% if options['class_name'] != blank %} {{ options['class_name'] | escape }}{% endif %}"{% if options['html_id'] != blank %} id="{{ options['html_id'] | escape }}"{% endif %} data-sitekey="{{ site_key | escape }}"{% if options['theme'] != blank %} data-theme="{{ options['theme'] | escape }}"{% endif %}{% if options['size'] != blank %} data-size="{{ options['size'] | escape }}"{% endif %}{% if options['tabindex'] != blank %} data-tabindex="{{ options['tabindex'] | escape }}"{% endif %}{% if options['callback'] != blank %} data-callback="{{ options['callback'] | escape }}"{% endif %}{% if options['expired_callback'] != blank %} data-expired-callback="{{ options['expired_callback'] | escape }}"{% endif %}{% if options['chalexpired_callback'] != blank %} data-chalexpired-callback="{{ options['chalexpired_callback'] | escape }}"{% endif %}{% if options['error_callback'] != blank %} data-error-callback="{{ options['error_callback'] | escape }}"{% endif %}{% if options['open_callback'] != blank %} data-open-callback="{{ options['open_callback'] | escape }}"{% endif %}{% if options['close_callback'] != blank %} data-close-callback="{{ options['close_callback'] | escape }}"{% endif %}></div>
