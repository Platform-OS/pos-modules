{% doc %}
  @param {object} object - The object to process
{% enddoc %}
{% liquid
  assign c = { "errors": {}, "valid": true }

  function c = 'modules/core/validations/email', c: c, object: object, field_name: 'email'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'email'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'password'

  if c.valid
    function login_attempt = 'modules/user/queries/login_attempts/find_by_email', email: object.email
    function locked = 'modules/user/helpers/login_locked', login_attempt: login_attempt

    if locked
      comment
        Same error as a wrong password, and the password is not verified at all,
        so a locked account cannot be signed into even with the right one and
        the response does not reveal that the address is registered.
      endcomment
      function c = 'modules/core/helpers/register_error', contract: c, field_name: 'password', key: 'modules/user/validation.invalid_email_or_password', message: null
      assign object.locked = true
    else
      graphql user = 'modules/user/user/verify_password', args: object
      assign user = user.users.results.first

      function c = 'modules/core/validations/truthy', c: c, field_name: 'password', object: user.authenticate, key: 'modules/user/validation.invalid_email_or_password'
      assign object.id = user.id
    endif

    assign object.login_attempt = login_attempt
  endif

  assign object.valid = c.valid
  assign object.errors = c.errors

  return object
 %}
