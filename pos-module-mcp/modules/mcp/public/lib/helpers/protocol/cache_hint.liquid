{%- comment -%}
  Client-side cache hint for a cacheable result (2026-07-28 `CacheableResult`). Returns
  { ttlMs, cacheScope } from config; the caller attaches it ONLY to a modern result, so
  legacy (2025-06-18) responses are unchanged.

  cacheScope (spec values, analogous to HTTP Cache-Control):
    'public'  — no user-specific data; any client or shared cache may reuse it across
                authorization contexts (open tools/list, prompts/list, resources,
                server/discover).
    'private' — reusable only within the same authorization context (principal-scoped
                tools/list).

  @param {string} kind  - 'tools' | 'prompts' | 'resources' | 'discover'
  @param {string} scope - 'public' | 'private'
  @return {object} { ttlMs, cacheScope }
{%- endcomment -%}
{% liquid
  function cfg = 'modules/mcp/helpers/config'
  assign kind = kind | default: 'tools'
  assign scope = scope | default: 'public'
  # platformos-check-disable UnknownProperty
  assign ttl = cfg.cache.tools_ttl_ms
  if kind == 'prompts'
    assign ttl = cfg.cache.prompts_ttl_ms
  elsif kind == 'resources'
    assign ttl = cfg.cache.resources_ttl_ms
  elsif kind == 'discover'
    assign ttl = cfg.cache.discover_ttl_ms
  endif
  # platformos-check-enable UnknownProperty
  assign ttl_ms = ttl | plus: 0
  assign out = {
    "ttlMs": ttl_ms,
    "cacheScope": scope
  }
  return out
%}
