{%- comment -%}
  Standard request headers of a MODERN request (2026-07-28 transports/streamable-http,
  "Standard Request Headers" and "Server Validation"). Gateways route on these headers,
  so a header that disagrees with the body is a desync the server must refuse rather
  than resolve:

  - `Mcp-Method` is required on every request and must equal the body `method`.
  - `Mcp-Name` is required on tools/call and prompts/get (body `params.name`), on
    resources/read (body `params.uri`) and, by the Tasks extension, on tasks/get,
    tasks/update and tasks/cancel (body `params.taskId`), and must equal that value.

  A value written as `=?base64?<data>?=` is decoded before the comparison. The data must
  be strict, padded Base64 (RFC 4648); anything else is a malformed header and is refused
  rather than decoded into garbage.
  The decoded bytes are read as UTF-8, the encoding of the JSON body they are compared to.

  Every failure is 400 Bad Request with JSON-RPC code -32020 (HeaderMismatch). Legacy
  requests do not reach this check.

  @param {object} params  - context.params (the whole parsed JSON-RPC request)
  @param {object} headers - context.headers
  @return {object} null when the headers are valid, else { http_status, code, message }
{%- endcomment -%}
{% liquid
  assign problem = ''
  assign method = params.method | default: ''
  assign header_method = headers.HTTP_MCP_METHOD | default: ''

  if header_method == blank
    assign problem = 'the Mcp-Method header is required'
  elsif header_method != method
    assign problem = 'Mcp-Method header does not match the request method'
  else
    assign name_source = ''
    if method == 'tools/call' or method == 'prompts/get'
      assign name_source = 'name'
    elsif method == 'resources/read'
      assign name_source = 'uri'
    elsif method == 'tasks/get' or method == 'tasks/update' or method == 'tasks/cancel'
      assign name_source = 'taskId'
    endif

    if name_source != blank
      assign body_name = ''
      unless params.params == blank
        assign body_name = params.params[name_source] | default: ''
      endunless
      assign header_name = headers.HTTP_MCP_NAME | default: ''

      if header_name == blank
        assign problem = 'the Mcp-Name header is required for ' | append: method
      else
        assign sentinel_open = header_name | slice: 0, 9
        assign sentinel_close = header_name | slice: -2, 2
        if sentinel_open == '=?base64?' and sentinel_close == '?=' and header_name.size >= 11
          assign encoded_size = header_name.size | minus: 11
          assign encoded = header_name | slice: 9, encoded_size
          assign encoded_ok = encoded | matches: '\A(?:[A-Za-z0-9+\/]{4})*(?:[A-Za-z0-9+\/]{2}==|[A-Za-z0-9+\/]{3}=)?\z'
          if encoded_ok
            if encoded == blank
              assign header_name = ''
            else
              assign header_name = encoded | base64_decode | force_encoding: 'UTF-8'
            endif
          else
            assign problem = 'the Mcp-Name header is not valid Base64'
          endif
        endif
        if problem == blank and header_name != body_name
          assign problem = 'Mcp-Name header does not match the request target'
        endif
      endif
    endif
  endif

  if problem == blank
    return null
  endif

  assign out = {
    "http_status": 400,
    "code": -32020
  }
  assign out['message'] = 'Header mismatch: ' | append: problem
  return out
%}
