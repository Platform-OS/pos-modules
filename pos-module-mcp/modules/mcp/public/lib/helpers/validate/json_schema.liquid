{%- comment -%}
  Validate a VALUE against a JSON-Schema node (spec §10). Distinct from
  registry/validate_schema_node (which validates the SCHEMA itself): this validates a
  value against an already-valid schema. Two modes:

  INPUT (default) — a tool call's ARGUMENTS against input_schema, the input-surface
  control. STRICT, no coercion (§10.2): a string "42" for an integer field is
  REJECTED, not coerced — agents emit well-formed JSON, and lenient coercion hides
  model errors and widens the input surface. Unknown keys are rejected unless that
  object declares additionalProperties: true (§7.2), which is how a genuinely
  free-form argument map is declared; closed is the default.

  OUTPUT (`output: true`) — a handler's result against output_schema, before it is
  served as structuredContent (MCP: a server MUST return structured results that
  conform to its declared outputSchema). Same strict type and constraint checks, with
  the output-mode schema subset (registry/validate_schema_node):
   - `type` may be a list (`["string","null"]`); a value matches if it matches any
     listed type, and null is valid only where "null" is listed (and, if the node has
     an enum, only where the enum lists null too);
   - additionalProperties is honoured as declared: `false` rejects undeclared keys,
     absent or `true` allows them (standard JSON Schema; forcing false would refuse
     results that conform to the published schema);
   - a `format` other than uuid/email/date/date-time is an annotation for clients and
     is not checked (JSON Schema treats format as an annotation by default).

  Both modes: `pattern` is evaluated with ECMA-262 anchoring (validate/ecma_pattern), so
  ^ and $ anchor the whole string as they do for clients, not each line. The formats
  are anchored the same way, and date-time is a full RFC 3339 date-time (real calendar
  day, time fields in range, time zone required).

  Depth is capped in both modes.

  Type rules (JSON-parsed values):
   - integer : Integer, or a Float with zero fractional part (JSON-Schema semantics)
   - number  : Integer or Float
   - string/boolean/array/object : exact type match
   - a null value for a typed field is a type error (null ≠ absent, strict) unless an
     output schema lists "null" among its types

  @param {*}       value     - the value to check
  @param {object}  schema    - the JSON-Schema node
  @param {integer} depth     - current depth (start 1)
  @param {integer} max_depth - cap (config.defaults.max_schema_depth, or
                               max_output_schema_depth in output mode)
  @param {string}  path      - dotted location for messages (start 'arguments')
  @param {boolean} output    - true to validate a result against an output_schema
                               (default false)
  @return {object} { valid:boolean, errors:[string] }
{%- endcomment -%}
{% liquid
  assign errors = []
  assign at = path | default: 'arguments'
  assign output = output | default: false
  assign t = schema.type
  assign vt = value | type_of

  # The declared types as a list. Input schemas always declare one type; an output
  # schema may declare several (registry/validate_schema_node enforces both).
  assign types = []
  assign t_kind = t | type_of | downcase
  if t_kind == 'array'
    assign types = t
    assign t_label = t | join: ' or '
  else
    assign types = types | array_add: t
    assign t_label = t
  endif

  if depth > max_depth
    assign msg = at | append: ': exceeds max nesting depth'
    assign errors = errors | array_add: msg
    assign out = {
      "valid": false,
      "errors": errors
    }
    return out
  endif

  # ---- null: valid only where an output schema lists "null" (and, when the node also
  #      declares an enum, only where that enum lists null: both keywords apply) ----
  if vt == 'null' or vt == 'NilClass'
    if output and types contains 'null'
      unless schema.enum == blank
        assign null_in_enum = false
        for opt in schema.enum
          if opt == null
            assign null_in_enum = true
            break
          endif
        endfor
        unless null_in_enum
          assign allowed = schema.enum | join: ', '
          assign msg = at | append: ': must be one of [' | append: allowed | append: '], got null'
          assign errors = errors | array_add: msg
        endunless
      endunless
      assign is_valid = false
      if errors.size == 0
        assign is_valid = true
      endif
      assign out = {
        "valid": is_valid,
        "errors": errors
      }
      return out
    endif
    assign msg = at | append: ': must be ' | append: t_label | append: ', got null'
    assign errors = errors | array_add: msg
    assign out = {
      "valid": false,
      "errors": errors
    }
    return out
  endif

  # ---- strict type check ----
  # `kind` is the declared type the value matched; it picks the constraints below.
  assign kind = ''
  # Accept plain Hash and ActiveSupport::HashWithIndifferentAccess (request params
  # arrive as the latter); both contain 'Hash'.
  if vt contains 'Hash'
    if types contains 'object'
      assign kind = 'object'
    endif
  elsif vt == 'Array'
    if types contains 'array'
      assign kind = 'array'
    endif
  elsif vt == 'String'
    if types contains 'string'
      assign kind = 'string'
    endif
  elsif vt == 'Boolean'
    if types contains 'boolean'
      assign kind = 'boolean'
    endif
  elsif vt == 'Integer'
    if types contains 'integer'
      assign kind = 'integer'
    elsif types contains 'number'
      assign kind = 'number'
    endif
  elsif vt == 'Float'
    if types contains 'number'
      assign kind = 'number'
    elsif types contains 'integer'
      assign floored = value | floor
      if value == floored
        assign kind = 'integer'
      endif
    endif
  endif

  if kind == blank
    assign msg = at | append: ': expected ' | append: t_label | append: ', got ' | append: vt
    assign errors = errors | array_add: msg
    assign out = {
      "valid": false,
      "errors": errors
    }
    return out
  endif

  # ---- enum (any scalar) ----
  unless schema.enum == blank
    assign in_enum = false
    for opt in schema.enum
      if opt == value
        assign in_enum = true
        break
      endif
    endfor
    unless in_enum
      assign allowed = schema.enum | join: ', '
      assign msg = at | append: ': must be one of [' | append: allowed | append: ']'
      assign errors = errors | array_add: msg
    endunless
  endunless

  # ---- per-type constraints ----
  case kind
    when 'string'
      assign len = value | size
      unless schema.minLength == blank
        if len < schema.minLength
          assign msg = at | append: ': shorter than minLength'
          assign errors = errors | array_add: msg
        endif
      endunless
      unless schema.maxLength == blank
        if len > schema.maxLength
          assign msg = at | append: ': longer than maxLength'
          assign errors = errors | array_add: msg
        endif
      endunless
      unless schema.pattern == blank
        # ECMA-262 semantics (what clients apply): ^ and $ anchor the whole string.
        # registry/validate_schema_node rejects a pattern that does not compile; a
        # failure here anyway fails closed.
        function ruby_pattern = 'modules/mcp/helpers/validate/ecma_pattern', pattern: schema.pattern
        assign pat_ok = false
        try
          assign pat_ok = value | matches: ruby_pattern
        catch pattern_error
          assign pat_ok = false
        endtry
        unless pat_ok
          assign msg = at | append: ': does not match required pattern'
          assign errors = errors | array_add: msg
        endunless
      endunless
      unless schema.format == blank
        # \A and \z anchor the whole value (Ruby's ^ and $ would accept a valid first
        # line followed by anything).
        assign fmt_re = ''
        if schema.format == 'uuid'
          assign fmt_re = '\A[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\z'
        elsif schema.format == 'email'
          assign fmt_re = '\A[^@\s]+@[^@\s]+\.[^@\s]+\z'
        elsif schema.format == 'date-time'
          # RFC 3339 date-time: the time zone (Z or ±hh:mm) is required, hours 00-23,
          # minutes 00-59, seconds 00-60 (leap second), optional fraction.
          assign fmt_re = '\A[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])\z'
        elsif schema.format == 'date'
          assign fmt_re = '\A[0-9]{4}-[0-9]{2}-[0-9]{2}\z'
        endif
        unless fmt_re == blank
          assign fmt_ok = value | matches: fmt_re
          # A full-date (RFC 3339), alone or as the start of a date-time, must also be a
          # real calendar day: month 1-12 and a day within that month, with the
          # Gregorian leap-year rule. Checked by arithmetic, because to_time silently
          # rolls 2026-02-31 over to 2026-03-03.
          assign check_calendar = false
          if fmt_ok
            if schema.format == 'date' or schema.format == 'date-time'
              assign check_calendar = true
            endif
          endif
          if check_calendar
            assign full_date = value | slice: 0, 10
            assign date_parts = full_date | split: '-'
            assign year = date_parts[0] | plus: 0
            assign month = date_parts[1] | plus: 0
            assign day = date_parts[2] | plus: 0
            assign month_days = '31,28,31,30,31,30,31,31,30,31,30,31' | split: ','
            if month < 1 or month > 12
              assign fmt_ok = false
            else
              assign month_index = month | minus: 1
              assign last_day = month_days[month_index] | plus: 0
              if month == 2
                assign by_4 = year | modulo: 4
                assign by_100 = year | modulo: 100
                assign by_400 = year | modulo: 400
                if by_400 == 0
                  assign last_day = 29
                elsif by_4 == 0 and by_100 != 0
                  assign last_day = 29
                endif
              endif
              if day < 1 or day > last_day
                assign fmt_ok = false
              endif
            endif
          endif
          unless fmt_ok
            assign msg = at | append: ': invalid ' | append: schema.format | append: ' format'
            assign errors = errors | array_add: msg
          endunless
        endunless
      endunless

    when 'integer', 'number'
      unless schema.minimum == blank
        if value < schema.minimum
          assign msg = at | append: ': below minimum'
          assign errors = errors | array_add: msg
        endif
      endunless
      unless schema.maximum == blank
        if value > schema.maximum
          assign msg = at | append: ': above maximum'
          assign errors = errors | array_add: msg
        endif
      endunless
      unless schema.exclusiveMinimum == blank
        unless value > schema.exclusiveMinimum
          assign msg = at | append: ': not above exclusiveMinimum'
          assign errors = errors | array_add: msg
        endunless
      endunless
      unless schema.exclusiveMaximum == blank
        unless value < schema.exclusiveMaximum
          assign msg = at | append: ': not below exclusiveMaximum'
          assign errors = errors | array_add: msg
        endunless
      endunless

    when 'array'
      assign n = value | size
      unless schema.minItems == blank
        if n < schema.minItems
          assign msg = at | append: ': fewer than minItems'
          assign errors = errors | array_add: msg
        endif
      endunless
      unless schema.maxItems == blank
        if n > schema.maxItems
          assign msg = at | append: ': more than maxItems'
          assign errors = errors | array_add: msg
        endif
      endunless
      unless schema.items == blank
        assign i = 0
        for el in value
          assign el_path = at | append: '[' | append: i | append: ']'
          assign nd = depth | plus: 1
          function er = 'modules/mcp/helpers/validate/json_schema', value: el, schema: schema.items, depth: nd, max_depth: max_depth, path: el_path, output: output
          unless er.valid
            for e in er.errors
              assign errors = errors | array_add: e
            endfor
          endunless
          assign i = i | plus: 1
        endfor
      endunless

    when 'object'
      assign vkeys = value | hash_keys
      assign props = schema.properties
      # required present
      unless schema.required == blank
        for req in schema.required
          unless vkeys contains req
            assign msg = at | append: ': missing required property "' | append: req | append: '"'
            assign errors = errors | array_add: msg
          endunless
        endfor
      endunless
      # Unknown keys. An input schema is CLOSED BY DEFAULT (§7.2): an implementer must not be able
      # to accept an argument it cannot validate merely by forgetting to say so. It opens only
      # where the schema declares additionalProperties: true, which is a statement that this
      # object IS a free-form map — a record's field values, one batch operation's arguments.
      # Absent or false stays closed, so no schema written before this changes meaning. An output
      # schema rejects unknown keys only where it declares additionalProperties: false.
      assign pkeys = []
      unless props == blank
        assign pkeys = props | hash_keys
      endunless
      assign closed = true
      if schema.additionalProperties == true
        assign closed = false
      elsif output and schema.additionalProperties != false
        assign closed = false
      endif
      if closed
        for k in vkeys
          unless pkeys contains k
            assign msg = at | append: ': unknown property "' | append: k | append: '"'
            assign errors = errors | array_add: msg
          endunless
        endfor
      endif
      # recurse into declared properties that are present
      unless props == blank
        for pk in pkeys
          if vkeys contains pk
            assign child = value[pk]
            assign child_schema = props[pk]
            assign child_path = at | append: '.' | append: pk
            assign nd = depth | plus: 1
            function cr = 'modules/mcp/helpers/validate/json_schema', value: child, schema: child_schema, depth: nd, max_depth: max_depth, path: child_path, output: output
            unless cr.valid
              for e in cr.errors
                assign errors = errors | array_add: e
              endfor
            endunless
          endif
        endfor
      endunless
  endcase

  assign is_valid = false
  if errors.size == 0
    assign is_valid = true
  endif
  assign out = {
    "valid": is_valid,
    "errors": errors
  }
  return out
%}
