{%- comment -%}
  PKCE S256 check (RFC 7636 §4.6): BASE64URL(SHA256(code_verifier)) == code_challenge.
  `digest: 'sha256', 'base64'` yields standard padded base64 of the raw digest; map it
  to base64url without padding. The verifier must be 43–128 unreserved characters.

  @param {string} verifier
  @param {string} challenge
  @return {boolean}
{%- endcomment -%}
{% liquid
  assign v = verifier | default: '' | append: ''
  assign well_formed = v | matches: '\A[A-Za-z0-9\-._~]{43,128}\z'
  unless well_formed
    return false
  endunless
  assign computed = v | digest: 'sha256', 'base64' | replace: '+', '-' | replace: '/', '_' | remove: '='
  if computed == challenge
    return true
  endif
  return false
%}
