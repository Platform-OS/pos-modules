{%- comment -%}
  Validate ONE JSON-Schema node against the supported subset (spec §10.1). Called
  by registry/manifest_schema for input_schema/output_schema, and recurses into
  `properties.*` and `items`. An unsupported keyword anywhere causes the whole
  manifest to be REJECTED at load — an implementer must never be able to declare a
  constraint the module does not enforce (a silently-ignored keyword is a security
  hole, not a convenience).

  Enforced:
   - `type` present and one of object/string/integer/number/boolean/array. For an
     OUTPUT schema (`output: true`) `type` may also be a list of those types plus
     "null", because a result field can be empty. execute/run validates every
     result against the output schema (validate/json_schema, output mode) before it
     is served, so every keyword allowed here is enforced on results too.
   - Only supported keywords per node (union set below); any other key → error.
   - additionalProperties, when present, must be boolean. An input schema is closed by
     default and opens only where it declares `true` (§7.2) — that declaration is how a
     free-form argument map is stated; in an output schema it is honoured as declared
     (false rejects undeclared result keys).
   - pattern is length-capped and rejects classic catastrophic-backtracking
     nested-quantifier signatures (§16.4). It must compile; it is evaluated with
     ECMA-262 anchoring (validate/ecma_pattern), as clients evaluate it.
   - Every node is a JSON object, and every keyword value has its JSON Schema 2020-12
     type: numbers for minimum/maximum/exclusiveMinimum/exclusiveMaximum, non-negative
     integers for minLength/maxLength/minItems/maxItems, an array of strings for
     required, a non-empty array for enum, an object for properties and items, strings
     for pattern/format/description/title. A wrong type would crash the validator or be
     enforced differently from how a client reads it.
   - depth is capped (max_schema_depth) to bound validation cost (§10.1).
   - `format` in an INPUT schema must be one validate/json_schema enforces (uuid,
     email, date, date-time). Any other value would be silently ignored, so it is rejected;
     enforcing a new format later then only affects tools that opt in. In an output
     schema those four formats are checked on results; any other format is a client
     annotation (JSON Schema treats format as an annotation by default) and is not.

  Not enforced, reported: every `description` and `title` is model-read text, like the
  tool description, so each goes through registry/lint_description (§12.3). A hit is
  returned in `lint` for human attention and never makes the schema invalid.

  @param {object}  node  - a JSON-Schema node (hash)
  @param {integer} depth - current nesting depth (start 1)
  @param {integer} max_depth - cap
  @param {string}  path  - dotted location for error messages (e.g. properties.foo)
  @param {boolean} output - true for an output_schema node (default false)
  @return {object} { valid:boolean, errors:[string], lint:[{path, hits:[string]}] }
{%- endcomment -%}
{% liquid
  assign errors = []
  assign lint = []
  assign at = path | default: '(root)'

  if depth > max_depth
    assign msg = at | append: ': schema nesting exceeds max depth'
    assign errors = errors | array_add: msg
    assign out = {
      "valid": false,
      "errors": errors,
      "lint": lint
    }
    return out
  endif

  # A schema node is a JSON object. Anything else (e.g. the tuple form `items: [...]`,
  # which JSON Schema 2020-12 replaced with prefixItems) is rejected here, before any
  # keyword is read from it.
  assign node_kind = node | type_of
  unless node_kind contains 'Hash'
    assign msg = at | append: ': a schema must be a JSON object, got ' | append: node_kind
    assign errors = errors | array_add: msg
    assign out = {
      "valid": false,
      "errors": errors,
      "lint": lint
    }
    return out
  endunless

  assign text_keys = 'description,title' | split: ','
  for text_key in text_keys
    assign text = node[text_key]
    if text == blank
      continue
    endif
    assign text_kind = text | type_of
    unless text_kind == 'String'
      assign msg = at | append: ': "' | append: text_key | append: '" must be a string'
      assign errors = errors | array_add: msg
      continue
    endunless
    function text_lint = 'modules/mcp/helpers/registry/lint_description', text: text
    if text_lint.flagged
      assign hit_path = at | append: '.' | append: text_key
      assign hit = {
        "path": hit_path,
        "hits": text_lint.hits
      }
      assign lint = lint | array_add: hit
    endif
  endfor

  assign allowed = 'type,description,title,default,properties,required,additionalProperties,enum,minimum,maximum,exclusiveMinimum,exclusiveMaximum,minLength,maxLength,pattern,format,items,minItems,maxItems' | split: ','
  assign keys = node | hash_keys
  for k in keys
    unless allowed contains k
      assign msg = at | append: ': unsupported schema keyword "' | append: k | append: '"'
      assign errors = errors | array_add: msg
    endunless
  endfor

  assign output = output | default: false

  # Keyword VALUES must have the type JSON Schema 2020-12 gives them. A wrong type is an
  # invalid schema: published to clients it may not compile, and here it would either
  # crash the validator (a string compared with a number) or be enforced differently
  # from how a client reads it (draft-4 `exclusiveMinimum: true`).
  assign number_keys = 'minimum,maximum,exclusiveMinimum,exclusiveMaximum' | split: ','
  for nk in number_keys
    if keys contains nk
      assign nv_kind = node[nk] | type_of
      unless nv_kind == 'Integer' or nv_kind == 'Float'
        assign msg = at | append: ': "' | append: nk | append: '" must be a number'
        assign errors = errors | array_add: msg
      endunless
    endif
  endfor
  assign count_keys = 'minLength,maxLength,minItems,maxItems' | split: ','
  for ck in count_keys
    if keys contains ck
      assign cv = node[ck]
      assign cv_kind = cv | type_of
      assign cv_ok = false
      if cv_kind == 'Integer'
        if cv >= 0
          assign cv_ok = true
        endif
      endif
      unless cv_ok
        assign msg = at | append: ': "' | append: ck | append: '" must be a non-negative integer'
        assign errors = errors | array_add: msg
      endunless
    endif
  endfor
  if keys contains 'required'
    assign req_ok = false
    assign req_kind = node.required | type_of
    if req_kind == 'Array'
      assign req_ok = true
      for req in node.required
        assign req_item_kind = req | type_of
        unless req_item_kind == 'String'
          assign req_ok = false
        endunless
      endfor
    endif
    unless req_ok
      assign msg = at | append: ': "required" must be an array of strings'
      assign errors = errors | array_add: msg
    endunless
  endif
  if keys contains 'enum'
    assign enum_kind = node.enum | type_of
    assign enum_ok = false
    if enum_kind == 'Array' and node.enum.size > 0
      assign enum_ok = true
    endif
    unless enum_ok
      assign msg = at | append: ': "enum" must be a non-empty array'
      assign errors = errors | array_add: msg
    endunless
  endif
  if keys contains 'properties'
    assign props_kind = node.properties | type_of
    unless props_kind contains 'Hash'
      assign msg = at | append: ': "properties" must be an object'
      assign errors = errors | array_add: msg
    endunless
  endif
  if keys contains 'format'
    assign format_kind = node.format | type_of
    unless format_kind == 'String'
      assign msg = at | append: ': "format" must be a string'
      assign errors = errors | array_add: msg
    endunless
  endif
  assign pattern_is_string = false
  if keys contains 'pattern'
    assign pattern_kind = node.pattern | type_of
    if pattern_kind == 'String'
      assign pattern_is_string = true
    else
      assign msg = at | append: ': "pattern" must be a string'
      assign errors = errors | array_add: msg
    endif
  endif

  unless output or node.format == blank or format_kind != 'String'
    assign supported_formats = 'uuid,email,date,date-time' | split: ','
    unless supported_formats contains node.format
      assign msg = at | append: ': unsupported format "' | append: node.format | append: '" (supported: uuid, email, date, date-time)'
      assign errors = errors | array_add: msg
    endunless
  endunless

  assign t = node.type
  assign valid_types = 'object,string,integer,number,boolean,array' | split: ','
  assign node_types = []
  if t == blank
    assign msg = at | append: ': missing "type"'
    assign errors = errors | array_add: msg
  else
    assign t_kind = t | type_of | downcase
    if t_kind == 'array'
      if output
        assign output_types = valid_types | array_add: 'null'
        for listed_type in t
          if output_types contains listed_type
            assign node_types = node_types | array_add: listed_type
          else
            assign msg = at | append: ': invalid type "' | append: listed_type | append: '"'
            assign errors = errors | array_add: msg
          endif
        endfor
      else
        assign msg = at | append: ': "type" must be a single type'
        assign errors = errors | array_add: msg
      endif
    elsif valid_types contains t
      assign node_types = node_types | array_add: t
    else
      assign msg = at | append: ': invalid type "' | append: t | append: '"'
      assign errors = errors | array_add: msg
    endif
  endif

  # additionalProperties must be boolean if declared.
  assign ap = node.additionalProperties
  unless ap == blank
    unless ap == true or ap == false
      assign msg = at | append: ': additionalProperties must be boolean'
      assign errors = errors | array_add: msg
    endunless
  endunless

  # pattern safety (§16.4), and the pattern must compile: validate/json_schema runs it
  # (translated to ECMA-262 anchoring by validate/ecma_pattern) on every value.
  assign pat = node.pattern
  if pattern_is_string and pat != blank
    function ruby_pattern = 'modules/mcp/helpers/validate/ecma_pattern', pattern: pat
    assign pattern_compiles = true
    try
      # A non-empty subject: matches skips a blank one without compiling the regex.
      assign _probe = 'x' | matches: ruby_pattern
    catch pattern_error
      assign pattern_compiles = false
    endtry
    unless pattern_compiles
      assign msg = at | append: ': pattern is not a valid regular expression'
      assign errors = errors | array_add: msg
    endunless
    assign plen = pat | size
    if plen > 200
      assign msg = at | append: ': pattern too long'
      assign errors = errors | array_add: msg
    endif
    assign bad_sigs = '+)+,*)*,+)*,*)+,))*,))+' | split: ','
    for s in bad_sigs
      if pat contains s
        assign msg = at | append: ': pattern has catastrophic-backtracking risk'
        assign errors = errors | array_add: msg
        break
      endif
    endfor
  endif

  # Recurse: object properties.
  if node_types contains 'object'
    assign props = node.properties
    assign props_is_hash = false
    assign props_type = props | type_of
    if props_type contains 'Hash'
      assign props_is_hash = true
    endif
    if props != blank and props_is_hash
      assign pkeys = props | hash_keys
      for pk in pkeys
        assign child = props[pk]
        assign child_path = at | append: '.properties.' | append: pk
        assign next_depth = depth | plus: 1
        function cr = 'modules/mcp/helpers/registry/validate_schema_node', node: child, depth: next_depth, max_depth: max_depth, path: child_path, output: output
        unless cr.valid
          for e in cr.errors
            assign errors = errors | array_add: e
          endfor
        endunless
        for l in cr.lint
          assign lint = lint | array_add: l
        endfor
      endfor
    endif
  endif

  # Recurse: array items (single schema).
  if node_types contains 'array'
    assign items = node.items
    unless items == blank
      assign child_path = at | append: '.items'
      assign next_depth = depth | plus: 1
      function ir = 'modules/mcp/helpers/registry/validate_schema_node', node: items, depth: next_depth, max_depth: max_depth, path: child_path, output: output
      unless ir.valid
        for e in ir.errors
          assign errors = errors | array_add: e
        endfor
      endunless
      for l in ir.lint
        assign lint = lint | array_add: l
      endfor
    endunless
  endif

  assign out = {}
  assign is_valid = false
  if errors.size == 0
    assign is_valid = true
  endif
  assign out['valid'] = is_valid
  assign out['errors'] = errors
  assign out['lint'] = lint
  return out
%}
