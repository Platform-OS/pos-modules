{%- comment -%}
  Validate ONE JSON-Schema node against the supported subset (spec §10.1). Called
  by registry/manifest_schema for input_schema/output_schema, and recurses into
  `properties.*` and `items`. An unsupported keyword anywhere causes the whole
  manifest to be REJECTED at load — an implementer must never be able to declare a
  constraint the module does not enforce (a silently-ignored keyword is a security
  hole, not a convenience).

  Enforced:
   - `type` present and one of object/string/integer/number/boolean/array. For an
     OUTPUT schema (`output: true`) `type` may also be a list of those types plus
     "null", because a result field can be empty; the engine never validates
     results against it, so the subset rule protects inputs only.
   - Only supported keywords per node (union set below); any other key → error.
   - additionalProperties, when present, must be boolean (it is FORCED to false at
     validation time regardless — §7.2 — but must be declarable only as a boolean).
   - pattern is length-capped and rejects classic catastrophic-backtracking
     nested-quantifier signatures (§16.4).
   - depth is capped (max_schema_depth) to bound validation cost (§10.1).
   - `format` in an INPUT schema must be one validate/json_schema enforces (uuid,
     email, date, date-time). Any other value would be silently ignored, so it is rejected;
     enforcing a new format later then only affects tools that opt in. An output
     schema is never validated against, so its formats are client hints only.

  Not enforced, reported: every `description` and `title` is model-read text, like the
  tool description, so each goes through registry/lint_description (§12.3). A hit is
  returned in `lint` for human attention and never makes the schema invalid.

  @param {object}  node  - a JSON-Schema node (hash)
  @param {integer} depth - current nesting depth (start 1)
  @param {integer} max_depth - cap
  @param {string}  path  - dotted location for error messages (e.g. properties.foo)
  @param {boolean} output - true for an output_schema node (default false)
  @return {object} { valid:boolean, errors:[string], lint:[{path, hits:[string]}] }
{%- endcomment -%}
{% liquid
  assign errors = []
  assign lint = []
  assign at = path | default: '(root)'

  if depth > max_depth
    assign msg = at | append: ': schema nesting exceeds max depth'
    assign errors = errors | array_add: msg
    assign out = {
      "valid": false,
      "errors": errors,
      "lint": lint
    }
    return out
  endif

  assign text_keys = 'description,title' | split: ','
  for text_key in text_keys
    assign text = node[text_key]
    if text == blank
      continue
    endif
    function text_lint = 'modules/mcp/helpers/registry/lint_description', text: text
    if text_lint.flagged
      assign hit_path = at | append: '.' | append: text_key
      assign hit = {
        "path": hit_path,
        "hits": text_lint.hits
      }
      assign lint = lint | array_add: hit
    endif
  endfor

  assign allowed = 'type,description,title,default,properties,required,additionalProperties,enum,minimum,maximum,exclusiveMinimum,exclusiveMaximum,minLength,maxLength,pattern,format,items,minItems,maxItems' | split: ','
  assign keys = node | hash_keys
  for k in keys
    unless allowed contains k
      assign msg = at | append: ': unsupported schema keyword "' | append: k | append: '"'
      assign errors = errors | array_add: msg
    endunless
  endfor

  assign output = output | default: false

  unless output or node.format == blank
    assign supported_formats = 'uuid,email,date,date-time' | split: ','
    unless supported_formats contains node.format
      assign msg = at | append: ': unsupported format "' | append: node.format | append: '" (supported: uuid, email, date, date-time)'
      assign errors = errors | array_add: msg
    endunless
  endunless

  assign t = node.type
  assign valid_types = 'object,string,integer,number,boolean,array' | split: ','
  assign node_types = []
  if t == blank
    assign msg = at | append: ': missing "type"'
    assign errors = errors | array_add: msg
  else
    assign t_kind = t | type_of | downcase
    if t_kind == 'array'
      if output
        assign output_types = valid_types | array_add: 'null'
        for listed_type in t
          if output_types contains listed_type
            assign node_types = node_types | array_add: listed_type
          else
            assign msg = at | append: ': invalid type "' | append: listed_type | append: '"'
            assign errors = errors | array_add: msg
          endif
        endfor
      else
        assign msg = at | append: ': "type" must be a single type'
        assign errors = errors | array_add: msg
      endif
    elsif valid_types contains t
      assign node_types = node_types | array_add: t
    else
      assign msg = at | append: ': invalid type "' | append: t | append: '"'
      assign errors = errors | array_add: msg
    endif
  endif

  # additionalProperties must be boolean if declared.
  assign ap = node.additionalProperties
  unless ap == blank
    unless ap == true or ap == false
      assign msg = at | append: ': additionalProperties must be boolean'
      assign errors = errors | array_add: msg
    endunless
  endunless

  # pattern safety (§16.4).
  assign pat = node.pattern
  unless pat == blank
    assign plen = pat | size
    if plen > 200
      assign msg = at | append: ': pattern too long'
      assign errors = errors | array_add: msg
    endif
    assign bad_sigs = '+)+,*)*,+)*,*)+,))*,))+' | split: ','
    for s in bad_sigs
      if pat contains s
        assign msg = at | append: ': pattern has catastrophic-backtracking risk'
        assign errors = errors | array_add: msg
        break
      endif
    endfor
  endunless

  # Recurse: object properties.
  if node_types contains 'object'
    assign props = node.properties
    unless props == blank
      assign pkeys = props | hash_keys
      for pk in pkeys
        assign child = props[pk]
        assign child_path = at | append: '.properties.' | append: pk
        assign next_depth = depth | plus: 1
        function cr = 'modules/mcp/helpers/registry/validate_schema_node', node: child, depth: next_depth, max_depth: max_depth, path: child_path, output: output
        unless cr.valid
          for e in cr.errors
            assign errors = errors | array_add: e
          endfor
        endunless
        for l in cr.lint
          assign lint = lint | array_add: l
        endfor
      endfor
    endunless
  endif

  # Recurse: array items (single schema).
  if node_types contains 'array'
    assign items = node.items
    unless items == blank
      assign child_path = at | append: '.items'
      assign next_depth = depth | plus: 1
      function ir = 'modules/mcp/helpers/registry/validate_schema_node', node: items, depth: next_depth, max_depth: max_depth, path: child_path, output: output
      unless ir.valid
        for e in ir.errors
          assign errors = errors | array_add: e
        endfor
      endunless
      for l in ir.lint
        assign lint = lint | array_add: l
      endfor
    endunless
  endif

  assign out = {}
  assign is_valid = false
  if errors.size == 0
    assign is_valid = true
  endif
  assign out['valid'] = is_valid
  assign out['errors'] = errors
  assign out['lint'] = lint
  return out
%}
