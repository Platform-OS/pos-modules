{%- comment -%}
  pos-module-mcp — resolved module configuration (spec §17.1).

  Layer-1 defaults live here so the engine is inert-but-armed with sane values on
  install. An app overrides any key via an instance constant `MCP_CONFIG` holding
  a JSON object (merged shallowly over these defaults) — so operators tune limits
  without forking the module. Read once per request; callers should assign it and
  reuse rather than re-invoking.

  @return {object} the effective config: protocol_version, server_{name,version},
                   defaults{max_input_bytes,max_schema_depth,rate_limit_per_min,…},
                   resources{…}, oauth{…}, resource_identifier.

  Only keys the engine acts on belong here: an adopter who sets a key must get the
  behaviour it names. A feature that is not implemented yet gets its key when it is.
{%- endcomment -%}
{% liquid
  # Per-request memo (spec §17.3). config is a PURE function of the MCP_CONFIG /
  # MCP_OAUTH_* constants + request host — all invariant within a single request —
  # yet it is invoked from ~18 call sites and rebuilt several times per tools/call
  # across partial boundaries (a plain `assign` cannot be reused across a `function`
  # call). context.exports is threaded through the shared Liquid environment, so a
  # value exported by the FIRST invocation is readable by every later one in the
  # SAME request (and never leaks across requests — that is the cache tag, not this).
  # Return the memo when present; otherwise build once and export at the bottom.
  # Safe to share by reference: every caller binds the result read-only (no caller
  # mutates it in place). `context.exports` is nil until something is exported, and
  # nil traversal yields nil (= blank), so the guard is safe on the first call.
  # platformos-check-disable UnknownProperty
  assign cfg_memo = context.exports.mcp.config
  # platformos-check-enable UnknownProperty
  unless cfg_memo == blank
    return cfg_memo
  endunless

  assign c = {}
  # MCP protocol revisions (spec §13.1/§18.7; see helpers/protocol/negotiate).
  # `protocol_version` is the DEFAULT legacy revision: a version-less request and an
  # `initialize` asking for an unknown revision get it, so existing clients are
  # unchanged. `supported_protocol_versions` is every revision the server implements
  # (latest first); `modern_protocol_versions` are those a client declares per request
  # in `_meta` (2026-07-28 and later). The rest are legacy, reached through `initialize`.
  assign c['protocol_version'] = '2025-06-18'
  assign c['latest_protocol_version'] = '2026-07-28'
  assign c['supported_protocol_versions'] = '2026-07-28,2025-06-18' | split: ','
  assign c['modern_protocol_versions'] = '2026-07-28' | split: ','
  # Client-side cache hints (ttlMs/cacheScope) attached to cacheable results ONLY for a
  # modern request. The registry and server description are deploy-invariant → long
  # TTL; resources track page content → shorter. cacheScope is 'public' (same for every
  # caller) or 'private' (varies by identity: principal-scoped tools/list).
  # Tunable via MCP_CONFIG.cache.
  assign cache = {
    "tools_ttl_ms": 300000,
    "prompts_ttl_ms": 300000,
    "resources_ttl_ms": 60000,
    "discover_ttl_ms": 300000
  }
  assign c['cache'] = cache
  # Server display name — reported as serverInfo.name on `initialize` and `server/discover` AND used as
  # the suggested `claude mcp add <name>` client alias on /mcp-tools. Override per
  # instance via MCP_CONFIG {"server_name":"acme-community"} to brand the server.
  assign c['server_name'] = 'pos-module-mcp'
  assign c['server_version'] = '0.1.0'
  # App-provided registry partial (Layer-2 tool declarations, spec §8.2). An app
  # partial at app/lib/mcp/registry.liquid returning [{manifest},...].
  assign c['registry_partial'] = 'mcp/registry'
  # App-provided authorization policy partials (spec §12.2). A tool's named policy
  # resolves to <policy_prefix>/<name> = app/lib/mcp/policies/<name>.liquid.
  assign c['policy_prefix'] = 'mcp/policies'
  # App-provided connection instructions partial — the house rules / persona sent
  # to the agent on `initialize` and `server/discover`. app/lib/mcp/instructions.liquid
  # returning a string. Falls back to a built-in default when absent.
  assign c['instructions_partial'] = 'mcp/instructions'
  # App-provided prompt registry (§13.1 prompts). app/lib/mcp/prompts.liquid
  # returning [{name, description, arguments, template}]. Empty/absent = no prompts.
  assign c['prompts_partial'] = 'mcp/prompts'
  # App-provided resource provider (§13.1 resources). app/lib/mcp/resources.liquid
  # answering list / templates / read for an AUTHENTICATED caller, who is passed in so
  # the app applies its own access rules (queries/resources/provider). Absent = only
  # the opt-in markdown pages below.
  assign c['resources_partial'] = 'mcp/resources'
  # tools/list visibility (spec §14.2). 'open' (default) advertises every registered
  # tool to any caller — MCP discovery is a public method. 'principal' scopes the
  # advertised list to the CALLER: a tool appears only if its authorization policy
  # admits that principal, so restricted tools are not leaked to unauthorized (or
  # anonymous) callers (least-disclosure). Execution is authorized per-call either
  # way; this only controls what discovery reveals. Opt in per instance via
  # MCP_CONFIG {"tools_list_scope":"principal"} (any value other than the exact
  # string "principal" is treated as "open"). Cost: 'principal' evaluates each tool's
  # policy on every tools/list, so it is off by default.
  assign c['tools_list_scope'] = 'open'

  assign d = {
    "max_input_bytes": 65536,
    "max_schema_depth": 5
  }
  # Depth cap for a tool's output_schema (declared for clients, never used to validate
  # input), which describes nested results such as lists of objects with lists.
  assign d['max_output_schema_depth'] = 8
  assign d['rate_limit_per_min'] = 60
  # Idempotency replay window (§16.3): how long a client key can replay its result.
  assign d['idempotency_window_seconds'] = 86400
  # Approval window (§9.6): how long a pending approval can be acted on before it expires.
  assign d['approval_window_seconds'] = 604800
  # Approval-queue guard (§9.6): max NON-EXPIRED pending approvals a single principal
  # may hold at once. Bounds operator-queue depth so an agent cannot flood the
  # human-in-the-loop gate with garbage and bury legitimate proposals. Identical
  # proposals (same input_sha256) are additionally deduplicated. 0 disables the cap.
  assign d['approval_max_pending_per_principal'] = 3
  # Suggested polling interval for an approval task (Tasks extension `pollIntervalMs`).
  # An operator decides in minutes or hours, so polling faster only adds load.
  assign d['task_poll_interval_ms'] = 30000
  # Abuse auto-suspend: if a principal accrues this many policy violations (denials,
  # rate-limits, invalid/unknown-tool attempts) within the window, its current token
  # is auto-suspended. A real control, not a message. 0 disables.
  assign d['abuse_threshold'] = 20
  assign d['abuse_window_seconds'] = 300
  assign c['defaults'] = d

  # Zero-config .md resources (spec §3.2, §17.1). OFF by default — an operator
  # turns it on via MCP_CONFIG and names the slug prefixes to expose (allowlist),
  # so no page is agent-readable unless explicitly opted in.
  assign r = {
    "expose_markdown_pages": false,
    "markdown_page_prefixes": ["docs"]
  }
  assign c['resources'] = r

  # OAuth (spec §9.5, RFC 9728). The instance is BOTH the protected resource and — via
  # the built-in authorization server (/oauth/*) — the issuer of opaque access tokens
  # bound to a real user (same mcp_token store as manual tokens, so no JWT signing keys
  # are needed). An external authorization server is not supported yet: it needs
  # token validation in identity/resolve_principal before it can be configured.
  assign o = {}
  # Built-in authorization server (OAuth 2.1 authorization code + PKCE S256). false
  # turns it off; only manual tokens from /mcp-tools then work.
  assign o['authorization_server'] = true
  # User permission required to authorize a client (same gate as minting at /mcp-tools).
  assign o['required_permission'] = 'mcp.tokens.manage'
  # mcp:read = discovery, resources, prompts, non-mutating tools (always granted).
  # mcp:write = tools whose manifest declares mutating:true. Manual tokens carry all.
  assign scopes = 'mcp:read,mcp:write' | split: ','
  assign o['scopes_supported'] = scopes
  assign o['default_scope'] = 'mcp:read mcp:write'
  assign o['access_token_ttl_seconds'] = 3600
  assign o['refresh_token_ttl_seconds'] = 2592000
  assign o['code_ttl_seconds'] = 60
  # Client registration: Client ID Metadata Documents (client_id = https URL; the
  # 2026-07-28 preferred path) and/or Dynamic Client Registration (RFC 7591).
  assign o['client_id_metadata_documents'] = true
  assign o['dynamic_client_registration'] = true
  assign o['registration_rate_limit_per_min'] = 10
  assign o['token_rate_limit_per_min'] = 60
  # When true, `initialize` (legacy) and `server/discover` (modern) WITHOUT a valid bearer
  # answer 401 + WWW-Authenticate so MCP clients start the OAuth flow on connect (most
  # clients only begin auth on a 401 at connect time). Off by default: discovery stays
  # open for existing clients.
  assign o['challenge_initialize'] = false
  assign c['oauth'] = o
  # The OAuth resource identifier this instance defends (RFC 9728) = the /mcp URL. The
  # path is fixed: the endpoint page and the RFC 9728 metadata path are both `mcp`, and
  # every OAuth grant is bound to this value.
  function origin = 'modules/mcp/queries/origin'
  assign c['resource_identifier'] = origin | append: '/mcp'

  # Override from the MCP_CONFIG constant, when present and valid JSON. hash_merge
  # is shallow, so merge the nested `defaults` object explicitly before the
  # top-level merge — otherwise overriding one limit would drop the others.
  assign raw = context.constants.MCP_CONFIG | default: ''
  if raw != blank
    assign override = raw | parse_json: raw_text: true
    unless override == blank
      # `override` is operator-supplied JSON (parse_json) — its keys are dynamic, so
      # the linter's static property check can't see them. Correct at runtime.
      # platformos-check-disable UnknownProperty
      unless override.defaults == blank
        assign merged_defaults = c.defaults | hash_merge: override.defaults
        assign override['defaults'] = merged_defaults
      endunless
      unless override.resources == blank
        assign merged_resources = c.resources | hash_merge: override.resources
        assign override['resources'] = merged_resources
      endunless
      unless override.oauth == blank
        assign merged_oauth = c.oauth | hash_merge: override.oauth
        assign override['oauth'] = merged_oauth
      endunless
      # platformos-check-enable UnknownProperty
      assign c = c | hash_merge: override
    endunless
  endif

  # Derived: whether the built-in AS is live (the flag callers check). An instance that
  # still sets the retired MCP_OAUTH_ISSUER constant meant "an external issuer, not
  # this instance": keep the built-in AS off (fail closed) rather than start minting.
  assign oauth_cfg = c.oauth
  assign builtin = false
  if oauth_cfg.authorization_server
    assign builtin = true
  endif
  assign retired_issuer = context.constants.MCP_OAUTH_ISSUER | default: ''
  if retired_issuer != blank
    assign builtin = false
    log 'MCP_OAUTH_ISSUER is no longer supported; the built-in authorization server stays off while it is set', type: 'mcp.config_retired_issuer'
  endif
  assign oauth_cfg['builtin'] = builtin

  # Memoize the fully-resolved config for the remainder of THIS request (see the
  # top-of-file note). `export` stores `config` under context.exports.mcp.config,
  # which the read guard above consumes on every subsequent invocation.
  assign config = c
  export config, namespace: 'mcp'
  return config
%}
