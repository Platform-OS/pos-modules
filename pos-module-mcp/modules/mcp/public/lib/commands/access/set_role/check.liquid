{% doc %}
  @param {object} object - built by access/set_role/build
{% enddoc %}
{% liquid
  assign c = { "errors": {}, "valid": true }
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'profile_id'
  if object.role != blank
    assign roles = 'mcp_user,mcp_operator' | split: ','
    function c = 'modules/core/validations/included', c: c, object: object, field_name: 'role', array: roles
  endif

  assign object.valid = c.valid
  assign object.errors = c.errors
  return object
%}
