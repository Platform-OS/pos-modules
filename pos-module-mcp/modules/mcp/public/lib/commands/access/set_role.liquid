{% doc %}
  Set a member's MCP role on their user-module profile (operator action). Removes both
  MCP roles, then appends `role` when given — so a profile holds at most one of them.
  An empty `role` removes MCP access AND revokes every active bearer token the user
  holds — removing access must cut off agents already connected with those tokens, not
  only stop new mints. The caller (operator page) enforces mcp.admin.

  Roles (define their permissions in the app's role_permissions override):
    mcp_user     → mcp.tokens.manage
    mcp_operator → mcp.tokens.manage, mcp.admin

  @param {string} profile_id - the user-module profile id
  @param {string} [role] - mcp_user | mcp_operator | blank to remove access
{% enddoc %}
{% liquid
  assign out = { "ok": false }
  if profile_id == blank
    return out
  endif
  unless role == blank or role == 'mcp_user' or role == 'mcp_operator'
    return out
  endunless

  function _ = 'modules/user/commands/profiles/roles/remove', id: profile_id, role: 'mcp_user'
  function _ = 'modules/user/commands/profiles/roles/remove', id: profile_id, role: 'mcp_operator'
  if role != blank
    function _ = 'modules/user/commands/profiles/roles/append', id: profile_id, role: role
  else
    function profile = 'modules/user/queries/profiles/find', id: profile_id, user_id: null, uuid: null, first_name: null, last_name: null
    assign uid = profile.user_id | append: ''
    unless uid == blank
      graphql revoked = 'modules/mcp/tokens/revoke_for_user', user_id: uid
      assign out['tokens_revoked'] = revoked.tokens.count
    endunless
  endif

  assign out['ok'] = true
  return out
%}
