{%- comment -%}
  Token revocation (RFC 7009). Accepts an access OR refresh token; revoking either
  revokes the whole grant (one mcp_token row). Always 200 for unknown tokens (§2.2),
  and only revokes when the token belongs to the presenting client_id (public
  clients identify, they do not authenticate).

  @param {object} params - context.params (token, token_type_hint, client_id)
  @return {object} { http_status, body }
{%- endcomment -%}
{% liquid
  assign out = {}
  assign out['http_status'] = 200
  assign out['body'] = {}
  assign t = params.token | default: '' | append: ''
  if t == blank
    function e = 'modules/mcp/commands/oauth/error', error: 'invalid_request', error_description: 'token is required', http_status: null
    return e
  endif
  assign d = t | digest: 'sha256'
  graphql a = 'modules/mcp/tokens/find_by_digest', token_digest: d
  assign row = a.records.results.first
  if row == blank
    graphql r = 'modules/mcp/tokens/find_by_refresh_digest', digest: d
    assign row = r.records.results.first
  endif
  if row and row.kind == 'oauth' and row.client_id == params.client_id and row.status == 'active'
    graphql _ = 'modules/mcp/tokens/revoke', id: row.id
  endif
  return out
%}
