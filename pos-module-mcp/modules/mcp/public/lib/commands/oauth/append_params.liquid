{%- comment -%}
  Append query parameters to a redirect URI, preserving any query it already has
  (OAuth 2.1 §4.1.2). Blank values are skipped. Pure.

  @param {string} url
  @param {object} params - { name: value }
  @return {string}
{%- endcomment -%}
{% liquid
  assign out = url
  assign sep = '?'
  if url contains '?'
    assign sep = '&'
  endif
  for pair in params
    if pair[1] != blank
      assign k = pair[0] | url_encode
      assign v = pair[1] | url_encode
      assign out = out | append: sep | append: k | append: '=' | append: v
      assign sep = '&'
    endif
  endfor
  return out
%}
