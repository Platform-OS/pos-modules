{%- comment -%}
  Build the tool registry (spec §8.1, §8.2, §4.2). Registration is CODE, not data:
  the app declares its tools in a registry partial (config.registry_partial,
  default 'mcp/registry') that returns [{ name, path }, ...]. Each `path` is a tool
  directory whose `manifest` partial returns the manifest hash. This is the tool-
  poisoning mitigation as a structural property — every declaration passed review.

  Inert-but-armed: if the app has NOT implemented the registry partial, this
  returns an empty tool set (endpoint live, no tools) rather than erroring. Each
  manifest is validated against the meta-schema; a manifest that fails to load, or
  whose declared name does not match its registration, or that fails validation, is
  EXCLUDED and logged — never served degraded (§8.1). No implicit allow.

  @return {object} { tools:[valid manifest + _warnings], excluded:[{name,errors}], count }
{%- endcomment -%}
{% liquid
  function cfg = 'modules/mcp/commands/config'
  assign partial = cfg.registry_partial | default: 'mcp/registry'

  assign entries = null
  try
    function entries = partial
  catch e
    unless e.message contains "can't find partial"
      log e.message, type: 'mcp.registry_build_error'
    endunless
    assign entries = null
  endtry

  assign tools = '[]' | parse_json
  assign excluded = '[]' | parse_json

  if entries
    for entry in entries
      assign reg_name = entry.name
      assign path = entry.path

      # --- Load the tool's manifest partial (isolated: one bad tool can't nuke the set). ---
      assign manifest = null
      assign load_error = null
      if path == blank
        assign load_error = 'registry entry missing path'
      else
        assign manifest_path = path | append: '/manifest'
        try
          function manifest = manifest_path
        catch e
          assign load_error = 'manifest failed to load'
          assign _lm = reg_name | default: path | append: ': ' | append: e.message
          log _lm, type: 'mcp.registry_manifest_load_error'
        endtry
      endif

      if load_error
        assign ex = '{}' | parse_json
        hash_assign ex['name'] = reg_name | default: '(unnamed)'
        assign errs = '[]' | parse_json
        assign errs = errs | array_add: load_error
        hash_assign ex['errors'] = errs
        assign excluded = excluded | array_add: ex
        continue
      endif

      # --- Identity guard: a manifest may not claim a name other than the one it
      #     was registered under (prevents a moved/edited file shadowing another). ---
      if reg_name != blank and manifest.name != reg_name
        assign ex = '{}' | parse_json
        hash_assign ex['name'] = reg_name
        assign errs = '[]' | parse_json
        assign gmsg = 'manifest name "' | append: manifest.name | append: '" does not match registered name "' | append: reg_name | append: '"'
        assign errs = errs | array_add: gmsg
        hash_assign ex['errors'] = errs
        assign excluded = excluded | array_add: ex
        log gmsg, type: 'mcp.registry_name_mismatch'
        continue
      endif

      # --- Meta-schema validation. ---
      function v = 'modules/mcp/commands/registry/manifest_schema', manifest: manifest, max_depth: cfg.defaults.max_schema_depth
      if v.valid
        assign m = manifest
        hash_assign m['_warnings'] = v.warnings
        assign tools = tools | array_add: m
        if v.warnings.size > 0
          assign wj = v.warnings | join: '; '
          assign _lm = v.name | append: ': ' | append: wj
          log _lm, type: 'mcp.registry_lint_warning'
        endif
      else
        assign ex = '{}' | parse_json
        hash_assign ex['name'] = v.name | default: reg_name | default: '(unnamed)'
        hash_assign ex['errors'] = v.errors
        assign excluded = excluded | array_add: ex
        assign ej = v.errors | join: '; '
        assign _lm = ex.name | append: ': ' | append: ej
        log _lm, type: 'mcp.registry_excluded_manifest'
      endif
    endfor
  endif

  # Built-in engine tools (spec §9.6) — always served, no app registration. Their
  # handlers are module commands; they use the mcp_authenticated built-in policy and
  # self-scope. Injected after app tools so an app cannot shadow them by name.
  assign builtin = '{}' | parse_json
  hash_assign builtin['name'] = 'mcp_approval_status'
  hash_assign builtin['version'] = '1.0.0'
  hash_assign builtin['description'] = 'Check the status of an action you requested that required operator approval. Pass the handle you were given. Returns pending, executed, rejected, or expired.'
  hash_assign builtin['input_schema'] = '{"type":"object","additionalProperties":false,"required":["handle"],"properties":{"handle":{"type":"string","minLength":1,"maxLength":100,"description":"the approval handle returned when a tool required approval"}}}' | parse_json
  hash_assign builtin['mutating'] = false
  hash_assign builtin['authorization_policy'] = 'mcp_authenticated'
  hash_assign builtin['requires_approval'] = false
  hash_assign builtin['handler'] = 'modules/mcp/commands/builtin/approval_status'
  hash_assign builtin['builtin'] = true
  hash_assign builtin['_warnings'] = '[]' | parse_json
  assign tools = tools | array_add: builtin

  assign out = '{}' | parse_json
  hash_assign out['tools'] = tools
  hash_assign out['excluded'] = excluded
  hash_assign out['count'] = tools | size
  return out
%}
