{%- comment -%}
  A chosen label must not match (ignoring case) the label of another ACTIVE manual
  token of the same user; OAuth tokens and revoked tokens do not count.

  @param {object} object - built by tokens/mint/build
{%- endcomment -%}
{% liquid
  assign c = { "errors": {}, "valid": true }
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'user_id'
  unless object.generated_label
    graphql active = 'modules/mcp/tokens/active_for_user', user_id: object.user_id
    assign wanted = object.label | downcase
    for t in active.records.results
      if t.kind == 'oauth'
        continue
      endif
      assign existing = t.label | default: '' | downcase
      if existing == wanted
        function c = 'modules/core/helpers/register_error', contract: c, field_name: 'label', message: 'label_taken'
        break
      endif
    endfor
  endunless

  assign object.valid = c.valid
  assign object.errors = c.errors
  return object
%}
