{%- comment -%}
  Execute an APPROVED action as the original principal (spec §9.6). Re-enters the
  pipeline: re-resolve the tool, re-check the requesting credential, re-validate the
  arguments, and RE-AUTHORIZE against the original principal (defense in depth — the
  tool, its schema, or its policy may have changed, or the requester's token or rights
  may have been revoked, since the request). An operator's approval never revives a
  credential that could no longer make the call itself:
  the requesting token (approval.token_id) is re-checked by
  identity/token_still_authorized — the same rules as the inline call. Approvals
  queued before token_id was recorded only re-check the user's permission.
  Then execute inside a transaction and attest, linked to the original request by
  request_id.

  The operator only DECIDES; the action runs with the requester's identity and
  scope, never the operator's. Returns an outcome the caller records on the approval
  row and shows the agent.

  The outcome carries exactly what the inline tools/call would have answered, so a
  task reports it unchanged (Tasks extension, "Task Execution Errors"):
  - `error` — the JSON-RPC error when the call cannot run any more (unknown tool,
    requester's access revoked, forbidden), with the codes tools_call uses;
  - `result` — the tool result (CallToolResult): arguments that no longer validate
    (isError: true, structuredContent.validation_errors), or the handler's result,
    including a handler error or a rolled-back write (isError: true).

  @param {object} approval    - the pending_approval record, already claimed (pending → approved) via approval/claim
  @param {string} decided_by  - operator user id (for the ledger + audit)
  @return {object} { ok, outcome: 'executed'|'failed', summary, result?, error? }
{%- endcomment -%}
{% liquid
  function cfg = 'modules/mcp/helpers/config'

  assign fail = { "ok": false }

  # 1. Tool must still exist and be valid.
  function tool = 'modules/mcp/queries/registry/resolve_tool', name: approval.tool_name, allowed_tools: null
  if tool == blank
    assign err = {
      "code": -32602,
      "message": "Unknown tool"
    }
    assign fail['outcome'] = 'failed'
    assign fail['summary'] = 'Tool no longer available.'
    assign fail['error'] = err
    return fail
  endif

  # 1b. The requesting credential must still be able to make this call
  #     (identity/token_still_authorized). Rows queued before token_id was recorded
  #     have no token to re-check; for those only the user's permission is checked.
  if approval.token_id == blank
    assign perm_principal_user_id = approval.principal_id | remove_first: 'user:'
    assign perm_principal = { "user_id": perm_principal_user_id }
    function still_allowed = 'modules/mcp/queries/principal/can', principal: perm_principal, do: cfg.oauth.required_permission
    assign cred = {
      "ok": still_allowed,
      "reason": "permission_revoked"
    }
  else
    function cred = 'modules/mcp/queries/identity/token_still_authorized', token_id: approval.token_id, principal_id: approval.principal_id, tool: tool
  endif
  unless cred.ok
    log cred.reason, type: 'mcp.approval_requester_revoked'
    assign err = {
      "code": -32001,
      "message": "Forbidden"
    }
    assign fail['outcome'] = 'failed'
    assign fail['summary'] = "Requester's access was revoked."
    assign fail['error'] = err
    return fail
  endunless

  assign args = approval.arguments_json | parse_json: raw_text: true

  # 2. Re-validate the persisted arguments against the current schema.
  function val = 'modules/mcp/helpers/validate/json_schema', value: args, schema: tool.input_schema, depth: 1, max_depth: cfg.defaults.max_schema_depth, path: 'arguments'
  unless val.valid
    function invalid_result = 'modules/mcp/helpers/rpc/invalid_arguments_result', errors: val.errors, tool: tool
    assign fail['outcome'] = 'failed'
    assign fail['summary'] = 'Arguments no longer valid.'
    assign fail['result'] = invalid_result
    return fail
  endunless

  # 3. Reconstruct the ORIGINAL principal/agent (never the operator's).
  assign principal = { "id": approval.principal_id }
  assign principal['user_id'] = approval.principal_id | remove_first: 'user:'
  assign agent = { "id": approval.requested_by_agent }
  assign agent['client_id'] = approval.requested_by_client_id | default: approval.requested_by_agent
  assign agent['token_id'] = approval.requested_by_token_id

  # 4. Re-authorize against the original principal (fail-closed).
  function authz = 'modules/mcp/commands/authorize/evaluate', policy: tool.authorization_policy, principal: principal, agent: agent, arguments: args, tool: tool, delegation_mode: 'direct'
  unless authz.allow
    assign err = {
      "code": -32001,
      "message": "Forbidden"
    }
    assign fail['outcome'] = 'failed'
    assign fail['summary'] = 'Authorization denied at execution time.'
    assign fail['error'] = err
    return fail
  endunless

  # 5. Attestation for the deferred execution, linked to the request by request_id.
  assign le = {
    "method": "tools/call",
    "tool_name": tool.name,
    "tool_version": tool.version,
    "principal_id": approval.principal_id,
    "agent_id": approval.requested_by_agent,
    "delegation_mode": "direct",
    "input_sha256": approval.input_sha256,
    "authz_policy": tool.authorization_policy,
    "authz_decision": "allow"
  }
  assign le['authz_reason'] = 'approved_by:' | append: decided_by
  assign le['request_id'] = approval.request_id

  assign context_meta = {
    "tool_name": tool.name,
    "tool_version": tool.version,
    "request_id": approval.request_id
  }

  # 6. Execute inside a transaction, attest inside it; roll back on failure.
  assign committed = false
  transaction
    function exec = 'modules/mcp/commands/execute/run', tool: tool, arguments: args, principal: principal, agent: agent, context_meta: context_meta
    if exec.outcome == 'success'
      assign le['execution_outcome'] = 'success'
      unless exec.subject_type == blank
        assign le['subject_type'] = exec.subject_type
        assign le['subject_id'] = exec.subject_id
      endunless
      assign append_ok = false
      try
        function _ = 'modules/mcp/commands/ledger/append', entry: le
        assign append_ok = true
      catch e
        log e.message, type: 'mcp.approval_ledger_append_failed'
      endtry
      # `rollback` is a valid platformOS transaction tag; the linter's HTML/Liquid
      # parser mis-flags it inside this block. Correct at runtime.
      # platformos-check-disable LiquidHTMLSyntaxError
      if append_ok
        assign committed = true
      else
        rollback
      endif
    else
      rollback
    endif
  endtransaction
  # platformos-check-enable LiquidHTMLSyntaxError

  unless committed
    assign le['execution_outcome'] = 'rolled_back'
    assign le['error_code'] = -32003
    function _ = 'modules/mcp/commands/ledger/append', entry: le
    # Same answer as the inline path: a handler business error keeps its own message;
    # a handler success whose attestation failed is reported as rolled back.
    if exec.outcome == 'success'
      assign rb_content = []
      assign rb_item = {
        "type": "text",
        "text": "The action failed and was rolled back; no changes were saved."
      }
      assign rb_content = rb_content | array_add: rb_item
      assign failed_result = {
        "content": rb_content,
        "isError": true
      }
    else
      function failed_result = 'modules/mcp/helpers/execute/result_of', exec: exec
    endif
    assign fail['outcome'] = 'failed'
    assign fail['summary'] = 'Execution failed and was rolled back.'
    assign fail['result'] = failed_result
    return fail
  endunless

  function result = 'modules/mcp/helpers/execute/result_of', exec: exec
  assign out = {
    "ok": true,
    "outcome": "executed",
    "result": result
  }
  assign summary = 'Executed'
  unless exec.subject_id == blank
    assign summary = 'Executed — created ' | append: exec.subject_type | append: ' ' | append: exec.subject_id
  endunless
  assign out['summary'] = summary
  return out
%}
