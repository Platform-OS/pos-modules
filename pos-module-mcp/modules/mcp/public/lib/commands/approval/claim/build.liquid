{%- comment -%}
  @param {string} id
  @param {string} handle
  @param {string} status
  @param {string} decided_by
  @param {string} result_summary
  @param {string} ledger_reason
{%- endcomment -%}
{% liquid
  assign object = {
    "id": id,
    "handle": handle,
    "status": status,
    "decided_by": decided_by,
    "result_summary": result_summary,
    "ledger_reason": ledger_reason
  }
  return object
%}
