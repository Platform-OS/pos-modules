{%- comment -%}
  Deterministic eval run (spec §19.3). Measures whether the tool surface holds up as
  it grows — the failure mode that degrades tool selection silently:
    surface/desc_present  — every served tool has a real description (>= 20 chars)
    surface/no_poison     — no model-read text of a served tool trips the tool-poisoning
                            lint: its description, its title, and every description and
                            title in its input and output schemas
    surface/desc_unique   — no two tools share an identical description (ambiguous)
    surface/instructions_no_poison — the connection instructions pass the same lint
    surface/prompt_no_poison — each prompt's title, description and argument
                            descriptions pass it (prompts offered to an anonymous
                            caller; prompts offered only to signed-in callers are not seen)
    golden/case_tool_exists — each golden case's expected tool is still registered
    golden/case_args_valid  — each golden case's example arguments still validate
                              against that tool's schema (a correct call is well-formed)

  The module does not call LLMs (spec §2), so the LLM-driven "did the descriptions
  actually lead the model to this tool" check lives in the external runner
  (modules/mcp/tests/eval.mjs); this command is the deterministic core, runnable
  synchronously or from a background job. Stores one mcp_eval_run record (queryable,
  CI-gateable) and returns the summary.

  @return {object} { run_id, total, passed, failed, failures:[{category,check,target,detail}] }
{%- endcomment -%}
{% liquid
  function cfg = 'modules/mcp/helpers/config'
  assign run_id = '' | uuid | prepend: 'mcp_run_'
  assign occurred_at = 'now' | to_time | strftime: '%Y-%m-%dT%H:%M:%SZ'

  function reg = 'modules/mcp/queries/registry/load'
  assign tools = reg.tools

  assign checks = []
  assign desc_map = {}

  # ---- per-tool surface checks ----
  for t in tools
    assign dlen = t.description | default: '' | size
    assign present = false
    if dlen >= 20
      assign present = true
    endif
    assign c = {
      "category": "surface",
      "check": "desc_present",
      "target": t.name,
      "passed": present
    }
    unless present
      assign c['detail'] = 'description shorter than 20 chars'
    endunless
    assign checks = checks | array_add: c

    # The registry linted every model-read text of the tool when it was built (_lint).
    assign poison = []
    for l in t._lint
      assign joined = l.hits | join: ', '
      assign entry = l.path | append: ': ' | append: joined
      assign poison = poison | array_add: entry
    endfor
    assign clean = true
    if poison.size > 0
      assign clean = false
    endif
    assign c2 = {
      "category": "surface",
      "check": "no_poison",
      "target": t.name,
      "passed": clean
    }
    unless clean
      assign c2['detail'] = poison | join: '; '
    endunless
    assign checks = checks | array_add: c2

    assign d = t.description | default: ''
    assign prev = desc_map[d] | default: 0
    assign desc_map[d] = prev | plus: 1
  endfor

  # ---- description uniqueness (one check per tool) ----
  for t in tools
    assign d = t.description | default: ''
    assign cnt = desc_map[d] | default: 0
    assign uniq = true
    if cnt > 1
      assign uniq = false
    endif
    assign c = {
      "category": "surface",
      "check": "desc_unique",
      "target": t.name,
      "passed": uniq
    }
    unless uniq
      assign c['detail'] = 'description is identical to another tool'
    endunless
    assign checks = checks | array_add: c
  endfor

  # ---- model-read text outside the tools: connection instructions and prompts ----
  function instructions = 'modules/mcp/queries/instructions'
  function instructions_lint = 'modules/mcp/helpers/registry/lint_description', text: instructions
  assign c = {
    "category": "surface",
    "check": "instructions_no_poison",
    "target": "instructions"
  }
  if instructions_lint.flagged
    assign c['passed'] = false
    assign c['detail'] = instructions_lint.hits | join: ', '
  else
    assign c['passed'] = true
  endif
  assign checks = checks | array_add: c

  function prompt_reg = 'modules/mcp/queries/registry/build_prompts', principal: null, agent: null
  for p in prompt_reg.prompts
    assign prompt_texts = {
      "title": p.title,
      "description": p.description
    }
    for a in p.arguments
      assign arg_key = 'arguments.' | append: a.name | append: '.description'
      assign prompt_texts[arg_key] = a.description
    endfor
    assign poison = []
    for pt in prompt_texts
      if pt[1] == blank
        continue
      endif
      function prompt_lint = 'modules/mcp/helpers/registry/lint_description', text: pt[1]
      if prompt_lint.flagged
        assign joined = prompt_lint.hits | join: ', '
        assign entry = pt[0] | append: ': ' | append: joined
        assign poison = poison | array_add: entry
      endif
    endfor
    assign c = {
      "category": "surface",
      "check": "prompt_no_poison",
      "target": p.name
    }
    if poison.size > 0
      assign c['passed'] = false
      assign c['detail'] = poison | join: '; '
    else
      assign c['passed'] = true
    endif
    assign checks = checks | array_add: c
  endfor

  # ---- golden-case checks ----
  graphql cres = 'modules/mcp/eval/cases_list', per_page: 200
  for kase in cres.records.results
    assign found = null
    for t in tools
      if t.name == kase.expected_tool
        assign found = t
        break
      endif
    endfor
    assign exists = false
    if found
      assign exists = true
    endif
    assign c = {
      "category": "golden",
      "check": "case_tool_exists",
      "target": kase.name,
      "passed": exists
    }
    unless exists
      assign det = 'expected_tool "' | append: kase.expected_tool | append: '" not registered'
      assign c['detail'] = det
    endunless
    assign checks = checks | array_add: c

    if found
      assign args = kase.expected_args_json | parse_json: raw_text: true
      function val = 'modules/mcp/helpers/validate/json_schema', value: args, schema: found.input_schema, depth: 1, max_depth: cfg.defaults.max_schema_depth, path: 'arguments'
      assign c2 = {
        "category": "golden",
        "check": "case_args_valid",
        "target": kase.name,
        "passed": val.valid
      }
      unless val.valid
        assign det = val.errors | join: '; '
        assign c2['detail'] = det
      endunless
      assign checks = checks | array_add: c2
    endif
  endfor

  # ---- manifest hygiene (ADVISORY warnings; do NOT fail the run) ----
  # Field-kind-aware so it does not cry wolf: no_maxlength flags any unbounded string;
  # no_pattern_on_string flags only display/content fields (name/title/description/…)
  # with no pattern/enum/format — the ones that can carry a stored HTML/script payload.
  # This is the live counterpart to the dev-time static linter, surfaced in /mcp-admin.
  assign warnings = []
  assign display_re = 'name,title,label,summary,description,short_description,venue,message,body,content,comment,subject,headline,caption'
  for t in tools
    assign props = t.input_schema.properties
    unless props == blank
      assign pkeys = props | hash_keys
      for pk in pkeys
        assign p = props[pk]
        if p.type == 'string'
          if p.maxLength == blank and p.enum == blank
            assign w = {
              "tool": t.name,
              "check": "no_maxlength",
              "field": pk,
              "detail": "string field has no maxLength (unbounded input)"
            }
            assign warnings = warnings | array_add: w
          endif
          assign constrained = false
          if p.pattern != blank or p.enum != blank or p.format != blank
            assign constrained = true
          endif
          assign is_display = false
          if display_re contains pk
            assign is_display = true
          endif
          if constrained == false and is_display
            assign w = {
              "tool": t.name,
              "check": "no_pattern_on_string",
              "field": pk
            }
            assign w['detail'] = 'display/content field has no pattern/enum — add "pattern":"^[^<>]*$" so HTML/script payloads are rejected at validation'
            assign warnings = warnings | array_add: w
          endif
        endif
      endfor
    endunless
  endfor
  assign warnings_json = warnings | json

  # ---- aggregate ----
  assign total = checks | size
  assign passed = 0
  assign failures = []
  for c in checks
    if c.passed
      assign passed = passed | plus: 1
    else
      assign failures = failures | array_add: c
    endif
  endfor
  assign failed = total | minus: passed
  assign failures_json = failures | json

  graphql _ = 'modules/mcp/eval/run_create', run_id: run_id, total: total, passed: passed, failed: failed, failures_json: failures_json, warnings_json: warnings_json, occurred_at: occurred_at

  assign out = {
    "run_id": run_id,
    "total": total,
    "passed": passed,
    "failed": failed,
    "failures": failures,
    "warnings": warnings
  }
  return out
%}
