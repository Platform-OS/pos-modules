{%- comment -%}
  Look up a prior idempotent result for (key, principal, tool) (spec §16.3). Scoped
  by principal so one member's key cannot replay another's result, and by tool so a
  key reused on a different tool is independent (never another tool's result). Entries past
  expires_at are treated as absent (a fresh execution replaces them).

  @param {string} key
  @param {string} principal_id
  @param {string} tool_name
  @return {object} { found:boolean, tool_name?, input_sha256?, response? }  (response = parsed cached MCP result)
{%- endcomment -%}
{% liquid
  assign now_unix = 'now' | to_time | strftime: '%s' | plus: 0
  graphql r = 'modules/mcp/idempotency/find', key: key, principal_id: principal_id, tool_name: tool_name
  assign rec = r.records.results.first

  assign out = {}
  assign out['found'] = false
  if rec
    assign exp = rec.expires_at | plus: 0
    if exp > now_unix
      assign out['found'] = true
      assign out['tool_name'] = rec.tool_name
      assign out['input_sha256'] = rec.input_sha256
      assign out['response'] = rec.response_json | parse_json
    endif
  endif
  return out
%}
