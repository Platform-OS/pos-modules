{%- comment -%}
  The counter key for this token in the current slice of the abuse window.

  @param {string} principal_id
  @param {string} token_id
{%- endcomment -%}
{% liquid
  function win = 'modules/mcp/helpers/limits/abuse_window'
  assign key = null
  assign tid = token_id | append: ''
  if win.enabled
    function key = 'modules/mcp/helpers/limits/abuse_key', principal_id: principal_id, token_id: tid, slice: win.current
  endif
  assign object = {
    "principal_id": principal_id,
    "token_id": tid,
    "enabled": win.enabled,
    "key": key
  }
  return object
%}
