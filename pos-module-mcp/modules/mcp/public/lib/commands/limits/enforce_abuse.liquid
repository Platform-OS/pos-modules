{%- comment -%}
  Auto-suspend on abuse (spec §12.4) — a real control, not a message. Reads the CALLING
  TOKEN's violation count over the rolling abuse window (queries/limits/abuse_counts;
  counters maintained by limits/note_violation, same cheap mechanism as the rate
  limiter). When that token's own count reaches the threshold it SUSPENDS that token
  (status → revoked, so its next call fails auth) and records a `security/suspend`
  ledger entry naming it.

  Policy: only the token that misbehaved is suspended. Violations are counted per
  token, so a narrowed token handed to a less-trusted agent cannot get the person's
  other tokens (or OAuth grants) revoked, and a token with no violations of its own is
  never suspended. The person's other tokens keep working.

  Runs on every authenticated tools/call and provider resources/read. Deliberately
  O(1): an earlier version scanned up to 100 ledger rows here, which grew with the
  ledger and pushed the request past platformOS's per-request budget — intermittently
  corrupting later pipeline steps. Never scan the ledger on the hot path.

  @param {string} token_id     - the mcp_token being used (auth.token_id)
  @param {string} principal_id
  @param {string} agent_id
  @param {string} client_id    - the token's client (auth.agent.client_id), for the ledger
  @return {object} { suspended:boolean, count:int }
{%- endcomment -%}
{% liquid
  function cfg = 'modules/mcp/helpers/config'
  assign threshold = cfg.defaults.abuse_threshold | plus: 0
  assign out = {
    "suspended": false,
    "count": 0
  }
  if threshold <= 0 or token_id == blank
    return out
  endif

  assign tid = token_id | append: ''
  assign subject = {
    "principal_id": principal_id,
    "token_id": tid
  }
  assign subjects = [] | array_add: subject
  function counts = 'modules/mcp/queries/limits/abuse_counts', subjects: subjects
  assign count = counts[tid] | default: 0 | plus: 0
  assign out['count'] = count

  if count >= threshold
    graphql _ = 'modules/mcp/tokens/suspend', id: tid
    assign le = {
      "method": "security/suspend",
      "client_id": client_id,
      "principal_id": principal_id,
      "agent_id": agent_id,
      "authz_decision": "deny",
      "authz_reason": "abuse_threshold_exceeded",
      "execution_outcome": "suspended",
      "error_code": -32001,
      "subject_type": "token",
      "subject_id": tid
    }
    assign audit = {
      "token_id": tid,
      "violations": count,
      "threshold": threshold,
      "window_seconds": cfg.defaults.abuse_window_seconds
    }
    assign le['audit_json'] = audit | json
    assign le['request_id'] = '' | uuid
    function _ = 'modules/mcp/commands/ledger/append', entry: le
    assign out['suspended'] = true
    assign _lm = principal_id | append: ' token ' | append: tid | append: ' suspended after ' | append: count | append: ' violations'
    log _lm, type: 'mcp.abuse_suspend'
  endif
  return out
%}
