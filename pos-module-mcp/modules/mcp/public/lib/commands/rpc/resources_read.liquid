{%- comment -%}
  MCP `resources/read` (spec §3.2, §13.1). Two sources, chosen by the URI
  (queries/resources/provided_uri):
  - a URI with a scheme other than `mcp+page:` is the app provider's: read for an
    authenticated caller through commands/resources/read_provided (suspension, rate
    limit, scope, ledger, the app's access rules); anonymous → not found;
  - otherwise it is a markdown doc page previously listed by resources/list.

  SECURITY (markdown pages): the toggle AND the prefix allowlist are RE-CHECKED here —
  a crafted uri must not read a page outside the configured doc prefixes (never trust
  the uri to scope access). Only markdown GET pages under an allowed prefix (path
  boundary) are readable — see queries/resources/page_allowed.

  @param {object} params   - MCP params with `uri` (mcp+page:///<slug> or a provider URI)
  @param {object} identity - the caller resolved by rpc/dispatch, or nil when anonymous
  @return {object} result { contents:[{uri,mimeType,text|blob}] } OR
                   { _error:{code,message,http_status?,headers?} } when unavailable/forbidden
{%- endcomment -%}
{% liquid
  function provided_uri = 'modules/mcp/queries/resources/provided_uri', uri: params.uri
  if provided_uri
    if identity.authenticated == true
      function provided = 'modules/mcp/commands/resources/read_provided', uri: params.uri, identity: identity
      return provided
    endif
    assign err = {
      "code": -32002,
      "message": "Resource not found"
    }
    assign out = { "_error": err }
    return out
  endif

  function cfg = 'modules/mcp/helpers/config'

  unless cfg.resources.expose_markdown_pages
    assign err = {
      "code": -32002,
      "message": "Resource not found"
    }
    assign out = { "_error": err }
    return out
  endunless

  assign uri = params.uri | default: ''
  assign slug = uri | remove_first: 'mcp+page:///' | strip

  graphql pres = 'modules/mcp/resources/page_by_slug', slug: slug
  assign page = pres.admin_pages.results.first

  # Re-check exposure against the resolved page (defense: do not trust uri) — the
  # same predicate resources/list applies: markdown + GET + prefix on a path boundary.
  function allowed = 'modules/mcp/queries/resources/page_allowed', page: page, prefixes: cfg.resources.markdown_page_prefixes
  unless allowed
    assign err = {
      "code": -32002,
      "message": "Resource not found"
    }
    assign out = { "_error": err }
    return out
  endunless

  # Serve ONLY the raw authored source (markdown for doc pages). We deliberately
  # do NOT fall back to page.html_content: that field is the converter's RENDERED
  # HTML (component <div>s, inline SVG, etc.), and returning it under a
  # text/markdown mimeType would both leak render artifacts and mislabel the
  # content type. platformOS already strips YAML frontmatter from `content` at
  # import (AppBuilder::Parsers::LiquidParser), so no frontmatter handling is
  # needed here. A doc page with empty source is not a valid markdown resource.
  assign text = page.content | strip
  if text == blank
    assign err = {
      "code": -32002,
      "message": "Resource not found"
    }
    assign out = { "_error": err }
    return out
  endif

  assign content = []
  assign item = {
    "uri": uri,
    "mimeType": "text/markdown",
    "text": text
  }
  assign content = content | array_add: item

  assign result = { "contents": content }
  return result
%}
