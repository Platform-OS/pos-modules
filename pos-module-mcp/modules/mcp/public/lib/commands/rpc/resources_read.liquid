{%- comment -%}
  MCP `resources/read` (spec §3.2, §13.1). Returns the markdown content of a doc
  page previously listed by resources/list.

  SECURITY: the toggle AND the prefix allowlist are RE-CHECKED here — a crafted uri
  must not read a page outside the configured doc prefixes (never trust the uri to
  scope access). Only markdown GET pages under an allowed prefix (path boundary)
  are readable — see queries/resources/page_allowed.

  @param {object} params - MCP params with `uri` = mcp+page:///<slug>
  @return {object} result { contents:[{uri,mimeType,text}] } OR
                   { _error:{code,message} } when unavailable/forbidden
{%- endcomment -%}
{% liquid
  function cfg = 'modules/mcp/commands/config'

  unless cfg.resources.expose_markdown_pages
    assign err = {}
    assign err['code'] = -32002
    assign err['message'] = 'Resource not found'
    assign out = {}
    assign out['_error'] = err
    return out
  endunless

  assign uri = params.uri | default: ''
  assign slug = uri | remove_first: 'mcp+page:///' | strip

  graphql pres = 'modules/mcp/resources/page_by_slug', slug: slug
  assign page = pres.admin_pages.results.first

  # Re-check exposure against the resolved page (defense: do not trust uri) — the
  # same predicate resources/list applies: markdown + GET + prefix on a path boundary.
  function allowed = 'modules/mcp/queries/resources/page_allowed', page: page, prefixes: cfg.resources.markdown_page_prefixes
  unless allowed
    assign err = {}
    assign err['code'] = -32002
    assign err['message'] = 'Resource not found'
    assign out = {}
    assign out['_error'] = err
    return out
  endunless

  # Serve ONLY the raw authored source (markdown for doc pages). We deliberately
  # do NOT fall back to page.html_content: that field is the converter's RENDERED
  # HTML (component <div>s, inline SVG, etc.), and returning it under a
  # text/markdown mimeType would both leak render artifacts and mislabel the
  # content type. platformOS already strips YAML frontmatter from `content` at
  # import (AppBuilder::Parsers::LiquidParser), so no frontmatter handling is
  # needed here. A doc page with empty source is not a valid markdown resource.
  assign text = page.content | strip
  if text == blank
    assign err = {}
    assign err['code'] = -32002
    assign err['message'] = 'Resource not found'
    assign out = {}
    assign out['_error'] = err
    return out
  endif

  assign content = []
  assign item = {}
  assign item['uri'] = uri
  assign item['mimeType'] = 'text/markdown'
  assign item['text'] = text
  assign content = content | array_add: item

  assign result = {}
  assign result['contents'] = content
  return result
%}
