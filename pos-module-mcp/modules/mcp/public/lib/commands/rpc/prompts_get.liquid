{%- comment -%}
  MCP `prompts/get` (spec §13.1). Resolves a prompt by name, checks required
  arguments are present, invokes the prompt's template partial with the arguments,
  and returns the rendered messages.

  The template partial receives `arguments` (a hash of arg name → string) and returns
  EITHER a plain string (wrapped as a single `user` text message) OR a ready messages
  array. The template is authored code (reviewed); arguments are the agent's own, and
  the server never acts on the rendered prompt — so there is no server-side injection
  surface here. The template also receives the caller (`principal`, `agent`, nil when
  anonymous) and `prompt`, the entry the prompts partial returned for this caller with every
  key it set, so one template can serve many prompts. A prompt the prompts partial does not
  offer to this caller is unknown.

  @param {object} params    - MCP params { name, arguments? }
  @param {object} principal - the caller's principal, or nil when anonymous
  @param {object} agent     - the caller's agent, or nil when anonymous
  @return {object} result { description, messages:[...] } OR { _error:{code,message} }
{%- endcomment -%}
{% liquid
  assign name = params.name
  assign args = params.arguments
  if args == blank
    assign args = {}
  endif

  function reg = 'modules/mcp/queries/registry/build_prompts', principal: principal, agent: agent
  assign prompt = null
  for p in reg.prompts
    if p.name == name
      assign prompt = p
      break
    endif
  endfor

  if prompt == blank
    assign err = {
      "code": -32602,
      "message": "Unknown prompt"
    }
    assign out = { "_error": err }
    return out
  endif

  # Required-argument presence check (safe to report — argument names are public).
  assign missing = []
  unless prompt.arguments == blank
    for a in prompt.arguments
      if a.required == true
        assign v = args[a.name]
        if v == blank
          assign missing = missing | array_add: a.name
        endif
      endif
    endfor
  endunless
  if missing.size > 0
    assign mj = missing | join: ', '
    assign err = { "code": -32602 }
    assign err['message'] = 'Missing required arguments: ' | append: mj
    assign out = { "_error": err }
    return out
  endif

  # Render the template. String → one user message; array → used as-is.
  function rendered = prompt.template, arguments: args, principal: principal, agent: agent, prompt: prompt
  assign messages = []
  assign rtype = rendered | type_of | downcase
  if rtype == 'array'
    assign messages = rendered
  else
    assign msg = { "role": "user" }
    assign content = { "type": "text" }
    assign content['text'] = rendered | append: ''
    assign msg['content'] = content
    assign messages = messages | array_add: msg
  endif

  assign result = {
    "description": prompt.description,
    "messages": messages
  }
  return result
%}
