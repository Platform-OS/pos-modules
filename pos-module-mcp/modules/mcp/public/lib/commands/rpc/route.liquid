{%- comment -%}
  JSON-RPC method routing (spec §13). Called by commands/rpc/dispatch after the
  transport, envelope, protocol era and request headers have been validated; routes
  the method to its rpc/* handler and wraps the result in a JSON-RPC envelope.

  Methods per era:
  - LEGACY (2025-06-18): initialize, ping, logging/setLevel, tools/*, resources/*,
    prompts/*.
  - MODERN (2026-07-28): server/discover, tools/*, resources/*, prompts/*, plus the
    Tasks extension (tasks/get, tasks/update, tasks/cancel) for a client that declares
    it. initialize, ping and logging/setLevel do not exist in this revision. An unknown
    method answers -32601 with 404 (modern, per the 2026-07-28 transport) or 200
    (legacy).

  HTTP STATUS. A method-level JSON-RPC error answers 200 so a 2025-06-18 client reads
  the typed error instead of a transport failure. The exceptions are spec-defined:
  401 for a missing or invalid bearer, and the modern-only 404 / 400 above and in
  commands/protocol.

  @param {string} method  - the request method (body, or legacy Mcp-Method header)
  @param {object} params  - context.params (the whole parsed JSON-RPC request)
  @param {object} headers - context.headers
  @param {string} id      - the request id, echoed verbatim
  @param {object} proto   - the result of helpers/protocol/negotiate
  @param {object} identity - the caller resolved by dispatch (commands/identity/resolve_principal,
                             authenticated), or nil when the request carried no bearer. A
                             request whose bearer did not resolve never reaches the router.
  @return {object} { http_status:int, headers?:object, body:object }
{%- endcomment -%}
{% liquid
  function cfg = 'modules/mcp/helpers/config'
  assign out = {}

  assign not_found_status = 200
  if proto.modern
    assign not_found_status = 404
    assign modern_methods = 'server/discover,tools/list,tools/call,resources/list,resources/templates/list,resources/read,prompts/list,prompts/get,tasks/get,tasks/update,tasks/cancel' | split: ','
    unless modern_methods contains method
      function body = 'modules/mcp/helpers/rpc/error', id: id, code: -32601, message: 'Method not found'
      assign out['http_status'] = not_found_status
      assign out['body'] = body
      return out
    endunless
  endif

  # ---- Authenticated methods return a full outcome (status/headers/body). ----
  if method == 'tools/call'
    function oc = 'modules/mcp/commands/rpc/tools_call', params: params, headers: headers, id: id, tasks_extension: proto.tasks_extension
    return oc
  endif

  # ---- Open result-style methods (wrapped in a success envelope). ----
  assign result = null
  assign handled = false
  case method
    when 'server/discover'
      if proto.modern
        function result = 'modules/mcp/commands/rpc/discover'
        assign handled = true
      endif
    when 'initialize'
      # Echo the NEGOTIATED legacy revision (not a hard pin).
      function result = 'modules/mcp/commands/rpc/initialize', protocol_version: proto.version, supported: proto.supported
      assign handled = true
    when 'ping'
      function result = 'modules/mcp/commands/rpc/ping'
      assign handled = true
    when 'tools/list'
      # Discovery stays OPEN for a caller without a bearer. A presented bearer was already
      # verified by dispatch (an invalid one answered 401 there). When tools_list_scope is
      # 'principal', the list is filtered to what this caller may call; a caller without a
      # bearer is 'anonymous' and is advertised nothing. 'open' lists every tool.
      assign tl_scope = cfg.tools_list_scope | default: 'open'
      # Cache hint (modern only): a principal-scoped list varies by identity, so it is
      # 'private'; an open list is identical for everyone → 'public'.
      assign tools_cache = null
      if proto.modern
        assign tcs = 'public'
        if tl_scope == 'principal'
          assign tcs = 'private'
        endif
        function tools_cache = 'modules/mcp/helpers/protocol/cache_hint', kind: 'tools', scope: tcs
      endif
      if tl_scope == 'principal'
        if identity.authenticated == true
          function result = 'modules/mcp/commands/rpc/tools_list', params: params.params, scope: 'principal', principal: identity.principal, agent: identity.agent, delegation_mode: identity.delegation_mode, cache: tools_cache
        else
          function result = 'modules/mcp/commands/rpc/tools_list', params: params.params, scope: 'anonymous', cache: tools_cache
        endif
      else
        function result = 'modules/mcp/commands/rpc/tools_list', params: params.params, cache: tools_cache
      endif
      assign handled = true
    when 'resources/list', 'resources/templates/list'
      # The app's resource provider answers for the caller, so a signed-in caller's lists
      # may differ per caller: 'private' whenever there is one, 'public' when anonymous.
      assign res_cache = null
      if proto.modern
        assign rcs = 'public'
        if identity.authenticated == true
          assign rcs = 'private'
        endif
        function res_cache = 'modules/mcp/helpers/protocol/cache_hint', kind: 'resources', scope: rcs
      endif
      if method == 'resources/list'
        function result = 'modules/mcp/commands/rpc/resources_list', params: params.params, cache: res_cache, principal: identity.principal, agent: identity.agent
      else
        function result = 'modules/mcp/commands/rpc/resources_templates_list', cache: res_cache, principal: identity.principal, agent: identity.agent
      endif
      assign handled = true
    when 'prompts/list'
      # The app's prompts partial receives the caller, so the list may differ per caller:
      # cache it 'private' whenever there is one, 'public' only for an anonymous request.
      assign pr_cache = null
      if proto.modern
        assign pcs = 'public'
        if identity.authenticated == true
          assign pcs = 'private'
        endif
        function pr_cache = 'modules/mcp/helpers/protocol/cache_hint', kind: 'prompts', scope: pcs
      endif
      function result = 'modules/mcp/commands/rpc/prompts_list', cache: pr_cache, principal: identity.principal, agent: identity.agent
      assign handled = true
    when 'logging/setLevel'
      # Legacy only (2026-07-28 replaced it with a per-request _meta log level). A VALID
      # level is an acknowledged no-op (empty result); an unknown/missing level is a
      # protocol error (-32602), never a silent success. Intentionally open (like
      # discovery); changes nothing.
      assign lvl = params.params.level
      assign valid_levels = 'debug,info,notice,warning,error,critical,alert,emergency' | split: ','
      assign lvl_ok = false
      if lvl != blank
        if valid_levels contains lvl
          assign lvl_ok = true
        endif
      endif
      if lvl_ok
        assign result = {}
        assign handled = true
      else
        function body = 'modules/mcp/helpers/rpc/error', id: id, code: -32602, message: 'Invalid params: unknown logging level'
        assign out['http_status'] = 200
        assign out['body'] = body
        return out
      endif
  endcase

  # Methods that return a result OR a structured _error (unknown resource/prompt).
  if method == 'resources/read'
    function rr = 'modules/mcp/commands/rpc/resources_read', params: params.params, identity: identity
    unless rr._error == blank
      # 2026-07-28 retired -32002 for an unknown resource; modern clients get -32602. A
      # refusal that carries its own HTTP status (rate limit, scope, suspension) keeps its
      # code: -32002 is also the rate-limit code.
      assign rr_code = rr._error.code
      if proto.modern and rr_code == -32002 and rr._error.http_status == blank
        assign rr_code = -32602
      endif
      function body = 'modules/mcp/helpers/rpc/error', id: id, code: rr_code, message: rr._error.message
      assign out['http_status'] = rr._error.http_status | default: 200
      unless rr._error.headers == blank
        assign out['headers'] = rr._error.headers
      endunless
      assign out['body'] = body
      return out
    endunless
    if proto.modern
      # A provider resource is the caller's own view of app data → 'private'.
      function provided_uri = 'modules/mcp/queries/resources/provided_uri', uri: params.params.uri
      assign rr_scope = 'public'
      if provided_uri
        assign rr_scope = 'private'
      endif
      function rc = 'modules/mcp/helpers/protocol/cache_hint', kind: 'resources', scope: rr_scope
      assign rr['ttlMs'] = rc.ttlMs
      assign rr['cacheScope'] = rc.cacheScope
    endif
    function body = 'modules/mcp/helpers/rpc/success', id: id, result: rr
    assign out['http_status'] = 200
    assign out['body'] = body
    return out
  endif

  if method == 'prompts/get'
    function pr = 'modules/mcp/commands/rpc/prompts_get', params: params.params, principal: identity.principal, agent: identity.agent
    unless pr._error == blank
      function body = 'modules/mcp/helpers/rpc/error', id: id, code: pr._error.code, message: pr._error.message
      assign out['http_status'] = 200
      assign out['body'] = body
      return out
    endunless
    function body = 'modules/mcp/helpers/rpc/success', id: id, result: pr
    assign out['http_status'] = 200
    assign out['body'] = body
    return out
  endif

  # ---- Tasks extension (modern only): an approval-gated tools/call is a task, polled
  #      with tasks/get and withdrawn with tasks/cancel. The extension must be declared
  #      on the request (400, -32021 otherwise); a legacy client uses the built-in
  #      mcp_approval_status tool instead. All three are self-scoped + authenticated. ----
  if proto.modern
    if method == 'tasks/get' or method == 'tasks/update' or method == 'tasks/cancel'
      unless proto.tasks_extension
        assign required_extensions = { "io.modelcontextprotocol/tasks": {} }
        assign required_capabilities = { "extensions": required_extensions }
        assign missing_data = { "requiredCapabilities": required_capabilities }
        function body = 'modules/mcp/helpers/rpc/error', id: id, code: -32021, message: 'Missing required client capability', data: missing_data
        assign out['http_status'] = 400
        assign out['body'] = body
        return out
      endunless

      assign tr = null
      if method == 'tasks/get'
        function tr = 'modules/mcp/commands/rpc/tasks_get', params: params.params, headers: headers
      elsif method == 'tasks/update'
        function tr = 'modules/mcp/commands/rpc/tasks_update', params: params.params, headers: headers
      else
        function tr = 'modules/mcp/commands/rpc/tasks_cancel', params: params.params, headers: headers
      endif
      unless tr._error == blank
        assign est = 200
        if tr._error.code == -32001
          assign est = 401
        endif
        function body = 'modules/mcp/helpers/rpc/error', id: id, code: tr._error.code, message: tr._error.message
        assign out['http_status'] = est
        assign out['body'] = body
        return out
      endunless
      function body = 'modules/mcp/helpers/rpc/success', id: id, result: tr
      assign out['http_status'] = 200
      assign out['body'] = body
      return out
    endif
  endif

  if handled
    function body = 'modules/mcp/helpers/rpc/success', id: id, result: result
    assign out['http_status'] = 200
    assign out['body'] = body
    return out
  endif

  # ---- Unknown / not-yet-implemented method (§13.2). ----
  function body = 'modules/mcp/helpers/rpc/error', id: id, code: -32601, message: 'Method not found'
  assign out['http_status'] = not_found_status
  assign out['body'] = body
  return out
%}
