{%- comment -%}
  MCP `tasks/cancel` (Tasks extension, "Task Cancellation"). The requester withdraws
  its own approval-gated action. A PENDING approval moves to cancelled under the row
  lock (approval/claim), so it can no longer be approved and its queue slot is freed.
  Cancellation is cooperative: an approval an operator already decided, or that is
  already running, keeps its outcome; the request is still acknowledged with an empty
  result. Self-scoped (tasks/find_owned).

  @param {object} params  - { taskId }
  @param {object} headers - context.headers (bearer identity)
  @return {object} {} | { _error:{code,message} }
{%- endcomment -%}
{% liquid
  function found = 'modules/mcp/commands/tasks/find_owned', params: params, headers: headers
  unless found._error == blank
    return found
  endunless

  assign rec = found.rec
  if rec.status == 'pending'
    function _claim = 'modules/mcp/commands/approval/claim', id: rec.id, handle: rec.handle, status: 'cancelled', decided_by: 'agent:self', result_summary: 'Cancelled by requester'
  endif

  assign ack = {}
  return ack
%}
