{%- comment -%}
  MCP `resources/list` (spec §3.2, §13.1). Zero-config: exposes markdown/doc pages
  as agent-readable resources with NO custom authoring. Gated by config:
  resources.expose_markdown_pages must be true (OFF by default), and only pages
  whose slug starts with a configured prefix (allowlist) are listed — so no page is
  agent-visible unless the operator opts in. Freshness-stamped via content_updated_at.

  Open discovery (no auth), like tools/list. The engine's own pages (mcp,
  well-known) never match the doc prefixes, so they are never exposed.

  @param {object} params - MCP params (unused; pagination could be added)
  @return {object} { resources:[{uri,name,description,mimeType,_meta}] }
{%- endcomment -%}
{% liquid
  function cfg = 'modules/mcp/commands/config'
  assign resources = []

  if cfg.resources.expose_markdown_pages
    assign host = context.location.host
    for prefix in cfg.resources.markdown_page_prefixes
      # One query per operator-configured slug prefix (a small allowlist, default 1) —
      # the prefixes are distinct filters, not a per-row N+1.
      # platformos-check-disable NestedGraphQLQuery
      graphql pres = 'modules/mcp/resources/pages_by_prefix', prefix: prefix, per_page: 100
      # platformos-check-enable NestedGraphQLQuery
      for page in pres.admin_pages.results
        assign r = {}
        assign r['uri'] = 'mcp+page:///' | append: page.slug
        assign r['name'] = page.slug
        assign title = page.metadata.title | default: page.slug
        assign r['title'] = title
        assign desc = page.metadata.description | default: ''
        unless desc == blank
          assign r['description'] = desc
        endunless
        assign r['mimeType'] = 'text/markdown'
        assign meta = {}
        assign meta['updated_at'] = page.content_updated_at
        assign meta['public_url'] = 'https://' | append: host | append: '/' | append: page.slug
        assign r['_meta'] = meta
        assign resources = resources | array_add: r
      endfor
    endfor
  endif

  assign result = {}
  assign result['resources'] = resources
  # Client-side cache hint (2026-07-28 only; dispatch passes it or nil).
  unless cache == blank
    assign result['ttlMs'] = cache.ttlMs
    assign result['cacheScope'] = cache.cacheScope
  endunless
  return result
%}
