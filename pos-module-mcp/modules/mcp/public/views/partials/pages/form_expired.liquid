{%- comment -%}
  Shown by the console POST pages (/mcp-tools/*, /mcp-admin/*) when the form token is
  missing or invalid: the request changed nothing. The consoles render without a layout,
  so this is a complete, self-contained document in the consoles' dark theme.

  @param {string} return_path - the console page that holds the form, e.g. /mcp-tools
{%- endcomment -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark light">
<title>Form expired</title>
<style>
  :root { color-scheme: dark; --bg: #14152E; --text: #ebdbb2; --muted: #a89984; --accent: #83a598;
          --mono: ui-monospace, "JetBrains Mono", "SFMono-Regular", Menlo, Consolas, monospace; }
  html, body { background: var(--bg); }
  body { font-family: var(--mono); color: var(--muted); line-height: 1.55; margin: 0; }
  .wrap { max-width: 34rem; margin: 3rem auto; padding: 0 1rem; }
  h1 { font-size: 1.25rem; color: var(--text); margin: 0 0 .5rem; }
  a { color: var(--accent); }
</style>
</head>
<body>
<div class="wrap">
  <h1>This form has expired</h1>
  <p>Nothing was changed. Open the page again and repeat the action.</p>
  <p><a href="{{ return_path }}">Back to the page</a></p>
</div>
</body>
</html>
