<style>
  /* Gruvbox-dark TUI — matches /mcp-tools and the operator console. */
  :root {
    color-scheme: dark;
    --bg: #14152E; --bg-2: #0d0e1f; --panel: #2b2838; --border: #4c4560;
    --text: #ebdbb2; --muted: #a89984; --dim: #928374; --accent: #83a598;
    --ok: #b8bb26; --bad: #fb4934; --warn: #fabd2f; --warn-bg: #3d3420;
    --mono: ui-monospace, "JetBrains Mono", "SFMono-Regular", "Cascadia Code", Menlo, Consolas, "Liberation Mono", monospace;
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); }
  body { font-family: var(--mono); margin: 0; background: var(--bg); color: var(--muted); line-height: 1.55; }
  .wrap { max-width: 34rem; margin: 0 auto; padding: 2rem 1rem 4rem; }
  .card { background: var(--panel); border: 1px solid var(--border); padding: 1.25rem; }
  h1 { font-size: 1.15rem; color: var(--text); margin: 0 0 1rem; }
  b, strong { color: var(--text); }
  code { background: var(--bg-2); padding: .1rem .3rem; word-break: break-all; }
  ul.scopes { list-style: none; padding: 0; margin: 1rem 0; }
  ul.scopes li { border-left: 2px solid var(--accent); padding: .25rem .75rem; margin: .5rem 0; }
  .note { color: var(--dim); font-size: .85rem; }
  .warn { background: var(--warn-bg); color: var(--warn); padding: .5rem .75rem; font-size: .85rem; margin: 1rem 0; }
  .err { color: var(--bad); }
  .actions { display: flex; gap: .75rem; margin-top: 1.25rem; flex-wrap: wrap; }
  .btn { font-family: var(--mono); font-size: .95rem; padding: .55rem 1.1rem; border: 1px solid var(--border); background: var(--bg-2); color: var(--text); cursor: pointer; }
  .btn-primary { background: var(--accent); color: var(--bg-2); border-color: var(--accent); font-weight: 600; }
  .btn:focus-visible { outline: 2px solid var(--warn); outline-offset: 2px; }
</style>
