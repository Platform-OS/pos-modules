---
slug: mcp-admin/approve
method: post
layout: ''
---
{%- comment -%}
  Operator approves a pending action (spec §9.6). Executes it as the ORIGINAL
  principal (never the operator), records the outcome on the approval row, and
  returns to the console. Operator-gated; ownership of the decision is audited: the
  ledger entry approval/execute writes names the operator (authz_reason
  approved_by:<user id>), including when the action is refused at execution time. A
  request past its window is marked expired instead (approval/claim) and attested. A POST
  without a valid form token changes nothing (403).
{%- endcomment -%}
{%- liquid
  unless context.csrf_request_valid
    response_status 403
    render 'modules/mcp/pages/form_expired', return_path: '/mcp-admin'
    break
  endunless

  function current_profile = 'modules/user/helpers/current_profile'
  # platformos-check-disable UnreachableCode
  # platformos-check-disable DeprecatedTag
  include 'modules/user/helpers/can_do_or_unauthorized', requester: current_profile, do: 'mcp.admin', redirect_anonymous_to_login: true, forbidden_partial: null, access_callback: null, anonymous_return_to: '/mcp-admin', entity: null
  # platformos-check-enable DeprecatedTag
  # platformos-check-enable UnreachableCode

  assign handle = context.params.handle
  graphql f = 'modules/mcp/approvals/find_by_handle', handle: handle
  assign rec = f.records.results.first
  if rec and rec.status == 'pending'
    # Claim first (pending → approved under a row lock) so a double-click or two
    # operators approving at once execute the action exactly once. The claim also
    # decides expiry under that lock: a row past its window ends `expired` (and is
    # attested as such), and nothing runs.
    function claim = 'modules/mcp/commands/approval/claim', id: rec.id, handle: handle, status: 'approved', decided_by: current_profile.user.id, result_summary: 'Approved; executing.', ledger_reason: null
    if claim.claimed and claim.status == 'approved'
      function res = 'modules/mcp/commands/approval/execute', approval: claim.rec, decided_by: current_profile.user.id
      assign decided_at = 'now' | to_time | strftime: '%Y-%m-%dT%H:%M:%SZ'
      assign result_json = null
      unless res.result == blank
        assign result_json = res.result | json
      endunless
      assign error_json = null
      unless res.error == blank
        assign error_json = res.error | json
      endunless
      graphql _ = 'modules/mcp/approvals/record_outcome', id: rec.id, status: res.outcome, decided_by: current_profile.user.id, decided_at: decided_at, result_summary: res.summary, result_json: result_json, error_json: error_json
    endif
  endif

  redirect_to '/mcp-admin?tab=approvals'
-%}
