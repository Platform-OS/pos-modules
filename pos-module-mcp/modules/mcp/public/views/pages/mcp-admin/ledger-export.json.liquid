---
slug: mcp-admin/ledger-export
format: json
---
{%- comment -%}
  Operator ledger export (spec §17 retention: export-then-purge). Streams the CURRENT
  filtered ledger view as JSON so an operator can archive before a purge cycle. Honors
  the same filter params as the console (tool_name, principal_id, client_id,
  authz_decision, execution_outcome). Operator-gated (403 JSON otherwise). Bounded by
  export_cap with an explicit `capped` flag — a silent truncation would read as a
  complete archive when it is not. Read-only: never mutates the chain.
{%- endcomment -%}
{%- liquid
  function is_admin = 'modules/mcp/commands/is_operator'
  unless is_admin
    response_status 403
    echo '{"error":"forbidden"}'
    return
  endunless

  assign export_cap = 5000
  assign per_page = 100
  assign out_rows = '[]' | parse_json
  assign page = 1
  assign keep_going = true
  assign total_pages = 1

  for i in (1..50)
    unless keep_going
      break
    endunless
    # Bounded pagination (max 50 pages, capped by export_cap) to stream the export —
    # one query per page is intended, not a per-row N+1.
    # platformos-check-disable NestedGraphQLQuery
    graphql s = 'modules/mcp/ledger/search', tool_name: context.params.tool_name, principal_id: context.params.principal_id, client_id: context.params.client_id, authz_decision: context.params.authz_decision, execution_outcome: context.params.execution_outcome, page: page, per_page: per_page
    # platformos-check-enable NestedGraphQLQuery
    assign total_pages = s.records.total_pages
    for r in s.records.results
      assign out_rows = out_rows | array_add: r
    endfor
    assign fetched = out_rows | size
    if page >= total_pages or fetched >= export_cap
      assign keep_going = false
    endif
    assign page = page | plus: 1
  endfor

  assign nrows = out_rows | size
  assign payload = '{}' | parse_json
  hash_assign payload['exported_at'] = 'now' | to_time | strftime: '%Y-%m-%dT%H:%M:%SZ'
  hash_assign payload['count'] = nrows
  assign was_capped = false
  if nrows >= export_cap
    assign was_capped = true
  endif
  hash_assign payload['capped'] = was_capped
  assign filt = '{}' | parse_json
  hash_assign filt['tool_name'] = context.params.tool_name
  hash_assign filt['principal_id'] = context.params.principal_id
  hash_assign filt['client_id'] = context.params.client_id
  hash_assign filt['authz_decision'] = context.params.authz_decision
  hash_assign filt['execution_outcome'] = context.params.execution_outcome
  hash_assign payload['filter'] = filt
  hash_assign payload['rows'] = out_rows
  echo payload | json
-%}
