{%- comment -%}
  Operator-triggered eval run (spec §19.3). Runs the deterministic tool-surface +
  golden-case checks, stores an mcp_eval_run record, and returns to the console.
  Operator-gated. Can also be driven by CI (the runner logs in and posts here, then
  reads the result via GraphQL). For scheduled runs, wrap eval/run in a background job.
{%- endcomment -%}
{%- liquid
  function current_profile = 'modules/user/helpers/current_profile'
  # platformos-check-disable UnreachableCode
  # platformos-check-disable DeprecatedTag
  include 'modules/user/helpers/can_do_or_unauthorized', requester: current_profile, do: 'mcp.admin', redirect_anonymous_to_login: true, forbidden_partial: null, access_callback: null, anonymous_return_to: '/mcp-admin', entity: null
  # platformos-check-enable DeprecatedTag
  # platformos-check-enable UnreachableCode
  function _ = 'modules/mcp/commands/eval/run'
  redirect_to '/mcp-admin'
-%}
