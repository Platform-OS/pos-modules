---
slug: oauth/authorize
method: post
---
{%- comment -%}
  Consent decision (POST /oauth/authorize). CSRF: a POST without a valid
  authenticity_token is refused with the error page and never redirects to the client
  (the platform would also run it with a NULL session, so it has no user and no parked
  request). The request being approved is the one parked in the session by the GET
  (matched by rid) — never form input.
{%- endcomment -%}
{%- liquid
  response_headers '{"Cache-Control": "no-store", "Pragma": "no-cache"}'
  function cfg = 'modules/mcp/helpers/config'
  function origin = 'modules/mcp/queries/origin'
  assign raw_req = context.session.mcp_oauth_req
  session mcp_oauth_req = null

  assign req = null
  unless raw_req == blank
    assign req = raw_req | parse_json: raw_text: true
  endunless
  if context.csrf_request_valid != true or req == blank or req.rid != context.params.rid or cfg.oauth.builtin != true
    response_status 400
    echo 'This authorization request has expired. Return to your MCP client and reconnect.'
  else
    assign p = {
      "state": req.state,
      "iss": origin
    }

    function current_profile = 'modules/user/helpers/current_profile'
    assign allowed = false
    unless current_profile.user == blank
      function allowed = 'modules/user/helpers/can_do', requester: current_profile, do: cfg.oauth.required_permission, entity: null, access_callback: null
    endunless

    if allowed and context.params.decision == 'approve'
      function url = 'modules/mcp/commands/oauth/issue_code', req: req, user_id: current_profile.user.id
    else
      assign p['error'] = 'access_denied'
      assign p['error_description'] = 'The user denied the request'
      function url = 'modules/mcp/helpers/oauth/append_params', url: req.redirect_uri, params: p
    endif
    redirect_to url
  endif
-%}
