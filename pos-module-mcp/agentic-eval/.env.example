# Agentic-eval local settings — copy to `.env` and fill in. `.env` is gitignored.
#
# Two planes, deliberately separated:
#   * Admin plane  — the runner (run.mjs) uses this to seed a scoped eval principal
#                    and to read the ledger / instance state for grading.
#   * Agent plane  — opencode.json wires these into the `pos-module-mcp` remote MCP
#                    server. The agent under test sees ONLY this scoped surface.

# --- Admin plane (runner only; NEVER exposed to the agent) ---
MCP_URL=https://<instance>.ps-01-platformos.com/
MCP_TOKEN=<admin-api-token>

# --- Agent plane (opencode.json -> pos-module-mcp remote server) ---
# The runner mints a FRESH scoped-principal token per task and exports MCP_EVAL_TOKEN
# before driving opencode. Set MCP_EVAL_TOKEN here only for a manual smoke run.
MCP_EVAL_URL=https://<instance>.ps-01-platformos.com/mcp
MCP_EVAL_TOKEN=

# --- Model provider ---
# opencode reads provider creds from env (or its own OAuth plugins). Set whichever
# provider `model` in opencode.json points at, e.g.:
# OPENAI_API_KEY=
