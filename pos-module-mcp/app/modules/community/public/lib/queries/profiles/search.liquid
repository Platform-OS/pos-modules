{% comment %}
  Override of modules/community/queries/profiles/search for the MCP test harness.

  The community module expects profile records with a nested `properties` hash and a
  user-module profiles/search query that filters by roles and loads avatars, users and
  covers; the full community app gets both from its own app/modules/user overrides. This
  harness runs the stock user module, whose profiles/search returns the fields at the top
  level and declares none of those variables. So this version passes only the variables
  the stock query declares and adds the slug at the top level; `roles`, `with_avatar`,
  `with_user` and `with_profile_cover` are accepted from the community callers and ignored.
{% endcomment %}
{% liquid
  if not_ids == blank
    assign not_ids = null
  endif

  graphql r = 'modules/user/profiles/search', limit: limit, uuid: uuid, id: id, ids: ids, user_id: user_id, not_ids: not_ids, query: query, sort: sort, page: page

  assign records = r.records
  assign profiles = []
  for profile in records.results
    function slug = 'modules/user/helpers/profiles/slugs/build', profile: profile, current_profile: null
    assign p = profile
    assign p['slug'] = slug
    assign profiles << p
  endfor
  assign records['results'] = profiles

  # platformos-check-disable UnreachableCode
  # platformos-check-disable DeprecatedTag
  include 'modules/community/helpers/handle_graphql_response', r: r, name: 'queries/profiles/search'
  # platformos-check-enable DeprecatedTag
  # platformos-check-enable UnreachableCode
  return r.records
%}
