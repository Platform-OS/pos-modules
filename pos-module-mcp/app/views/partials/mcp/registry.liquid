{%- comment -%}
  Layer-2 tool registry (app-owned; spec §8.2) — the EXPLICIT registration list
  for this instance's MCP tools. Returns an array of { name, path } entries. Each
  `path` points at a tool directory under app/views/partials/mcp/tools/<name>/
  containing `manifest` (the declaration) and `call` (the handler), co-located per
  spec §5.2. A tool exists to agents ONLY if it appears here — dropping a tool
  directory is not enough, registration is a deliberate, reviewed one-line edit
  (the tool-poisoning mitigation as a structural property, §4.2).

  The engine loads each entry's manifest, validates it against the meta-schema,
  and serves only the valid ones; the registered `name` must match the manifest's
  own name (identity guard).
{%- endcomment -%}
{% liquid
  assign tools = '[]' | parse_json

  assign e1 = '{}' | parse_json
  hash_assign e1['name'] = 'search_events'
  hash_assign e1['path'] = 'mcp/tools/search_events'
  assign tools = tools | array_add: e1

  assign e2 = '{}' | parse_json
  hash_assign e2['name'] = 'create_event'
  hash_assign e2['path'] = 'mcp/tools/create_event'
  assign tools = tools | array_add: e2

  assign e3 = '{}' | parse_json
  hash_assign e3['name'] = 'broadcast_event'
  hash_assign e3['path'] = 'mcp/tools/broadcast_event'
  assign tools = tools | array_add: e3

  # ── TEST FIXTURES (gated) ──────────────────────────────────────────────────────
  # Registered ONLY when the MCP_ENABLE_TEST_TOOLS constant is '1'/'true' (CI + eval
  # hosts). A normal production deploy leaves the constant unset, so these are never
  # served — zero production surface. They are community-free and write only to the
  # host test_note table. They give the coverage suite deterministic surfaces for
  # every governance plane: visibility tiers (public/member/admin), validation/rate
  # (echo), transaction commit + idempotency (write), rollback (fail), and the
  # human-in-the-loop gate (approve).
  assign test_gate = context.constants.MCP_ENABLE_TEST_TOOLS | default: ''
  if test_gate == '1' or test_gate == 'true'
    assign test_names = 'test_public,test_member,test_admin,test_echo,test_write,test_fail,test_approve,test_validate' | split: ','
    for tn in test_names
      assign te = '{}' | parse_json
      hash_assign te['name'] = tn
      assign tp = 'mcp/tools/' | append: tn
      hash_assign te['path'] = tp
      assign tools = tools | array_add: te
    endfor
  endif

  # ── NEGATIVE-CONTROL VULNERABLE FIXTURES (gated; task-6) ────────────────────────
  # Registered ONLY when MCP_ENABLE_VULN_TOOLS is '1'/'true'. These are DELIBERATELY
  # INSECURE tools, each breaking one governance control (privilege escalation, IDOR,
  # stored XSS, secret leak), used by agentic-eval to prove the harness + graders + agent
  # actually DETECT a real vulnerability (not just confirm defenses). NEVER enable in
  # production — a plain deploy leaves the constant unset, so they are never served.
  assign vuln_gate = context.constants.MCP_ENABLE_VULN_TOOLS | default: ''
  if vuln_gate == '1' or vuln_gate == 'true'
    assign vuln_names = 'vuln_privesc,vuln_idor,vuln_xss,vuln_secret,vuln_delete_all,vuln_delete_all_confirm' | split: ','
    for vn in vuln_names
      assign ve = '{}' | parse_json
      hash_assign ve['name'] = vn
      assign vp = 'mcp/tools/' | append: vn
      hash_assign ve['path'] = vp
      assign tools = tools | array_add: ve
    endfor
  endif

  return tools
%}
