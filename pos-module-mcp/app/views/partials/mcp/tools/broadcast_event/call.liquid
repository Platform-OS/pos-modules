{%- comment -%}
  Handler — broadcast_event (COMMAND MODE; runs only on operator approval, as the
  requesting member, inside the engine transaction). Wraps the community
  events/create command so a broadcast is a real, moderated community event with the
  same validations, relationships, and feed event as a UI-created one.
{%- endcomment -%}
{% liquid
  function profile = 'modules/community/queries/profiles/find', user_id: principal.user_id, uuid: null, id: null, slug: null, anonymous_session_id: null, relationships: null
  if profile == blank
    assign err = '{}' | parse_json
    hash_assign err['code'] = 403
    hash_assign err['message'] = 'No community profile for the calling user.'
    hash_assign err['retryable'] = false
    assign out = '{}' | parse_json
    hash_assign out['ok'] = false
    hash_assign out['error'] = err
    return out
  endif

  assign obj = '{}' | parse_json
  hash_assign obj['uuid'] = '' | uuid
  hash_assign obj['name'] = arguments.name
  hash_assign obj['short_description'] = 'Community broadcast'
  hash_assign obj['description'] = arguments.description
  hash_assign obj['start_date'] = arguments.start_date
  hash_assign obj['end_date'] = arguments.start_date
  hash_assign obj['venue'] = arguments.venue

  function object = 'modules/community/commands/events/create', object: obj, profile: profile

  unless object.valid
    assign err = '{}' | parse_json
    hash_assign err['code'] = 422
    hash_assign err['message'] = 'The broadcast is not valid.'
    hash_assign err['retryable'] = false
    hash_assign err['fields'] = object.errors
    assign out = '{}' | parse_json
    hash_assign out['ok'] = false
    hash_assign out['error'] = err
    return out
  endunless

  assign now = 'now' | to_time
  function _ = 'modules/community/commands/relationships/create', name: 'owner', l_id: profile.id, r_id: object.id, created_by_id: profile.id, l_at: now, r_at: now
  function _ = 'modules/community/commands/relationships/create', name: 'event:going', l_id: profile.id, r_id: object.id, created_by_id: profile.id, l_at: now, r_at: now
  assign event_payload = null | hash_merge: actor_id: profile.id, object_id: object.id
  function _ = 'modules/core/commands/events/publish', type: 'event_created', object: event_payload, delay: 0, max_attempts: null

  assign result = '{}' | parse_json
  hash_assign result['id'] = object.id
  hash_assign result['name'] = arguments.name
  hash_assign result['status'] = object.status | default: 'pending'
  assign subject = '{}' | parse_json
  hash_assign subject['type'] = 'record'
  hash_assign subject['id'] = object.id
  assign out = '{}' | parse_json
  hash_assign out['ok'] = true
  hash_assign out['result'] = result
  hash_assign out['subject'] = subject
  return out
%}
