{%- comment -%}
  Tool manifest — test_validate (TEST FIXTURE, app-owned; gated by MCP_ENABLE_TEST_TOOLS).
  Read-only, public_read. Carries a deliberately rich input_schema so the coverage suite
  can exercise the WHOLE validation matrix: enum, integer min/max, number exclusiveMinimum,
  `format` (email/uuid/date-time), array items/minItems/maxItems, string minLength/maxLength/
  pattern, and additionalProperties:false. A violation of any of these must be rejected with
  -32602 (strict, no coercion) — so a validator that silently no-ops fails a test.
{%- endcomment -%}
{% liquid
  assign m = '{}' | parse_json
  hash_assign m['name'] = 'test_validate'
  hash_assign m['version'] = '1.0.0'
  hash_assign m['description'] = 'TEST FIXTURE (not a production tool): rich input schema to exercise the full validation matrix.'
  assign schema = '{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"type":"string","enum":["alpha","beta","gamma"]},"count":{"type":"integer","minimum":1,"maximum":10},"ratio":{"type":"number","exclusiveMinimum":0,"maximum":1},"email":{"type":"string","format":"email","maxLength":254},"uid":{"type":"string","format":"uuid","maxLength":36},"when":{"type":"string","format":"date-time","maxLength":40},"tags":{"type":"array","items":{"type":"string","maxLength":30},"minItems":1,"maxItems":3},"code":{"type":"string","minLength":2,"maxLength":4,"pattern":"^[a-z]+$"}}}' | parse_json
  hash_assign m['input_schema'] = schema
  hash_assign m['mutating'] = false
  hash_assign m['authorization_policy'] = 'public_read'
  hash_assign m['requires_approval'] = false
  hash_assign m['idempotent'] = false
  hash_assign m['handler'] = 'mcp/tools/test_validate/call'
  return m
%}
