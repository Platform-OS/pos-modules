{%- comment -%}
  Handler — create_event (COMMAND MODE; handler contract §7.3). Wraps the community
  module's OWN command `modules/community/commands/events/create` instead of a raw
  record_create — so an agent-created event is IDENTICAL to a UI-created one: it runs
  the same build→check validations, lands in the moderation queue (status: pending),
  and is wired with the owner / event:going relationships + the event_created feed
  event. Runs inside the engine transaction (mutating), as the calling principal.

  Arguments are passed as typed values into the command's object; the command owns
  all GraphQL. The command's {valid, errors} contract maps to the handler contract,
  so field-level validation errors flow back to the agent for self-correction.
{%- endcomment -%}
{% liquid
  # Resolve the community profile for the calling principal (the command acts as it).
  function profile = 'modules/community/queries/profiles/find', user_id: principal.user_id, uuid: null, id: null, slug: null, anonymous_session_id: null, relationships: null
  if profile == blank
    assign err = {}
    assign err['code'] = 403
    assign err['message'] = 'No community profile for the calling user.'
    assign err['retryable'] = false
    assign out = {}
    assign out['ok'] = false
    assign out['error'] = err
    return out
  endif

  # Build the command input object from validated arguments. end_date defaults to
  # start_date (community listings filter end_date >= now); uuid is generated.
  assign obj = {}
  assign obj['uuid'] = '' | uuid
  assign obj['name'] = arguments.name
  assign obj['short_description'] = arguments.short_description
  assign obj['description'] = arguments.description
  assign obj['start_date'] = arguments.start_date
  assign obj['end_date'] = arguments.end_date | default: arguments.start_date
  assign obj['venue'] = arguments.venue
  assign obj['link'] = arguments.link

  # Invoke the community command (build → check → execute).
  function object = 'modules/community/commands/events/create', object: obj, profile: profile

  unless object.valid
    assign err = {}
    assign err['code'] = 422
    assign err['message'] = 'The event is not valid.'
    assign err['retryable'] = false
    assign err['fields'] = object.errors
    assign out = {}
    assign out['ok'] = false
    assign out['error'] = err
    return out
  endunless

  # Wire the same side-effects the community UI does: owner + event:going
  # relationships and the event_created feed event.
  assign now = 'now' | to_time
  function _ = 'modules/community/commands/relationships/create', name: 'owner', l_id: profile.id, r_id: object.id, created_by_id: profile.id, l_at: now, r_at: now
  function _ = 'modules/community/commands/relationships/create', name: 'event:going', l_id: profile.id, r_id: object.id, created_by_id: profile.id, l_at: now, r_at: now
  assign event_payload = null | hash_merge: actor_id: profile.id, object_id: object.id
  function _ = 'modules/core/commands/events/publish', type: 'event_created', object: event_payload, delay: 0, max_attempts: null

  assign result = {}
  assign result['id'] = object.id
  assign result['name'] = arguments.name
  assign result['status'] = object.status | default: 'pending'
  assign url = '/events/' | append: object.id
  assign result['url'] = url

  assign subject = {}
  assign subject['type'] = 'record'
  assign subject['id'] = object.id

  assign out = {}
  assign out['ok'] = true
  assign out['result'] = result
  assign out['subject'] = subject
  return out
%}
