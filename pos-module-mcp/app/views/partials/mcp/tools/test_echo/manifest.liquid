{%- comment -%}
  Tool manifest — test_echo (TEST FIXTURE, app-owned; gated by MCP_ENABLE_TEST_TOOLS).
  Read-only, public_read. Non-mutating workhorse for the plane tests that don't need a
  side effect: strict argument validation (type/required/additionalProperties/maxLength),
  rate limiting, abuse counting, and ledger attestation. Echoes its input back.
{%- endcomment -%}
{% liquid
  assign m = {}
  assign m['name'] = 'test_echo'
  assign m['version'] = '1.0.0'
  assign m['description'] = 'TEST FIXTURE (not a production tool): echoes the given message. Used to exercise validation, rate limiting and attestation.'
  assign schema = {"type":"object","additionalProperties":false,"required":["message"],"properties":{"message":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[^<>]*$","description":"text to echo back"}}}
  assign m['input_schema'] = schema
  assign m['mutating'] = false
  assign m['authorization_policy'] = 'public_read'
  assign m['requires_approval'] = false
  assign m['idempotent'] = false
  assign m['handler'] = 'mcp/tools/test_echo/call'
  return m
%}
