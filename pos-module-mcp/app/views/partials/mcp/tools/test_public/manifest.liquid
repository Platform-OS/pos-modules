{%- comment -%}
  Tool manifest — test_public (TEST FIXTURE, app-owned). Registered ONLY when the
  MCP_ENABLE_TEST_TOOLS constant is set (see registry). Visibility probe for the
  PUBLIC tier: policy public_read → any authenticated principal. The coverage suite
  asserts it is listable/callable by operator, member AND outsider, but never anon.
{%- endcomment -%}
{% liquid
  assign m = '{}' | parse_json
  hash_assign m['name'] = 'test_public'
  hash_assign m['version'] = '1.0.0'
  hash_assign m['description'] = 'TEST FIXTURE (not a production tool): public-tier visibility probe; returns a constant marker.'
  assign schema = '{"type":"object","additionalProperties":false,"properties":{}}' | parse_json
  hash_assign m['input_schema'] = schema
  hash_assign m['mutating'] = false
  hash_assign m['authorization_policy'] = 'public_read'
  hash_assign m['requires_approval'] = false
  hash_assign m['idempotent'] = false
  hash_assign m['handler'] = 'mcp/tools/test_public/call'
  return m
%}
