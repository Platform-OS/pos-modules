{%- comment -%}
  Handler — test_public (TEST FIXTURE). Read-only. Returns a constant tier marker +
  the resolved principal id so the coverage suite can assert who reached it.
{%- endcomment -%}
{% liquid
  assign result = '{}' | parse_json
  hash_assign result['tier'] = 'public'
  hash_assign result['principal'] = principal.id
  assign out = '{}' | parse_json
  hash_assign out['ok'] = true
  hash_assign out['result'] = result
  return out
%}
