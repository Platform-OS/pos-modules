{%- comment -%}
  Tool manifest — test_write (TEST FIXTURE, app-owned; gated by MCP_ENABLE_TEST_TOOLS).
  MUTATING + IDEMPOTENT, policy test_principal_member. Writes one test_note row owned
  by the calling principal. Exercises: transaction COMMIT (row persists), idempotency
  (same key → exactly one row + replayed result; same key + different args → 409), and
  attestation of a successful mutation.
{%- endcomment -%}
{% liquid
  assign m = {}
  assign m['name'] = 'test_write'
  assign m['version'] = '1.0.0'
  assign m['description'] = 'TEST FIXTURE (not a production tool): writes a test_note row owned by the caller.'
  assign schema = {"type":"object","additionalProperties":false,"required":["label"],"properties":{"label":{"type":"string","minLength":1,"maxLength":100,"pattern":"^[^<>]*$","description":"label stored on the row"}}}
  assign m['input_schema'] = schema
  assign m['mutating'] = true
  assign m['authorization_policy'] = 'test_principal_member'
  assign m['requires_approval'] = false
  assign m['idempotent'] = true
  assign m['handler'] = 'mcp/tools/test_write/call'
  return m
%}
