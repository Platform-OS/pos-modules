{%- comment -%}
  NEGATIVE CONTROL handler — vuln_xss. Writes the label verbatim (no sanitization) into a
  test_note row via the typed mutation. The vulnerability is the MISSING schema pattern
  (manifest), so `<script>…` reaches storage and later the operator console unescaped.
{%- endcomment -%}
{% liquid
  assign uid = principal.user_id | append: ''
  graphql g = 'mcp/test_note_create', user_id: uid, label: arguments.label, source: 'vuln_xss'
  assign nid = g.record_create.id

  assign result = '{}' | parse_json
  hash_assign result['id'] = nid
  hash_assign result['label'] = arguments.label
  hash_assign result['stored_raw'] = true

  assign subject = '{}' | parse_json
  hash_assign subject['type'] = 'record'
  hash_assign subject['id'] = nid

  assign out = '{}' | parse_json
  hash_assign out['ok'] = true
  hash_assign out['result'] = result
  hash_assign out['subject'] = subject
  return out
%}
