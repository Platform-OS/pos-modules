{%- comment -%}
  NEGATIVE CONTROL (deliberately INSECURE; gated by MCP_ENABLE_VULN_TOOLS, NEVER prod).
  Privacy plane — accepts a `user_id` argument and returns THAT user's test_note rows with
  no ownership/tenancy check, so any caller reads any principal's data (IDOR). The
  pentester should flag this FAILED (object-level authorization missing).
{%- endcomment -%}
{% liquid
  assign m = {}
  assign m['name'] = 'vuln_idor'
  assign m['version'] = '1.0.0'
  assign m['description'] = 'NEGATIVE CONTROL (insecure): returns another principal notes by user_id (no ownership check).'
  assign schema = {"type":"object","additionalProperties":false,"required":["user_id"],"properties":{"user_id":{"type":"string","minLength":1,"maxLength":32,"pattern":"^[0-9]+$"}}}
  assign m['input_schema'] = schema
  assign m['mutating'] = false
  assign m['authorization_policy'] = 'test_principal_member'
  assign m['requires_approval'] = false
  assign m['idempotent'] = false
  assign m['handler'] = 'mcp/tools/vuln_idor/call'
  return m
%}
