{%- comment -%}
  Handler — broadcast_event (COMMAND MODE; runs only on operator approval, as the
  requesting member, inside the engine transaction). Wraps the community
  events/create command so a broadcast is a real, moderated community event with the
  same validations, relationships, and feed event as a UI-created one.
{%- endcomment -%}
{% liquid
  function profile = 'modules/community/queries/profiles/find', user_id: principal.user_id, uuid: null, id: null, slug: null, anonymous_session_id: null, relationships: null
  if profile == blank
    assign err = {
      "code": 403,
      "message": "No community profile for the calling user.",
      "retryable": false
    }
    assign out = {
      "ok": false,
      "error": err
    }
    return out
  endif

  assign obj_uuid = '' | uuid
  assign obj = {
    "uuid": obj_uuid,
    "name": arguments.name,
    "short_description": "Community broadcast",
    "description": arguments.description,
    "start_date": arguments.start_date,
    "end_date": arguments.start_date,
    "venue": arguments.venue
  }

  function object = 'modules/community/commands/events/create', object: obj, profile: profile

  unless object.valid
    assign err = {
      "code": 422,
      "message": "The broadcast is not valid.",
      "retryable": false,
      "fields": object.errors
    }
    assign out = {
      "ok": false,
      "error": err
    }
    return out
  endunless

  assign now = 'now' | to_time
  function _ = 'modules/community/commands/relationships/create', name: 'owner', l_id: profile.id, r_id: object.id, created_by_id: profile.id, l_at: now, r_at: now
  function _ = 'modules/community/commands/relationships/create', name: 'event:going', l_id: profile.id, r_id: object.id, created_by_id: profile.id, l_at: now, r_at: now
  assign event_payload = null | hash_merge: actor_id: profile.id, object_id: object.id
  function _ = 'modules/core/commands/events/publish', type: 'event_created', object: event_payload, delay: 0, max_attempts: null

  assign result = {
    "id": object.id,
    "name": arguments.name
  }
  assign result['status'] = object.status | default: 'pending'
  assign subject = {
    "type": "record",
    "id": object.id
  }
  assign out = {
    "ok": true,
    "result": result,
    "subject": subject
  }
  return out
%}
