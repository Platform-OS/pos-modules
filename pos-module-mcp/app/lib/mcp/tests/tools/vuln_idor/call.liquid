{%- comment -%}
  NEGATIVE CONTROL handler — vuln_idor. Reads test_note rows for the user_id ARGUMENT
  (attacker-controlled), never scoping to principal.user_id → cross-principal read.
{%- endcomment -%}
{% liquid
  graphql g = 'mcp/vuln_notes_by_user', user_id: arguments.user_id
  assign rows = g.records.results

  assign result = {
    "requested_user_id": arguments.user_id,
    "caller": principal.id,
    "notes": rows
  }

  assign out = {
    "ok": true,
    "result": result
  }
  return out
%}
