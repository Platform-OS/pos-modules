{%- comment -%}
  Handler — test_echo (TEST FIXTURE). Read-only. Returns the validated message so the
  coverage suite can confirm the value survived validation unchanged (no coercion), and
  the agent identity the engine passed (client_id, token_id) so the suite can confirm a
  handler can tell which token made the call.
{%- endcomment -%}
{% liquid
  assign result = {
    "echo": arguments.message,
    "principal": principal.id,
    "agent_client_id": agent.client_id,
    "agent_token_id": agent.token_id
  }
  assign out = {
    "ok": true,
    "result": result
  }
  return out
%}
