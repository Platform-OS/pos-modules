{%- comment -%}
  Tool manifest — test_write (TEST FIXTURE, app-owned; gated by MCP_ENABLE_TEST_TOOLS).
  MUTATING + IDEMPOTENT, policy test_principal_member. Writes one test_note row owned
  by the calling principal. Exercises: transaction COMMIT (row persists), idempotency
  (same key → exactly one row + replayed result; same key + different args → -32602), and
  attestation of a successful mutation.
{%- endcomment -%}
{% liquid
  assign m = {
    "name": "test_write",
    "version": "1.0.0",
    "description": "TEST FIXTURE (not a production tool): writes a test_note row owned by the caller.",
    "input_schema": {"type":"object","additionalProperties":false,"required":["label"],"properties":{"label":{"type":"string","minLength":1,"maxLength":100,"pattern":"^[^<>]*$","description":"label stored on the row"}}},
    "mutating": true,
    "authorization_policy": "test_principal_member",
    "requires_approval": false,
    "idempotent": true,
    "handler": "mcp/tests/tools/test_write/call"
  }
  return m
%}
