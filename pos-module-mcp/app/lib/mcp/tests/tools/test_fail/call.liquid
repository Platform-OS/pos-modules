{%- comment -%}
  Handler — test_fail (TEST FIXTURE). Writes a test_note row, THEN reports failure.
  Because ok:false maps to a non-success outcome, the engine rolls the whole
  transaction back — the row must NOT survive. This is the rollback probe.
{%- endcomment -%}
{% liquid
  assign uid = principal.user_id | append: ''
  # Write first — the point is that this write gets undone by the rollback.
  graphql g = 'mcp/test_note_create', user_id: uid, label: arguments.label, source: 'test_fail'

  assign err = {
    "code": 500,
    "message": "Intentional test failure (rollback probe).",
    "retryable": false
  }
  assign out = {
    "ok": false,
    "error": err
  }
  return out
%}
