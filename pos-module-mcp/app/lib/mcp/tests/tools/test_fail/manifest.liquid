{%- comment -%}
  Tool manifest — test_fail (TEST FIXTURE, app-owned; gated by MCP_ENABLE_TEST_TOOLS).
  MUTATING, policy test_principal_member. The handler writes a test_note row and THEN
  returns ok:false — so a correct engine ROLLS BACK the write. The coverage suite proves
  reversibility by asserting: the call is isError, NO test_fail row persists, and the
  ledger records a 'rolled_back' outcome. Not idempotent (each attempt must re-run).
{%- endcomment -%}
{% liquid
  assign m = {
    "name": "test_fail",
    "version": "1.0.0",
    "description": "TEST FIXTURE (not a production tool): writes a row then fails, to prove transaction rollback.",
    "input_schema": {"type":"object","additionalProperties":false,"required":["label"],"properties":{"label":{"type":"string","minLength":1,"maxLength":100,"pattern":"^[^<>]*$"}}},
    "mutating": true,
    "authorization_policy": "test_principal_member",
    "requires_approval": false,
    "idempotent": false,
    "handler": "mcp/tests/tools/test_fail/call"
  }
  return m
%}
