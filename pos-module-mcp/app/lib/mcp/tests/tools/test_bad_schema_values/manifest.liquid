{%- comment -%}
  Tool manifest — test_bad_schema_values (TEST FIXTURE, app-owned). Registered ONLY when the
  MCP_ENABLE_TEST_TOOLS constant is set (see registry). Negative control for the schema
  meta-check: keyword values of the wrong JSON Schema type that used to load: draft-4 "exclusiveMinimum": true, "required" as a string, "enum" as a string.
  The engine must exclude this tool from tools/list (and keep serving the others)
  instead of publishing a schema it cannot enforce.
{%- endcomment -%}
{% liquid
  assign m = {
    "name": "test_bad_schema_values",
    "version": "1.0.0",
    "description": "TEST FIXTURE (not a production tool): declares an invalid schema and must never be served.",
    "input_schema": {"type":"object","additionalProperties":false,"properties":{}},
    "output_schema": {"type":"object","required":"n","properties":{"n":{"type":"integer","exclusiveMinimum":true},"s":{"type":"string","enum":"a"}}},
    "mutating": false,
    "authorization_policy": "public_read",
    "requires_approval": false,
    "idempotent": true,
    "handler": "mcp/tests/tools/test_bad_schema_values/call"
  }
  return m
%}
