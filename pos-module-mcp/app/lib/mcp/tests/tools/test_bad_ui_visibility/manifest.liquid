{%- comment -%}
  Tool manifest — test_bad_ui_visibility (TEST FIXTURE, app-owned). Registered ONLY when
  the MCP_ENABLE_TEST_TOOLS constant is set (see registry). Negative control for the
  manifest meta-schema: ui.visibility holds a value other than "model" and "app", so the
  engine must exclude the tool rather than guess who may see it.
{%- endcomment -%}
{% liquid
  assign m = {
    "name": "test_bad_ui_visibility",
    "version": "1.0.0",
    "description": "TEST FIXTURE (not a production tool): declares an unknown ui visibility and must never be served.",
    "input_schema": {"type":"object","additionalProperties":false,"properties":{}},
    "ui": {"visibility":["robot"]},
    "mutating": false,
    "authorization_policy": "public_read",
    "requires_approval": false,
    "idempotent": true,
    "handler": "mcp/tests/tools/test_public/call"
  }
  return m
%}
