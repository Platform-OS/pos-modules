{% doc %}
  @param {object} object - The response object to process
  @param {object} gateway_request - The gateway request to update
{% enddoc %}
{% liquid
  assign response_status = object.response.status | append: ""
  assign gateway_object_id = object.response.body | parse_json | dig: 'id'
  assign object = {"id": gateway_request.id, "response_body": object.response.body, "response_status": response_status, "gateway_object_id": gateway_object_id}

  return object
%}
