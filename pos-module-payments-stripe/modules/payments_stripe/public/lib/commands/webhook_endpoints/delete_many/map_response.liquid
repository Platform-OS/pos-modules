{% liquid
  assign body = response.body | parse_json

  if response.status == 200
    assign webhook = {"gateway_id": body.id, "valid": true}
    if body.error
      assign webhook.errors = [{"message": body.error.message}]
    endif
  else
    assign webhook = {"errors": [{"message": body.error.message}], "valid": false}
  endif

  return webhook
%}
