{% doc %}
  @param {object} response - Stripe API response
  @param {string} events - Subscribed Stripe events list
  @param {string} stripe_account_name - Optional connected-account name
{% enddoc %}
{% liquid
  assign body = response.body | parse_json

  if response.status == 200
    assign webhook = {"gateway_id": body.id, "url": body.url, "secret": body.secret, "livemode": body.livemode, "enabled_events": events, "stripe_account_name": stripe_account_name, "valid": true}
    if body.error
      assign webhook.errors = [{"message": body.error.message}]
    endif
  else
    assign webhook = {"errors": body.error.message, "valid": false}
  endif

  return webhook
%}
