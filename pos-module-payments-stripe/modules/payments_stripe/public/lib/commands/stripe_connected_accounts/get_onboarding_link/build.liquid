{%- parse_json payload -%}
  {
    "account": {{ account_id | json }},
    "refresh_url": {{ refresh_url | default: return_url | json }},
    "return_url": {{ return_url | json }},
    "stripe_account_name": {{ stripe_account_name | json }},
    "type": "account_onboarding"
  }
{%- endparse_json -%}
{% liquid
  assign result = '{}' | parse_json
  hash_assign result['payload'] = payload
  hash_assign result['request_type'] = 'POST'
  hash_assign result['to'] = 'https://api.stripe.com/v1/account_links'
  return result
%}
