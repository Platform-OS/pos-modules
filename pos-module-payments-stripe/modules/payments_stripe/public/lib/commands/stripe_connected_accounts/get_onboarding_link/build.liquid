{% liquid
  assign refresh_url = refresh_url | default: return_url
  assign payload = {"account": account_id, "refresh_url": refresh_url, "return_url": return_url, "stripe_account_name": stripe_account_name, "type": "account_onboarding"}
  assign data = {"payload": payload, "request_type": "POST", "to": "https://api.stripe.com/v1/account_links"}

  return data
%}
