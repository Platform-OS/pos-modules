{% liquid
  assign data = {"setup_intent": setup_intent, "id": object.id}
  if object.customer
    assign customer = {"customer_id": object.customer, "reference_id": setup_intent.reference_id, "stripe_account_name": setup_intent.stripe_account_name}
    function retrieved_customer = 'modules/payments_stripe/commands/stripe_customer/retrieve', customer_id: object.customer, payer_id: setup_intent.reference_id, stripe_account_name: setup_intent.stripe_account_name
    if retrieved_customer.valid
      assign customer.email = retrieved_customer.email
      assign customer.name = retrieved_customer.name
    endif
    assign data.customer = customer
    if object.payment_method
      assign payment_method = {"payment_method_id": object.payment_method, "type": "card", "stripe_account_name": setup_intent.stripe_account_name}
      function retrieved_payment_method = 'modules/payments_stripe/commands/stripe_payment_method/retrieve', payment_method_id: object.payment_method, customer_id: object.customer, stripe_account_name: setup_intent.stripe_account_name
      if retrieved_payment_method.valid
        assign payment_method = retrieved_payment_method
      endif
      assign data.payment_method = payment_method
    endif
  endif
  assign data.status = object.status

  return data
 %}
