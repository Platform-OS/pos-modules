{% liquid
  assign customer_id = customer.customer_id | default: object.customer_id
  assign reference_id = customer.reference_id | default: object.reference_id
  assign object = {"payment_method_id": object.payment_method_id, "customer_id": customer_id, "reference_id": reference_id, "type": object.type, "brand": object.brand, "last4": object.last4, "exp_year": object.exp_year, "stripe_account_name": object.stripe_account_name, "exp_month": object.exp_month}

  return object
%}
