{% doc %}
  @param {object} object - The object to process
{% enddoc %}
{% liquid
  assign model = context.constants['modules/openai/OPENAI_MODEL'] | default: "text-embedding-ada-002"
  assign version = context.constants['modules/openai/OPENAI_VERSION'] | default: "v1"
  assign url = "https://api.openai.com/" | append: version | append: "/embeddings"
  assign authorization = "Bearer " | append: context.constants['modules/openai/OPENAI_SECRET_TOKEN']

  assign request_object = {
    "template": "modules/core/generic",
    "data": {
      "to": url,
      "headers": {
        "Content-Type": "application/json",
        "Authorization": authorization
      },
      "request_type": "POST",
      "payload": { "model": model }
    }
  }

  if object != blank
    assign arr = object
    assign obj_type = object | type_of
    if obj_type != 'Array'
      assign arr = [object]
    endif
    assign request_object.data.payload.input = arr | array_compact
  else
    log "modules/openai/fetch_embeddings - object is null, should be an array of strings that will be transformed to embeddings", type: 'ERROR'
  endif

  return request_object
%}
