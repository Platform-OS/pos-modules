{% doc %}
  @description Unlike the other query tests in this suite, this one does NOT touch
    Accela at all - it's a local GraphQL read of the accela_oauth_token
    table, so it's safe to assert concretely rather than as a smoke test.
    Every other test in this suite makes real Accela calls, which cache a
    real token here via get_valid_token - so this table is never actually
    empty once the suite has run once. Rather than assert emptiness (which
    would only be true on a genuinely fresh, never-used environment), this
    asserts the real shape of whatever get_valid_token has already cached:
    when a row exists, it belongs to this module's own table.
  @param {object} contract - test contract object tracking results
{% enddoc %}
{% liquid
  function token_record = 'modules/accela_construct/queries/accela_oauth_token/find'

  assign shape_check = { "token_row_belongs_to_this_module": true }
  if token_record != blank and token_record.table != 'modules/accela_construct/accela_oauth_token'
    assign shape_check.token_row_belongs_to_this_module = false
  endif
  function contract = 'modules/tests/assertions/true', contract: contract, object: shape_check, field_name: 'token_row_belongs_to_this_module'
%}
