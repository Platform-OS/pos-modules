---
metadata:
  event:
    caller
    method
    path
    reference
    request_id
    attempt_number
    error
---
{% doc %}
  @description Validates the event lib/accela_client/perform_retry_attempt.liquid
    broadcasts (via `modules/core/commands/events/publish`) when the last
    background retry of a `with_retries: true` request fails and the module
    gives up on it - the failure counterpart of
    `accela_construct_request_succeeded`.
  @param {object} event - per pos-module-core's event convention:
    `caller` - the calling query/command's own module path (always present);
    `method` - "GET" | "POST" | "PUT" | "DELETE" | "MULTIPART" (always present);
    `path` - request path relative to ACCELA_CONSTRUCT_BASE_URL (always present);
    `reference` - optional hash `{ "id", "table" }` this call was made on
    behalf of - see send.liquid;
    `request_id` - the accela_request row id for this logical request (always present);
    `attempt_number` - the 1-based attempt that failed last;
    `error` - that attempt's error message. Its accela_request_response row
    is written in the background, so it may not exist yet when a consumer runs.
{% enddoc %}

{% liquid
  assign c = { "errors": {}, "valid": true }

  function c = 'modules/core/validations/presence', c: c, object: event, field_name: 'caller'
  function c = 'modules/core/validations/presence', c: c, object: event, field_name: 'method'
  function c = 'modules/core/validations/presence', c: c, object: event, field_name: 'path'
  function c = 'modules/core/validations/presence', c: c, object: event, field_name: 'request_id'

  return c
%}
