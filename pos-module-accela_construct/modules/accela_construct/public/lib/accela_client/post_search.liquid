{% doc %}
  @description Shared implementation for every POST /v4/search/<resource> query - they
    all take the same criteria hash plus optional pagination/filter params
    and differ only in which Accela resource they search. Each
    `lib/queries/searches/<resource>.liquid` file delegates here instead of
    repeating the same body verbatim.
  @param {string} resource - URL segment to search, e.g. "addresses", "parcels" (required)
  @param {object} [criteria] - hash of search criteria (all fields Accela documents for
    these endpoints are individually optional)
  @param {number} [offset] - default 0
  @param {number} [limit] - default 25 (Accela max 1000)
  @param {string} [expand] - optional comma-separated string
  @param {string} [fields] - optional comma-separated string to limit returned fields
  @param {boolean} [with_retries] - default false. When true, retries a
    failed attempt in the background with increasing delay - see
    lib/accela_client/send.liquid.
  @param {object} [reference] - hash `{ "id", "table" }` forwarded to
    send.liquid - see send.liquid.
  @param {string} [caller] - module path forwarded to send.liquid - see
    send.liquid and error_result.liquid.
  @example
    {% function result = 'modules/accela_construct/accela_client/post_search', resource: 'addresses', criteria: criteria %}
{% enddoc %}

{% liquid
  assign offset = offset | default: 0
  assign limit = limit | default: 25

  assign qs_params = { "offset": offset, "limit": limit, "expand": expand, "fields": fields }
  function qs = 'modules/accela_construct/accela_client/build_query_string', params: qs_params

  assign path = "/search/{{ resource }}?{{ qs }}"
  assign payload = criteria | json

  function result = 'modules/accela_construct/accela_client/send', method: 'POST', path: path, payload: payload, with_retries: with_retries, reference: reference, caller: caller
  return result
%}
