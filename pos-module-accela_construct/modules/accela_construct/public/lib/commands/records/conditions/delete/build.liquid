{% comment %}
  modules/accela_construct/commands/records/conditions/delete/build

  Normalizes input and prepares the request for DELETE
  /v4/records/{recordId}/conditions/{ids}: the request path (relative to
  ACCELA_CONSTRUCT_BASE_URL). This request has no body.

  Params:
    object - Hash with `record_id` and `ids` (see records/conditions/delete.liquid)

  Returns object with `path` added.
{% endcomment %}

{% liquid
  assign object.path = "/records/{{ object.record_id | url_encode }}/conditions/{{ object.ids | url_encode }}"
  return object
%}
