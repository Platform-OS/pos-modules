{% comment %}
  modules/accela_construct/commands/records/usercomments/create/build

  Normalizes input and prepares the request for POST
  /v4/records/{recordId}/usercomments: the request path (relative to
  ACCELA_CONSTRUCT_BASE_URL, with the record id) and the JSON-serialized body
  (empty object if no `comment` hash was given).

  Params:
    object - Hash with `record_id` and optional `comment` (see
             records/usercomments/create.liquid)

  Returns object with `path` and `payload` added.
{% endcomment %}

{% liquid
  assign object.path = "/records/{{ object.record_id | url_encode }}/usercomments"
  assign body = object.comment | default: {}
  assign object.payload = body | json
  return object
%}
