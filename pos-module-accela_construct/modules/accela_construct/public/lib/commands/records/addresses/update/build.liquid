{% comment %}
  modules/accela_construct/commands/records/addresses/update/build

  Normalizes input and prepares the request for PUT
  /v4/records/{recordId}/addresses/{id}: the request path (relative to
  ACCELA_CONSTRUCT_BASE_URL, with the record id and address id) and the
  JSON-serialized address body.

  Params:
    object - Hash with `record_id`, `id`, and `address` (see addresses/update.liquid)

  Returns object with `path` and `payload` added.
{% endcomment %}

{% liquid
  assign object.path = "/records/{{ object.record_id | url_encode }}/addresses/{{ object.id | url_encode }}"
  assign object.payload = object.address | json
  return object
%}
