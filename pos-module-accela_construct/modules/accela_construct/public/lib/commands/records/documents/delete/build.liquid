{% comment %}
  modules/accela_construct/commands/records/documents/delete/build

  Normalizes input and prepares the request for DELETE
  /v4/records/{recordId}/documents/{documentIds}: the request path
  (relative to ACCELA_CONSTRUCT_BASE_URL). This request has no body.

  Params:
    object - Hash with `record_id` and `document_ids` (see documents/delete.liquid)

  Returns object with `path` added.
{% endcomment %}

{% liquid
  assign object.path = "/records/{{ object.record_id | url_encode }}/documents/{{ object.document_ids | url_encode }}"
  return object
%}
