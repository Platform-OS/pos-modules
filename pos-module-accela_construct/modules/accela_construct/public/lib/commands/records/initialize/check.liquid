{% comment %}
  modules/accela_construct/commands/records/initialize/check
  Validates the object built by build.liquid before it's sent to Accela,
  using pos-module-core's validation contract convention.
{% endcomment %}

{% liquid
  assign c = { "errors": {}, "valid": true }
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'record'

  assign object.valid = c.valid
  assign object.errors = c.errors
  return object
%}
