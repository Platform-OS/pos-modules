{% doc %}
  Normalizes input and prepares the request for POST
  /v4/inspections/schedule: the request path (relative to
  ACCELA_CONSTRUCT_BASE_URL) and the JSON-serialized inspection body.
  @param {object} object - Hash with `inspection` (see inspections/schedule.liquid)
  @returns {object} object with `path` and `payload` added.
{% enddoc %}

{% liquid
  assign object.path = '/inspections/schedule'
  assign object.payload = object.inspection | json
  return object
%}
