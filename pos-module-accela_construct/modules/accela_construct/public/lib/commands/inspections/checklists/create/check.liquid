{% doc %}
  Validates the object built by build.liquid before it's sent to Accela.
{% enddoc %}

{% liquid
  assign c = { "errors": {}, "valid": true }
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'inspection_id'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'checklist'

  assign object.valid = c.valid
  assign object.errors = c.errors
  return object
%}
