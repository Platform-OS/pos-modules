{% doc %}
  Normalizes input and prepares the request for DELETE
  /v4/inspections/{id}/related/{childIds}: the request path. This request
  has no body.
  @param {object} object - Hash with `id` and `child_ids` (see related/delete.liquid)
  @returns {object} object with `path` added.
{% enddoc %}

{% liquid
  assign object.path = "/inspections/{{ object.id | url_encode }}/related/{{ object.child_ids | url_encode }}"
  return object
%}
