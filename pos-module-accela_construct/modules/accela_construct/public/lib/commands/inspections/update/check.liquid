{% comment %}
  modules/accela_construct/commands/inspections/update/check
  Validates the object built by build.liquid before it's sent to Accela.
{% endcomment %}

{% liquid
  assign c = { "errors": {}, "valid": true }
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'id'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'inspection'

  assign object.valid = c.valid
  assign object.errors = c.errors
  return object
%}
