{% comment %}
  modules/accela_construct/commands/inspections/update/build

  Normalizes input and prepares the request for PUT /v4/inspections/{id}:
  the request path (with the inspection id) and the JSON-serialized
  inspection body.

  Params:
    object - Hash with `id` and `inspection` (see update.liquid)

  Returns object with `path` and `payload` added.
{% endcomment %}

{% liquid
  assign object.path = "/inspections/{{ object.id | url_encode }}"
  assign object.payload = object.inspection | json
  return object
%}
