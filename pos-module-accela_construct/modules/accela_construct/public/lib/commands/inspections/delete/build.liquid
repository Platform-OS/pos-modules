{% comment %}
  modules/accela_construct/commands/inspections/delete/build

  Normalizes input and prepares the request for DELETE
  /v4/inspections/{ids}: the request path. This request has no body.

  Params:
    object - Hash with `ids` (see delete.liquid)

  Returns object with `path` added.
{% endcomment %}

{% liquid
  assign object.path = "/inspections/{{ object.ids | url_encode }}"
  return object
%}
