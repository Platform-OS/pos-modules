{% comment %}
  modules/accela_construct/commands/inspections/cancel/check
  Validates the object built by build.liquid before it's sent to Accela,
  using pos-module-core's validation contract convention.
{% endcomment %}

{% liquid
  assign c = { "errors": {}, "valid": true }
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'ids'
  function c = 'modules/core/validations/presence', c: c, object: object, field_name: 'path'

  return object | hash_merge: valid: c.valid, errors: c.errors
%}
