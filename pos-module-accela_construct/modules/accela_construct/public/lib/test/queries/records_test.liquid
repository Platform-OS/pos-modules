  function contract = 'modules/tests/assertions/not_true', contract: contract, object: result, field_name: 'records_get_success'
  function contract = 'modules/tests/assertions/presence', contract: contract, object: result, field_name: 'records_get_error'

  assign search_criteria = { "module": "Building" }
