{% doc %}
  @description Wraps POST /v4/search/records (Accela "Search Records").

    Follows the pos-module-core build/check command pattern (see
    search/{build,check}.liquid): build prepares the request path and
    payload, check validates required params (none for this endpoint -
    see check.liquid) and this file executes the request itself once
    valid.
  @param {object} criteria - Hash of search criteria, e.g.
    { "module": "Building", "type": { "value": "Building/Commercial/Addition/NA" },
      "openedDateFrom": "2013-01-01 00:00:00", "openedDateTo": "2013-06-30 00:00:00" }
  @param {number} [offset] - optional, default 0
  @param {number} [limit] - optional, default 25 (Accela max 1000)
  @param {string} [expand] - optional comma-separated string, e.g. "addresses,parcels,owners"
  @param {string} [fields] - optional comma-separated string to limit returned fields
  @param {boolean} [with_retries] - default false. When true, retries a
    failed attempt in the background with increasing delay - see
    lib/accela_client/send.liquid.
  @param {object} [reference] - hash `{ "id", "table" }` forwarded
    to send.liquid - see send.liquid.
  @returns {object} the normalized result hash from lib/accela_client/send (result.body.result
    is the array of matching records on success).
  @example
    {% assign criteria = { "module": "Building" } %}
    {% function result = 'modules/accela_construct/queries/records/search', criteria: criteria, limit: 25 %}
{% enddoc %}

{% liquid
  assign object = { "errors": {}, "valid": true, "criteria": criteria, "offset": offset, "limit": limit, "expand": expand, "fields": fields }
  function object = 'modules/accela_construct/queries/records/search/build', object: object
  function object = 'modules/accela_construct/queries/records/search/check', object: object

  if object.valid
    function result = 'modules/accela_construct/accela_client/send', method: 'POST', path: object.path, payload: object.payload, with_retries: with_retries, reference: reference, caller: 'modules/accela_construct/queries/records/search'
  else
    function result = 'modules/accela_construct/accela_client/error_result', error: 'accela_validation_failed', errors: object.errors, caller: 'modules/accela_construct/queries/records/search'
  endif

  return result
%}
