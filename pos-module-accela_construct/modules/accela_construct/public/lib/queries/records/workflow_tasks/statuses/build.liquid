{% doc %}
  Builds the request path for GET /v4/records/{recordId}/workflowTasks/{id}/statuses.
  @param {object} object - Hash with `record_id`, `id` (see
    records/workflow_tasks/statuses.liquid)
  @returns {object} object with `path` added.
{% enddoc %}

{% liquid
  assign object.path = "/records/{{ object.record_id | url_encode }}/workflowTasks/{{ object.id | url_encode }}/statuses"
  return object
%}
