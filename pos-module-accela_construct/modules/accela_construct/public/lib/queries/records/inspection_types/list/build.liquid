{% doc %}
  Builds the request path for GET /v4/records/{recordIds}/inspectionTypes.
  @param {object} object - Hash with `record_ids` (see inspection_types/list.liquid)
  @returns {object} object with `path` added.
{% enddoc %}

{% liquid
  assign object.path = "/records/{{ object.record_ids | url_encode }}/inspectionTypes"
  return object
%}
