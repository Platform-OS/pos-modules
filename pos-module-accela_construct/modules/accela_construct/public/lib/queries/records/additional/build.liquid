{% doc %}
  Builds the request path for GET /v4/records/{recordId}/additional.
  @param {object} object - Hash with `record_id` (see records/additional.liquid)
  @returns {object} object with `path` added.
{% enddoc %}

{% liquid
  assign object.path = "/records/{{ object.record_id | url_encode }}/additional"
  return object
%}
