{% doc %}
  Builds the request path for GET /v4/records/{recordId}/addresses.
  @param {object} object - Hash with `record_id` (see records/addresses/list.liquid)
  @returns {object} object with `path` added.
{% enddoc %}

{% liquid
  assign object.path = "/records/{{ object.record_id | url_encode }}/addresses"
  return object
%}
