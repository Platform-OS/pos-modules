{% doc %}
  Builds the request path for GET /v4/records/{recordId}/documentCategories.
  @param {object} object - Hash with `record_id` (see documents/categories.liquid)
  @returns {object} object with `path` added.
{% enddoc %}

{% liquid
  assign object.path = "/records/{{ object.record_id | url_encode }}/documentCategories"
  return object
%}
