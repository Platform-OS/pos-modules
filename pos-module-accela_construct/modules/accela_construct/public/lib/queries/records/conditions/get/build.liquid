{% comment %}
  modules/accela_construct/queries/records/conditions/get/build

  Builds the request path for GET /v4/records/{recordId}/conditions/{id}.

  Params:
    object - Hash with `record_id`, `id` (see records/conditions/get.liquid)

  Returns object with `path` added.
{% endcomment %}

{% liquid
  assign object.path = "/records/{{ object.record_id | url_encode }}/conditions/{{ object.id | url_encode }}"
  return object
%}
