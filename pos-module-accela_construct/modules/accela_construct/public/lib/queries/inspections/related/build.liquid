{% doc %}
  Builds the request path for GET /v4/inspections/{id}/related.
  @param {object} object - Hash with `id` (see inspections/related.liquid)
  @returns {object} object with `path` added.
{% enddoc %}

{% liquid
  assign object.path = "/inspections/{{ object.id | url_encode }}/related"
  return object
%}
