{% comment %}
  modules/accela_construct/queries/inspections/histories/build

  Builds the request path for GET /v4/inspections/{inspectionIds}/histories.

  Params:
    object - Hash with `inspection_ids` (see inspections/histories.liquid)

  Returns object with `path` added.
{% endcomment %}

{% liquid
  assign object.path = "/inspections/{{ object.inspection_ids | url_encode }}/histories"
  return object
%}
