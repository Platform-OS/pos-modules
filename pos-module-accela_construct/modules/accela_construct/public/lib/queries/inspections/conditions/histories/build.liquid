{% doc %}
  Builds the request path for GET /v4/inspections/{inspectionId}/conditions/{id}/histories.
  @param {object} object - Hash with `inspection_id`, `id` (see
    inspections/conditions/histories.liquid)
  @returns {object} object with `path` added.
{% enddoc %}

{% liquid
  assign object.path = "/inspections/{{ object.inspection_id | url_encode }}/conditions/{{ object.id | url_encode }}/histories"
  return object
%}
