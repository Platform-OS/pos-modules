{% comment %}
  modules/accela_construct/queries/inspections/conditions/get/build

  Builds the request path for GET /v4/inspections/{inspectionId}/conditions/{id}.

  Params:
    object - Hash with `inspection_id`, `id` (see inspections/conditions/get.liquid)

  Returns object with `path` added.
{% endcomment %}

{% liquid
  assign object.path = "/inspections/{{ object.inspection_id | url_encode }}/conditions/{{ object.id | url_encode }}"
  return object
%}
