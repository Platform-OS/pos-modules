{% doc %}
  Builds the request path for GET /v4/inspections/{inspectionId}/checklists.
  @param {object} object - Hash with `inspection_id` (see
    inspections/checklists/list.liquid)
  @returns {object} object with `path` added.
{% enddoc %}

{% liquid
  assign object.path = "/inspections/{{ object.inspection_id | url_encode }}/checklists"
  return object
%}
