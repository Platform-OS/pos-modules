{% doc %}
  Builds the request path for GET /v4/addresses/{addressId}/conditions.
  @param {object} object - Hash with `address_id` (see addresses/conditions/list.liquid)
  @returns {object} object with `path` added.
{% enddoc %}

{% liquid
  assign object.path = "/addresses/{{ object.address_id | url_encode }}/conditions"
  return object
%}
