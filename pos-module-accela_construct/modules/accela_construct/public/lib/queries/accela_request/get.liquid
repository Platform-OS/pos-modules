{% doc %}
  @description Returns one accela_request row by id (method, path, request_payload,
    metadata), or nil if it doesn't exist. Used by
    perform_retry_attempt.liquid to look up the original request rather
    than carrying method/path/payload through the retry chain as
    arguments - schedule_retry.liquid/
    perform_retry_attempt.liquid only ever pass around the accela_request
    id (`request_id`) plus retry bookkeeping.
  @param {string} id - accela_request row id (required)
  @example
    {% function accela_request = 'modules/accela_construct/queries/accela_request/get', id: some_id %}
{% enddoc %}

{% liquid
  graphql get_result = 'modules/accela_construct/accela_request/get', id: id
  assign accela_request = get_result.records.results.first
  return accela_request
%}
