{% comment %} Create default tags {% endcomment %}

{% capture users_data %}
  [
    {
      "name": "Alex Admin",
      "first_name": "Alex",
      "last_name": "Admin",
      "email": "alex.admin@example.com",
      "password": {{ 12 | random_string | append: 'Pw123!' | json }},
      "profile": {
        "uuid": {{ "" | uuid | json }},
        "name": "Alex Admin",
        "first_name": "Alex",
        "last_name": "Admin",
        "slug": "alex-admin",
        "email": "alex.admin@example.com"
      }
    }
  ]
{% endcapture %}

{% liquid
assign users = users_data | parse_json

for user in users
  function object = 'modules/user/commands/user/create', email: user.email, password: user.password, first_name: user.first_name, last_name: user.last_name, roles: null, hook_params: null
  assign profile_object = {"uuid": user.profile.uuid, "name": user.profile.name, "first_name": user.profile.first_name, "last_name": user.profile.last_name, "email": user.profile.email, "user_id": object.id}
  function profile = 'modules/user/commands/profiles/create', object: profile_object
endfor
%}
{% log 'migrations/create_admin_user' %}
