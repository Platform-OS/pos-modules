{% liquid
  if participant_id == blank
    log 'Something went wrong. participant_id cannot be blank.', type: 'ERROR'
    return null
  endif

  graphql r = 'modules/chat/messages/search', limit: limit, page: page, participant_id: participant_id, conversation_id: conversation_id

  assign result = r.messages
  function resolved_results = 'modules/chat/queries/messages/with_media', messages: result.results, conversation_id: conversation_id
  assign result.results = resolved_results

  return result
%}
