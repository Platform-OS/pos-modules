{% comment %}
  Debounces the push notification: about 10 seconds after a message (delay is in minutes), it's only
  sent if no newer message came in the meantime - that one's own check sends it instead.
{% endcomment %}
{% background delay: 0.16, message_id: event.message_id, max_attempts: 0, app_host: event.app_host %}
  {% liquid
    graphql g = 'modules/chat/messages/search', id: message_id
    assign message = g.messages.results.first

    # gone by now (deleted since it was sent) - without this the search below would get
    # no conversation_id, so it would look through every conversation's messages
    if message
      graphql g = 'modules/chat/messages/search', conversation_id: message.conversation_id
      assign last_message = g.messages.results.first

      if last_message.id == message.id
        assign event_object = {"message_id": message.id, "app_host": app_host}

        function _ = 'modules/core/commands/events/publish', type: 'message_notification_to_send', object: event_object, delay: null, max_attempts: null
      endif
    endif
  %}
{% endbackground %}

{% return 'scheduled' %}
