{% liquid
  function object = 'modules/chat/commands/conversations/find_or_create/build', object: object, current_profile: current_profile

  if object.conversation_id
    function conversation = 'modules/chat/queries/conversations/find_by_participant', id: object.conversation_id, participant_id: current_profile.id, include_messages: true
  else
    function conversation = 'modules/chat/queries/conversations/find_by_participants', participant_ids: object.participant_ids, include_messages: true
    unless conversation
      # who may start a conversation with whom - see find_or_create/check
      function object = 'modules/chat/commands/conversations/find_or_create/check', object: object, current_profile: current_profile
      if object.valid != true
        return object
      endif

      function conversation = 'modules/chat/commands/conversations/create', object: object, current_profile: current_profile

      # platformOS has no unique index, so two requests at once (two tabs, a double click) can both
      # get here and create the same conversation. Each one looks again after creating: the oldest
      # one is kept and a newer one deletes itself - it was just created, nothing refers to it yet
      if conversation.id
        graphql r = 'modules/chat/conversations/oldest_by_participants', participant_ids: object.participant_ids
        assign oldest = r.conversations.results.first
        if oldest and oldest.id != conversation.id
          log conversation.id, type: 'modules/chat/commands/conversations/find_or_create: deleting a duplicate conversation'
          graphql _ = 'modules/chat/conversations/delete', id: conversation.id
          assign conversation = oldest
        endif
      endif
      assign conversation.created = true
    endunless
  endif

  return conversation
%}
