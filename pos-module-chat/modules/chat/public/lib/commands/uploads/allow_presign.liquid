{% doc %}
  Remembers in the session where files uploaded with the given presign end up - the
  presign's upload url followed by its key prefix - so modules/chat/commands/uploads/create
  only accepts upload urls this server handed out to the current user (see its check).
  The last few are kept, so a presign from another open tab stays valid.

  @param {object} presigned_upload - as returned by modules/chat/queries/uploads/presign
{% enddoc %}
{% liquid
  assign max_presigns = 10

  # the key ends with S3's ${filename} placeholder, filled in by the uploader
  assign key_prefix = presigned_upload.upload_url_payload.key | append: '' | remove: '${filename}'
  if key_prefix == blank
    log presigned_upload, type: 'WARNING chat: presign has no key, upload urls are only checked against its host'
  endif

  assign allowed_prefix = presigned_upload.upload_url | append: '' | url_decode
  assign last_character = allowed_prefix | slice: -1
  if last_character != '/'
    assign allowed_prefix = allowed_prefix | append: '/'
  endif
  assign allowed_prefix = allowed_prefix | append: key_prefix

  function presigns = 'modules/core/commands/session/get', key: 'chat_upload_presigns', clear: null
  assign presigns = presigns | default: []

  unless presigns contains allowed_prefix
    assign presigns << allowed_prefix
  endunless

  assign drop = presigns.size | minus: max_presigns
  if drop > 0
    assign kept = []
    for presign in presigns offset: drop
      assign kept << presign
    endfor
    assign presigns = kept
  endif

  function _ = 'modules/core/commands/session/set', key: 'chat_upload_presigns', value: presigns

  return presigns
%}
