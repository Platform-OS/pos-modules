<script>
  /* namespace */
  if(typeof window.pos !== 'object'){
    window.pos = {};
    window.pos.modules = {};
    window.pos.translations = {};
  }

  if(typeof window.pos.csrfToken !== 'string'){
    window.pos.csrfToken = '{{ context.authenticity_token }}';
  }

  /* profile namespace */
  if(typeof window.pos.profile !== 'object'){
    window.pos.profile = {{ current_profile }};
  }

  window.pos.profile.timezone = {% if current_profile.properties.timezone %} '{{ current_profile.properties.timezone }}' {% else %} null {% endif %};

  /* translations used in module */
  window.pos.translations = {
    ...window.pos.translations,
    chat: {
      connectionError: '{{ 'modules/chat/error_connection' | t }}',
      startFailed: '{{ 'modules/chat/error_start_conversation' | t }}',
      fileTooLarge: {
        single: '{{ 'modules/chat/error_file_too_large.single' | t }}',
        multiple: '{{ 'modules/chat/error_file_too_large.multiple' | t }}'
      },
      tooManyFiles: '{{ 'modules/chat/error_too_many_files' | t }}',
      uploadFailed: '{{ 'modules/chat/error_upload_failed' | t }}'
    }
  }
</script>
<script>
  /* loads and starts the chat the same way common-styling's init loads its modules - every url
     comes from asset_url, so a deploy reaches browsers despite the long asset caching */
  document.addEventListener('DOMContentLoaded', () => {
    const inbox = document.querySelector('#pos-chat-inbox');

    if(!inbox){
      return;
    }

    Promise.all([
      import('{{ 'modules/chat/js/pos-chat-consumer.js' | asset_url }}'),
      import('{{ 'modules/chat/js/pos-chat.js' | asset_url }}')
    ]).then(([consumer]) => {
      window.pos.modules.active.chat = new window.pos.modules.chat({
        inbox: inbox,
        consumer: consumer.default
      });
    });
  });
</script>

<!-- message templates -->
{% assign dummy_message = { "message": "", "created_at": null } %}
<template id="pos-chat-template-message-received">
  {% render 'modules/chat/message', message: dummy_message, authored: false, timezone: null, as_template: true %}
</template>
<template id="pos-chat-template-message-sent">
  {% render 'modules/chat/message', message: dummy_message, authored: true, timezone: null, as_template: true %}
</template>
<!-- end message templates -->


<div
  id="pos-chat-inbox"
  data-conversation-id="{{ current_conversation.id }}"
  data-to-uuid="{{ current_conversation.to_uuid }}"
  class="pos-app {% if current_conversation %} pos-chat-inbox-conversation-active {% endif %}"
>

  <aside class="pos-chat-sidebar">
    {% render 'modules/chat/search' %}

    <ul class="pos-chat-conversations" id="pos-chat-conversations">
      {% if conversations.total_entries > 0 %}
        {% render 'modules/chat/conversations', conversations: conversations, current: current_conversation, current_profile: current_profile %}
      {% else %}
        <div class="pos-chat-conversations-blank-desktop">
          {% liquid
            assign name = 'modules/chat/blank.title' | t
            render 'modules/chat/conversation', id: 0, current: true, name: name
          %}
        </div>
      {% endif %}
    </ul>
    {% if conversations.total_entries == 0 %}
      <div class="pos-chat-conversations-blank-mobile">
        {% render 'modules/common-styling/icon', icon: 'messageBubblesDouble', class: null %}
        <h2 class="pos-heading-2">{{ 'modules/chat/blank.title' | t }}</h2>
        {{ 'modules/chat/blank.description.mobile' | t }}
      </div>
    {% endif %}
  </aside>

  {% if current_conversation %}
    <div class="pos-chat-conversation" id="pos-chat-conversation">
      <header class="pos-chat-conversation-header">
        <a href="/inbox" class="pos-chat-conversation-header-back pos-button">
          <span class="pos-label">Show conversations list</span>
          {% render 'modules/common-styling/icon', icon: 'dashLeft', class: null %}
        </a>
        {% liquid
          assign participants = current_conversation.participants
          if participants
            assign current_participants = participants | array_select: id: current_profile.id
            assign other_participants = participants | array_subtract: current_participants
            assign from_profile = other_participants | first
            if from_profile
              if from_profile.first_name
                assign name = from_profile.first_name | append: ' ' | append: from_profile.last_name
              else
                assign name = from_profile.name
              endif
              render 'modules/common-styling/user/avatar', size: 's', name: name, image_src: from_profile.avatar.photo.versions.sm, class: null
            endif
          endif
        %}
        {{ name }}
      </header>
      <div class="pos-chat-conversation-messagesContainer" id="chat-messagesList-container">
        <div class="pos-chat-loadingIndicator" id="pos-chat-loadingIndicator">
          <span>
            {{- 'modules/chat/loading_previous' | t -}}
          </span>
        </div>
        <ul class="pos-chat-messages" id="chat-messagesList">
          {% liquid
            assign list = current_conversation.messages | reverse
            # 7 minutes, in seconds - a message only repeats the timestamp once the gap
            # since the previous message grows past this
            assign time_group_threshold = 420
            assign previous_created_at = null

            for message in list
              if message.autor_id == current_profile.id
                assign authored = true
              else
                assign authored = false
              endif

              assign show_time = true
              if previous_created_at
                assign current_epoch = message.created_at | to_time | date: '%s' | plus: 0
                assign previous_epoch = previous_created_at | to_time | date: '%s' | plus: 0
                assign gap_seconds = current_epoch | minus: previous_epoch

                if gap_seconds < time_group_threshold
                  assign show_time = false
                endif
              endif
              assign previous_created_at = message.created_at

              render 'modules/chat/message', message: message, authored: authored, timezone: current_profile.properties.timezone, show_time: show_time
            endfor
          %}
        </ul>
      </div>
      <div class="pos-chat-uploader" id="chat-uploader" hidden>
        {% comment %}
          kept in a template so common-styling doesn't load uppy on page load - pos-chat.js
          adds it to the page and loads uppy only once the user is about to attach a file
        {% endcomment %}
        {% # platformos-check-disable MissingAsset %}
        <template
          id="pos-chat-template-uploader"
          data-uppy-url="{{ 'modules/common-styling/js/dependency-uppy.js' | asset_url }}"
          data-upload-url="{{ 'modules/common-styling/js/pos-upload.js' | asset_url }}"
        >
          {% render 'modules/common-styling/forms/upload',
            id: 'chat-upload',
            presigned_upload: context.presigned_upload,
            name: 'chat-upload',
            max_number_of_files: 5,
            show_dashboard: false
          %}
        </template>
        {% # platformos-check-enable MissingAsset %}
      </div>
      <footer class="pos-form pos-chat-conversation-new">

        <div class="pos-chat-conversation-new-tools">
          <button type="button" title="{{ 'modules/chat/upload' | t }}" id="chat-uploadButton" class="pos-button">
            <span class="pos-label">{{ 'modules/chat/upload' | t }}</span>
            {% render 'modules/common-styling/icon', icon: 'imageFileUpload' %}
          </button>
          <input type="file" id="chat-uploadInput" multiple hidden>
        </div>

        <label for="chat-messageInput" class="pos-chat-conversation-new-input-container pos-form-input">
          <template id="pos-chat-template-uploader-list-item">
            <li class="pos-chat-uploader-list-item">
              <svg class="pos-chat-uploader-list-item-progress" aria-hidden="true">
                <rect width="100%" height="100%" rx="8" pathLength="100" />
              </svg>
              <img src="" alt="" width="48" height="48">
              {% render 'modules/common-styling/icon', icon: 'fileEmpty', class: 'pos-chat-uploader-list-file-type' %}
              <span class="pos-chat-uploader-list-item-name"></span>
              <button type="button" class="pos-chat-uploader-list-item-remove" title="{{ 'modules/chat/remove_file' | t }}">
                <span class="pos-label">{{ 'modules/chat/remove_file' | t }}</span>
                {% render 'modules/common-styling/icon', icon: 'x' %}
              </button>
            </li>
          </template>
          <ul class="pos-chat-uploader-list" id="chat-uploaderList"></ul>

          <textarea
          placeholder="{{ 'modules/chat/message_input_placeholder' | t }}"
            class="pos-chat-conversation-input"
            id="chat-messageInput"
            maxlength="10000"
            disabled
          ></textarea>
        </label>

        <button type="submit" id="chat-sendButton" class="pos-button pos-chat-conversation-new-send">{{ 'modules/chat/send' | t }}</button>

      </footer>

      <div class="pos-chat-conversation-upload-overlay" hidden>
        {{ 'modules/chat/upload_drop.title' | t }}<br>
        {{ 'modules/chat/upload_drop.max_size' | t }}
      </div>
    </div>
  {% else %}
    {% if conversations.total_entries > 0 %}
      <div class="pos-chat-conversation-messages-blank">
        {{ 'modules/chat/blank.pick_conversation' | t }}
      </div>
    {% endif %}

    {% if conversations.total_entries == 0 %}
      <div class="pos-chat-conversation" id="pos-chat-conversation">
        <div class="pos-chat-conversation-messagesContainer" id="chat-messagesList-container">
          <ul class="pos-chat-messages" id="chat-messagesList">
            {% if conversations.total_entries == 0 %}
              {% liquid
                assign title = 'modules/chat/blank.title' | t
                assign description = 'modules/chat/blank.description.desktop' | t
                assign messages = [
                  {
                    "message": title,
                    "created_at": "{{ 'now' | to_time }}"
                  },
                  {
                    "message": description,
                    "created_at": "{{ 'now' | to_time }}"
                  }
                ]
              %}
              {% for message in messages %}
                {% render 'modules/chat/message', message: message, authored: false, timezone: current_profile.properties.timezone %}
              {% endfor %}
            {% endif %}
          </ul>
        </div>
      </div>
    {% endif %}

  {% endif %}
</div>
