{% doc %}
  @param {boolean} authored - if current message has been authored by the current user
  @param {boolean} [show_time] - if the timestamp should be visible or not
  @param {object} message - text message to be shown
  @param {string} [timezone] - timezone of the time shown until the browser formats it
{% enddoc %}


{%- comment -%} a literal line break - Liquid strings have no "\n" escape {%- endcomment -%}
{%- capture newline %}
{% endcapture -%}
{% liquid
  # messages are stored as typed and shown as plain text with line breaks - each line is
  # printed with an output tag, which escapes it. This is the only place a message is
  # rendered: the inbox, the older messages (messages.frame) and the live ones (rendered
  # by channels/conversate/receive and broadcast as HTML) all come from here.
  # Not markdown: with only <br> allowed it rendered no formatting but still ate the
  # syntax (link URLs, list numbers, asterisks, backslashes). Not html_safe either: it unescapes, so
  # `escape | newline_to_br | html_safe` would output the user's HTML as-is.
  assign lines = message.message | split: newline

  # show_time defaults to true - callers only pass false when this message sits
  # within 7 minutes of the previous one and the timestamp would be redundant
  assign display_time = true
  if show_time == false
    assign display_time = false
  endif
%}

{% comment %}
  data-autor-id: a live message is broadcast to both participants as the same HTML, rendered
  without pos-chat-message-authored - pos-chat.js adds the class for the author
{% endcomment %}
<li class="pos-chat-message {% if authored %} pos-chat-message-authored {% endif %}"{% if message.id %} data-id="{{ message.id }}"{% endif %}{% if message.autor_id %} data-autor-id="{{ message.autor_id }}"{% endif %}>

  {% comment %}
    formatted in the browser by common-styling - a hidden timestamp isn't, it stays empty
    and only keeps the date pos-chat.js orders and groups the messages by
  {% endcomment %}
  {% if display_time and message.created_at %}
    {% render 'modules/common-styling/time', date: message.created_at, timezone: timezone %}
  {% else %}
    <time{% if message.created_at %} datetime="{{ message.created_at }}"{% endif %}></time>
  {% endif %}

  {% if message.media.size > 0 %}
    {% for attachment in message.media %}
      {% if attachment.type contains 'image/' %}
        {% liquid
          # sized by width and height (see the CSS) - left empty when unknown, which the
          # browser ignores, so it takes its own size once loaded (0 would hide it)
          assign image_width = attachment.width | plus: 0
          assign image_height = attachment.height | plus: 0
          assign image_sized = false
          if image_width > 0 and image_height > 0
            assign image_sized = true
          else
            assign image_width = ''
            assign image_height = ''
          endif
        %}
        <div class="pos-chat-message-content pos-chat-message-image"{% if image_sized %} style="--pos-chat-image-ratio: {{ image_width }} / {{ image_height }}"{% endif %}>
          <img src="{{ attachment.url }}" alt="" width="{{ image_width }}" height="{{ image_height }}" loading="lazy" decoding="async">
        </div>
      {% else %}
        {% liquid
          assign display_size = attachment.size | divided_by: 1024.0 | round: 1 | append: ' KB'
          if attachment.size >= 1048576
            assign display_size = attachment.size | divided_by: 1048576.0 | round: 1 | append: ' MB'
          endif
        %}
        <div class="pos-chat-message-content pos-chat-message-file">
          <a href="{{ attachment.url }}" target="_blank" rel="noopener noreferrer">
            {% render 'modules/common-styling/icon', icon: 'fileEmpty' %}
            <span class="pos-chat-message-file-name">{{ attachment.name }}</span>
            <small>({{ display_size }})</small>
          </a>
        </div>
      {% endif %}
    {% endfor %}
  {% endif %}

  {% if message.message != blank %}
    <div class="pos-chat-message-content pos-chat-message-text">
      {%- for line in lines -%}
        {{ line }}{% unless forloop.last %}<br>{% endunless %}
      {%- endfor -%}
    </div>
  {% endif %}

</li>
