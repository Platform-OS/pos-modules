{% comment %}
  Send email notification
{% parse_json data %}
    {
      "email": "email"
      "username": "",
      "sender": {{ context["params"]["sender_name"] | to_json }},
      "message": {{ context["params"]["message"] | to_json }}
    }
{% endparse_json %}
  graphql notify = 'modules/chat/notify', data: data
  log notify
%}
{% endcomment %}

{% liquid
  function current_profile = 'modules/user/helpers/current_profile'

  assign room_id = context.params.room_id

  function conversation = 'modules/chat/queries/conversations/find_by_participant', id: room_id, participant_id: current_profile.id, include_messages: null
  if conversation
    if context.params.mark_read
      # Sent by the client (see pos-chat.js) when it renders a message live while
      # the tab is visible. This still goes through `receive` - it's the only
      # action ActionCable's WebNotificationsChannel dispatches to (anything else,
      # e.g. a custom `perform('mark_read')`, is silently dropped server-side since
      # no such method exists on the channel). Echoing "false" suppresses the
      # default rebroadcast-to-room the Ruby channel does for any other output, so
      # other participants don't receive this ping as if it were a message.
      function _res = 'modules/chat/commands/conversations/mark_read', conversation: conversation, participant_id: current_profile.id
      echo "false"
    else
      assign message_safe = context.params.message | raw_escape_string

      # The client sends its own uploaded attachments as { id, ... } (the id is a
      # modules/chat/uploads record - see pos-chat.js's pos-upload-file-uploaded
      # handler). Only the id is trusted here: each is resolved against
      # modules/chat/uploads and dropped unless it actually belongs to this sender
      # and this conversation, before being persisted on the message as a plain
      # array of ids (media is no longer a JSON blob of attachment details/URLs -
      # those are resolved fresh, with a signed time-limited URL, on every read -
      # see modules/chat/queries/messages/with_media).
      assign requested_ids = []
      if context.params.media
        assign requested_ids = context.params.media | map: 'id' | array_compact
      endif

      assign media_ids = []
      if requested_ids.size > 0
        # Scoped by conversation_id (platformOS's records filter can't match id
        # against a list) - see modules/chat/queries/uploads/search_by_conversation.
        function candidates = 'modules/chat/queries/uploads/search_by_conversation', conversation_id: conversation.id
        for id in requested_ids
          assign matches = candidates | array_select: id: id
          assign candidate = matches | first
          if candidate and candidate.uploader_id == current_profile.id
            assign media_ids << candidate.id
          endif
        endfor
      endif

      assign object = { "conversation_id": conversation.id, "autor_id": current_profile.id, "message": message_safe, "media": media_ids }
      function message = 'modules/chat/commands/messages/create', object: object
      if message.valid != true
        log message, 'ERROR receive message'
        echo "false"
      else
        function _res = 'modules/chat/commands/conversations/mark_unread', conversation: conversation, current_profile: current_profile

        # Recipients are notified of the new message by the chat_message_created consumer
        # (lib/consumers/chat_message_created/broadcast_new_message), which runs in a
        # retryable background job. messages/create publishes that event on persist.
        #
        # The default rebroadcast-to-room (this partial doesn't echo "false") relays
        # context.params - the client's own message/media payload - verbatim to every
        # room subscriber for the live view. That's safe to keep as-is: the client
        # already has a signed, time-limited URL for each attachment from POST
        # /api/chat/uploads (modules/chat/commands/uploads/create), which is what it put
        # in context.params.media in the first place.
      endif
    endif
  else
    log "Skippind. Message will be persisted on sender side", 'channel_actions/conversate skip_message'
    echo "false"
  endif

%}
