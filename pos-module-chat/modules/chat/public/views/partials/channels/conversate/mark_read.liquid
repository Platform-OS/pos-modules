{% comment %}
  Called by the client when it renders a message live over the open channel
  subscription (see pos-chat.js `received`), so a participant who is actively
  viewing the conversation isn't left in the unread state that `receive.liquid`
  puts them in on every incoming message. Without this, the debounced push
  notification in message_notification_to_send/send_push_notification would
  fire even though the recipient already saw the message on screen.

  Re-checks participation independently, same as subscribed.liquid and
  receive.liquid - do not assume subscribed authorization carries over.
{% endcomment %}
{% liquid
  function current_profile = 'modules/user/helpers/current_profile'

  assign room_id = context.params.room_id
  function conversation = 'modules/chat/queries/conversations/find_by_participant', id: room_id, participant_id: current_profile.id, include_messages: null

  if conversation
    function _res = 'modules/chat/commands/conversations/mark_read', conversation: conversation, participant_id: current_profile.id
  else
    log 'Skipping mark_read: not a participant', 'channel_actions/conversate mark_read'
  endif
%}
