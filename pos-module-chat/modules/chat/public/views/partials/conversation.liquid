{% doc %}
  @param {number} id - conversation ID
  @param {boolean} [current] - whether this is the active conversation
  @param {string} name - display name of the participant
  @param {string} [image_src] - avatar image URL
  @param {string} [last_message] - last message text
  @param {string} [last_message_at] - when the last message was sent
  @param {string} [timezone] - timezone for date formatting
  @param {boolean} [unread] - whether this conversation has unread messages
{% enddoc %}


{% if current == false %}
  <a href="/inbox?conversation_id={{ id }}">
{% endif %}
    <div class="pos-chat-conversationCard {% if current %} pos-chat-conversationCard-active {% endif %} {% if unread %} pos-chat-conversationCard-unread {% endif %}">
      {% render 'modules/common-styling/user/avatar', size: 'l', name: name, image_src: image_src, class: null %}
        <span class="pos-chat-conversationCard-name">
          {{ name }}
        </span>
        {% if last_message %}
          <div class="pos-chat-conversationCard-lastMessage">
            <small>{{ last_message }}</small>
            {% if last_message_at %}
              <time datetime="{{ last_message_at }}">
                {{ last_message_at | strftime: "%b %d", timezone }}
              </time>
            {% endif %}
          </div>
        {% endif %}
    </div>
{% if current == false %}
  </a>
{% endif %}