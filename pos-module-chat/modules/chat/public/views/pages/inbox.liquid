---
slug: inbox
---
{% liquid
  function current_profile = 'modules/user/helpers/current_profile'

  # platformos-check-disable ConvertIncludeToRender, UnreachableCode, DeprecatedTag, MetadataParamsCheck
  include 'modules/user/helpers/can_do_or_unauthorized', requester: current_profile, do: 'chat.inbox', redirect_anonymous_to_login: true, entity: null, access_callback: null, forbidden_partial: null
  # platformos-check-enable ConvertIncludeToRender, UnreachableCode, DeprecatedTag, MetadataParamsCheck

  # The page only reads - it neither creates a conversation nor marks one read. The
  # session cookie is SameSite=Lax, so a link or redirect from another site (or a
  # prefetch) would otherwise do both on the user's behalf. A conversation that doesn't
  # exist yet is shown empty and created by POST api/chat/conversations once its first
  # message or attachment is sent, and the open conversation is marked read over the
  # WebSocket (see pos-chat.js).
  if context.params.conversation_id != blank
    function current_conversation = 'modules/chat/queries/conversations/find_by_participant', id: context.params.conversation_id, participant_id: current_profile.id, include_messages: true
  elsif context.params.to_uuid != blank
    function record = 'modules/chat/queries/records/find_by_uuid', uuid: context.params['to_uuid']
    if record and record.id != current_profile.id
      assign participant_ids = [current_profile.id, record.id] | sort
      function current_conversation = 'modules/chat/queries/conversations/find_by_participants', participant_ids: participant_ids, include_messages: true
      unless current_conversation
        assign current_conversation = { "participant_ids": participant_ids, "to_uuid": context.params.to_uuid, "messages": [] }
      endunless
    endif
  endif
  if current_conversation
    function presigned_upload = 'modules/chat/queries/uploads/presign', table: 'modules/chat/uploads', property: 'upload'
    assign context.presigned_upload = presigned_upload
  endif
  function conversations = 'modules/chat/queries/conversations/search_by_participant', participant_id: current_profile.id, limit: 30, page: 1

  if current_conversation and current_conversation.participants == blank
    graphql participants = 'modules/user/profiles/search', ids: current_conversation.participant_ids
    assign current_conversation.participants = participants.records.results
  endif

  render 'modules/chat/inbox', current_conversation: current_conversation, conversations: conversations, current_profile: current_profile
%}
