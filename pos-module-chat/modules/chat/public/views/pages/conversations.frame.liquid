---
layout: ''
---

{% doc %}
  Get conversations for given participant and return them in HTML

  @param {boolean} [read] - the cursor: `next_read` of the previous page
  @param {string} [before] - the cursor: `next_before` of the previous page
  @param {number} [per_page] - items per page (default: 30, at most 50)
  @param {string} [conversation_id] - the conversation open in the inbox, shown as the open one
{% enddoc %}


{% liquid
  function current_profile = 'modules/user/helpers/current_profile'

  # platformos-check-disable ConvertIncludeToRender, UnreachableCode, DeprecatedTag, MetadataParamsCheck
  include 'modules/user/helpers/can_do_or_unauthorized', requester: current_profile, do: 'chat.inbox', entity: null, access_callback: null, redirect_anonymous_to_login: null, forbidden_partial: null
  # platformos-check-enable ConvertIncludeToRender, UnreachableCode, DeprecatedTag, MetadataParamsCheck

  assign per_page = context.params.per_page | to_positive_integer: 30
  assign read = context.params.read
  assign before = context.params.before

  function conversations = 'modules/chat/queries/conversations/search_by_participant', read: read, before: before, limit: per_page, participant_id: current_profile.id

  # only highlights the card (the list is the current user's own conversations either way) -
  # pos-chat.js passes it when it reloads the list with a new message
  assign current = null
  if context.params.conversation_id != blank
    assign current = { "id": context.params.conversation_id }
  endif

  render 'modules/chat/conversations', conversations: conversations, current: current, current_profile: current_profile
%}
