{% liquid
  function current_profile = 'modules/user/helpers/current_profile'
  if current_profile.user
   # the people a chat can be started with, the same ones the inbox search finds
   function profiles = 'modules/chat/queries/participants/search', query: null, not_id: current_profile.id, limit: 50
  endif

  render 'index', current_profile: current_profile, profiles: profiles
%}