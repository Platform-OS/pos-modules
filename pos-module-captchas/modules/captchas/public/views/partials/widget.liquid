{% doc %}
  @description Renders a captcha widget for the active provider into a form.
  @param {string} site_key - The provider's public site key.
  @param {string} [provider] - Provider name; defaults to the CAPTCHA_DEFAULT_PROVIDER constant, else 'turnstile'.
  @param {object} [options] - Provider widget options, passed through to the provider partial.
{% enddoc %}
{%- liquid
  function active_provider = 'modules/captchas/helpers/default_provider', provider: provider
  case active_provider
    when 'turnstile'
      render 'modules/captchas/providers/turnstile/widget', site_key: site_key, options: options
    when 'hcaptcha'
      render 'modules/captchas/providers/hcaptcha/widget', site_key: site_key, options: options
    when 'recaptcha'
      render 'modules/captchas/providers/recaptcha/widget', site_key: site_key, options: options
    when 'recaptcha_v3'
      render 'modules/captchas/providers/recaptcha_v3/widget', site_key: site_key, options: options
    else
      # Unknown provider (typo in the provider argument or in CAPTCHA_DEFAULT_PROVIDER): surface
      # it instead of silently rendering no widget — otherwise the first symptom is a confusing
      # token_missing failure at submit time. Verification still fails closed either way.
      assign warning = 'modules/captchas/widget: unsupported provider ' | append: active_provider | append: ' - no widget rendered'
      log warning, type: 'error'
      echo '<!-- '
      echo warning | escape
      echo ' -->'
  endcase
-%}
