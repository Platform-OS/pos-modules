{% doc %}
  @description Resolve the active captcha provider name. Values are normalized — trimmed and
    lowercased — so an explicit 'Turnstile' or a CAPTCHA_DEFAULT_PROVIDER constant saved with
    stray whitespace/capitals still matches the provider registry.
  @param {string} [provider] Explicit provider name; used when present.
  @returns {string} provider — explicit value, else the CAPTCHA_DEFAULT_PROVIDER constant, else 'turnstile' (normalized).
{% enddoc %}
{% liquid
  assign resolved = provider | strip | downcase
  assign resolved = resolved | default: context.constants.CAPTCHA_DEFAULT_PROVIDER | strip | downcase
  assign resolved = resolved | default: 'turnstile'
  return resolved
%}
