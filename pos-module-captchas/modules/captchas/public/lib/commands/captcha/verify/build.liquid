{% doc %}
  @description Build phase for captcha verify: resolve provider, locate the token field, and normalize inputs.
  @param {object} object - raw input: { provider, secret, token, remote_ip, response_field_name }.
  @returns {object} normalized object with provider, token, secret, remote_ip, valid, errors.
{% enddoc %}
{% liquid
  function provider = 'modules/captchas/helpers/default_provider', provider: object.provider

  case provider
    when 'hcaptcha'
      assign default_field = 'h-captcha-response'
    when 'recaptcha'
      assign default_field = 'g-recaptcha-response'
    when 'recaptcha_v3'
      assign default_field = 'g-recaptcha-response'
    else
      assign default_field = 'cf-turnstile-response'
  endcase

  assign token_field = object.response_field_name | default: default_field
  assign token = object.token | default: context.params[token_field]

  assign empty_errors = '{}' | parse_json
  assign object = object | hash_merge: provider: provider, token: token, valid: true, errors: empty_errors
  return object
%}
