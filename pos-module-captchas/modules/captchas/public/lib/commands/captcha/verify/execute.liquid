{% doc %}
  @description Execute phase for captcha verify: dispatch to the active provider's verify command
    (one siteverify HTTP call), then apply the optional hostname allow-list check to the provider
    response. Only runs on an object that passed the check phase.
  @param {object} object - validated object: { provider, secret, token, remote_ip, expected_sitekey,
    expected_hostname, min_score, expected_action, errors }.
  @returns {object} object with success (boolean), response (hash), valid, and errors
    (plus score/action for reCAPTCHA v3).
{% enddoc %}
{% liquid
  case object.provider
    when 'turnstile'
      function object = 'modules/captchas/commands/captcha/providers/turnstile/verify', object: object
    when 'hcaptcha'
      function object = 'modules/captchas/commands/captcha/providers/hcaptcha/verify', object: object
    when 'recaptcha'
      function object = 'modules/captchas/commands/captcha/providers/recaptcha/verify', object: object
    when 'recaptcha_v3'
      function object = 'modules/captchas/commands/captcha/providers/recaptcha_v3/verify', object: object
    else
      # Fail closed: no provider branch ran, so the token was never verified against any
      # siteverify endpoint. Never leave object.valid true here — that would pass the captcha
      # without a verification call. Guards against the supported-provider list in check.liquid
      # drifting out of sync with these branches.
      function c = 'modules/captchas/helpers/errors_hash', errors: object.errors
      assign messages = 'modules/captchas/errors.unsupported_provider' | split: '|'
      assign object.errors = c | hash_merge: provider: messages
      assign object.success = false
      assign object.valid = false
      return object
  endcase

  if object.valid
    function hostname_allowed = 'modules/captchas/helpers/hostname_allowed', hostname: object.response.hostname, expected_hostname: object.expected_hostname
    unless hostname_allowed
      function c = 'modules/captchas/helpers/errors_hash', errors: object.errors
      assign messages = 'modules/captchas/errors.hostname_mismatch' | split: '|'
      assign object.errors = c | hash_merge: captcha: messages
      assign object.valid = false
    endunless
  endif

  return object
%}
