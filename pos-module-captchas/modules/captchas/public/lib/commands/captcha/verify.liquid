{% doc %}
  @description Verify a captcha token server-side and return a normalized pass/fail.
  @param {string} [provider] - provider name; defaults to CAPTCHA_DEFAULT_PROVIDER or 'turnstile'.
  @param {string} secret - provider secret key (server-side; read from a constant by the caller).
  @param {string} [token] - the widget token; defaults to the provider's field in context.params.
  @param {string} [response_field_name] - name of the form field the widget writes the token to;
    overrides the provider default (only needed when you set the widget's response_field_name option).
  @param {string} [remote_ip] - optional visitor IP forwarded to the provider.
  @param {string} [expected_sitekey] - hCaptcha only: the sitekey the token must have been issued
    for, forwarded to hCaptcha's siteverify. hCaptcha secrets are account-wide, so without this a
    token solved against another widget of the same account also verifies; pass it whenever the
    account has more than one sitekey. Turnstile/reCAPTCHA already bind tokens via per-widget secrets.
  @param {string} [expected_hostname] - optional hostname allow-list (single host or comma-separated,
    e.g. 'example.com,www.example.com'). When set, the provider response hostname must match one of
    them (exact, case-insensitive) or verification fails. Defends against tokens solved on another domain.
  @param {number} [min_score] - reCAPTCHA v3 only: minimum score required to pass (default 0.5).
  @param {string} [expected_action] - reCAPTCHA v3 only: action name to require against the response.
  @returns {object} { valid, success, provider, response, errors } (plus score/action for reCAPTCHA v3).
{% enddoc %}
{% liquid
  assign object = '{}' | parse_json
  assign object = object | hash_merge: provider: provider, secret: secret, token: token, response_field_name: response_field_name, remote_ip: remote_ip, expected_sitekey: expected_sitekey, expected_hostname: expected_hostname, min_score: min_score, expected_action: expected_action

  function object = 'modules/captchas/commands/captcha/verify/build', object: object
  function object = 'modules/captchas/commands/captcha/verify/check', object: object

  if object.valid == false
    return object
  endif

  case object.provider
    when 'turnstile'
      function object = 'modules/captchas/commands/captcha/providers/turnstile/verify', object: object
    when 'hcaptcha'
      function object = 'modules/captchas/commands/captcha/providers/hcaptcha/verify', object: object
    when 'recaptcha'
      function object = 'modules/captchas/commands/captcha/providers/recaptcha/verify', object: object
    when 'recaptcha_v3'
      function object = 'modules/captchas/commands/captcha/providers/recaptcha_v3/verify', object: object
    else
      # Fail closed: no provider branch ran, so the token was never verified against any
      # siteverify endpoint. Never leave object.valid true here — that would pass the captcha
      # without a verification call. Guards against the supported-provider list in check.liquid
      # drifting out of sync with these branches.
      function c = 'modules/captchas/helpers/errors_hash', errors: object.errors
      assign messages = 'captcha.errors.unsupported_provider' | split: '|'
      assign object.errors = c | hash_merge: provider: messages
      assign object.success = false
      assign object.valid = false
      return object
  endcase

  if object.valid
    if object.expected_hostname != blank
      assign actual_host = object.response.hostname | downcase
      assign allowed_hosts = object.expected_hostname | downcase | replace: ' ', '' | split: ','
      unless allowed_hosts contains actual_host
        function c = 'modules/captchas/helpers/errors_hash', errors: object.errors
        assign messages = 'captcha.errors.hostname_mismatch' | split: '|'
        assign object.errors = c | hash_merge: captcha: messages
        assign object.valid = false
      endunless
    endif
  endif

  return object
%}
