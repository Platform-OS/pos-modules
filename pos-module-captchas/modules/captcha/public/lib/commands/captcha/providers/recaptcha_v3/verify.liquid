{% doc %}
  @description Execute phase for reCAPTCHA v3: POST the token to siteverify (the shared reCAPTCHA
    endpoint) via api_call_send, then apply the v3 score/action checks. Passes only when the
    provider reports success, the score meets the threshold, and (if expected_action is given) the
    action matches.
  @param {object} object - validated object: { secret, token, remote_ip, errors, min_score, expected_action }.
    min_score defaults to 0.5; expected_action is optional.
  @returns {object} object with success (boolean), score (number), action (string), response (hash), valid, and errors.
{% enddoc %}
{% liquid
  assign payload = '{}' | parse_json
  assign payload = payload | hash_merge: secret: object.secret, token: object.token, remote_ip: object.remote_ip

  graphql result = 'modules/captcha/api_call/send', data: payload, name: 'modules/captcha/recaptcha_siteverify'

  assign call = result.api_call_send
  function c = 'modules/captcha/helpers/errors_hash', errors: object.errors

  if call.errors != blank
    assign messages = 'captcha.errors.request_failed' | split: '|'
    assign object.errors = c | hash_merge: captcha: messages
    assign object.success = false
    assign object.valid = false
    return object
  endif

  assign status = call.response.status
  if status != 200
    assign messages = 'captcha.errors.request_failed' | split: '|'
    assign object.errors = c | hash_merge: captcha: messages
    assign object.success = false
    assign object.valid = false
    return object
  endif

  # A 200 with a non-JSON body (provider outage, proxy error page) must fail closed as
  # request_failed rather than blow up in parse_json or turn into a misleading
  # verification_failed on a nil body.
  assign raw_body = call.response.body | strip
  assign first_char = raw_body | slice: 0, 1
  if first_char != '{'
    assign messages = 'captcha.errors.request_failed' | split: '|'
    assign object.errors = c | hash_merge: captcha: messages
    assign object.success = false
    assign object.valid = false
    return object
  endif
  assign body = raw_body | parse_json

  assign object.response = body
  assign object.success = body.success
  assign object.score = body.score
  assign object.action = body.action

  # `!= true` (not `== false`): a nil/missing success field must fail closed too — otherwise a
  # 200 JSON body without `success` would fall through to the score check and, with min_score 0,
  # pass without any provider verdict.
  if body.success != true
    assign messages = 'captcha.errors.verification_failed' | split: '|'
    assign object.errors = c | hash_merge: captcha: messages
    assign object.valid = false
    return object
  endif

  if object.expected_action != blank
    if body.action != object.expected_action
      assign messages = 'captcha.errors.action_mismatch' | split: '|'
      assign object.errors = c | hash_merge: captcha: messages
      assign object.valid = false
      return object
    endif
  endif

  assign threshold = object.min_score | default: 0.5 | plus: 0.0
  assign score = body.score | default: 0.0 | plus: 0.0

  if score >= threshold
    assign object.valid = true
  else
    assign messages = 'captcha.errors.low_score' | split: '|'
    assign object.errors = c | hash_merge: captcha: messages
    assign object.valid = false
  endif

  return object
%}
