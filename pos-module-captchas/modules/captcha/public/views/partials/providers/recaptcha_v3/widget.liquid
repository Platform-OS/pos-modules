{% doc %}
  @description Renders Google reCAPTCHA v3 (invisible, score-based) into a form. v3 has no visible
    widget: on form submit it runs grecaptcha.execute(), injects the resulting token into a hidden
    input, and resubmits the form. If the loader script has not finished loading yet, submission is
    held (not sent token-less) until grecaptcha is ready. The server-side verify thresholds the
    returned score and (optionally) checks the action — see the recaptcha_v3 verify command. The
    loader script is injected once per site key, so multiple widgets / multiple keys on one page are
    supported.
  @param {string} site_key - reCAPTCHA v3 public site key (a v3 key from the reCAPTCHA admin console;
    v3 has no universal test keys).
  @param {object} [options] - action (the v3 action name, default 'submit'; must match the
    expected_action passed to verify if you check it), response_field_name (hidden input name,
    default 'g-recaptcha-response').
{% enddoc %}
{%- liquid
  assign action_value = options['action'] | default: 'submit'
  assign response_field = options['response_field_name'] | default: 'g-recaptcha-response'
-%}
<script>
(function () {
  var thisScript = document.currentScript;
  var siteKey = {{ site_key | json }};
  var action = {{ action_value | json }};
  var fieldName = {{ response_field | json }};
  var form = thisScript && thisScript.closest ? thisScript.closest('form') : null;
  if (!form) { return; }

  var input = form.querySelector('input[name="' + fieldName + '"]');
  if (!input) {
    input = document.createElement('input');
    input.type = 'hidden';
    input.name = fieldName;
    form.appendChild(input);
  }

  if (!document.querySelector('script[data-recaptcha-v3="' + siteKey + '"]')) {
    var s = document.createElement('script');
    s.src = 'https://www.google.com/recaptcha/api.js?render=' + encodeURIComponent(siteKey);
    s.async = true;
    s.defer = true;
    s.setAttribute('data-recaptcha-v3', siteKey);
    document.head.appendChild(s);
  }

  var done = false;

  function submitForm() {
    done = true;
    if (typeof form.requestSubmit === 'function') { form.requestSubmit(); } else { form.submit(); }
  }

  function runChallenge() {
    grecaptcha.ready(function () {
      grecaptcha.execute(siteKey, { action: action }).then(function (token) {
        input.value = token;
        submitForm();
      });
    });
  }

  form.addEventListener('submit', function (e) {
    if (done) { return; }
    e.preventDefault();

    if (window.grecaptcha && window.grecaptcha.execute) {
      runChallenge();
      return;
    }

    // Loader script not ready yet: wait for it instead of submitting without a token.
    var waited = 0;
    var timer = setInterval(function () {
      if (window.grecaptcha && window.grecaptcha.execute) {
        clearInterval(timer);
        runChallenge();
      } else if (waited >= 10000) {
        // Give up after 10s and submit anyway so the user is not stuck; the server-side
        // verify then returns the friendly "challenge not completed" error.
        clearInterval(timer);
        submitForm();
      }
      waited += 200;
    }, 200);
  });
})();
</script>
