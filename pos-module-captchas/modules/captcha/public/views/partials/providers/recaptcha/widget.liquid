{% doc %}
  @description Renders the Google reCAPTCHA v2 widget (loader script + widget div) into a form.
    Targets reCAPTCHA v2 (checkbox or invisible), which yields a binary pass/fail like the other
    providers. reCAPTCHA v3 (score-based) is intentionally not covered by this uniform abstraction.
  @param {string} site_key - reCAPTCHA v2 public site key.
  @param {object} [options] - Widget options: theme (light|dark), size (normal|compact|invisible),
    tabindex, callback (JS fn name), expired_callback, error_callback, badge (bottomright|bottomleft|inline,
    for invisible), language (hl script param, applied on first load), class_name (extra CSS classes),
    html_id (id attribute).
{% enddoc %}
{%- unless context.exports.captcha.recaptcha_script_loaded -%}
<script src="https://www.google.com/recaptcha/api.js{% if options['language'] != blank %}?hl={{ options['language'] | url_encode }}{% endif %}" async defer></script>
{%- assign recaptcha_script_loaded = true -%}
{%- export recaptcha_script_loaded, namespace: 'captcha' -%}
{%- endunless -%}
<div class="g-recaptcha{% if options['class_name'] != blank %} {{ options['class_name'] }}{% endif %}"{% if options['html_id'] != blank %} id="{{ options['html_id'] }}"{% endif %} data-sitekey="{{ site_key }}"{% if options['theme'] != blank %} data-theme="{{ options['theme'] }}"{% endif %}{% if options['size'] != blank %} data-size="{{ options['size'] }}"{% endif %}{% if options['tabindex'] != blank %} data-tabindex="{{ options['tabindex'] }}"{% endif %}{% if options['callback'] != blank %} data-callback="{{ options['callback'] }}"{% endif %}{% if options['expired_callback'] != blank %} data-expired-callback="{{ options['expired_callback'] }}"{% endif %}{% if options['error_callback'] != blank %} data-error-callback="{{ options['error_callback'] }}"{% endif %}{% if options['badge'] != blank %} data-badge="{{ options['badge'] }}"{% endif %}></div>
