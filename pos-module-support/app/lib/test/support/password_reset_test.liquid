{% doc %}
  @param {object} contract - The test contract object
{% enddoc %}
{% liquid
  # the desk's own "Forgot your password?" (commands/auth/*); mail goes to this instance's stub
  assign stub = 'https://' | append: context.location.host | append: '/test/sendgrid-stub'
  function _ = 'modules/support/commands/settings/set', key: 'email_api_base_url', value: stub
  assign suffix = 8 | random_string | downcase

  function unknown = 'modules/support/commands/auth/send_password_link', email: 'nobody-here@example.com', hcaptcha_params: null
  function contract = 'modules/tests/assertions/equal', contract: contract, given: unknown, expected: false, field_name: 'unknown address sends nothing'

  assign email = 'reset-' | append: suffix | append: '@example.com'
  assign no_roles = []
  function user = 'modules/user/commands/user/create', first_name: 'Reset', last_name: 'Test', email: email, password: 'old-password-12345', roles: no_roles, hook_params: null
  assign typed = email | upcase | prepend: ' '
  function sent = 'modules/support/commands/auth/send_password_link', email: typed, hcaptcha_params: null
  function contract = 'modules/tests/assertions/equal', contract: contract, given: sent, expected: true, field_name: 'known address gets a link, whatever the capitals'

  function short = 'modules/support/commands/auth/set_password', user_id: user.id, password: 'short', password_confirmation: 'short'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: short.error, expected: 'modules/support/team.errors.password', field_name: 'fewer than 12 characters refused'
  function mismatch = 'modules/support/commands/auth/set_password', user_id: user.id, password: 'New-password-2026!', password_confirmation: 'New-password-2027!'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: mismatch.error, expected: 'modules/support/password.mismatch', field_name: 'different confirmation refused'
  function no_user = 'modules/support/commands/auth/set_password', user_id: null, password: 'New-password-2026!', password_confirmation: 'New-password-2026!'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: no_user.error, expected: 'modules/support/password.expired', field_name: 'no reset session refused'
  function saved = 'modules/support/commands/auth/set_password', user_id: user.id, password: 'New-password-2026!', password_confirmation: 'New-password-2026!'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: saved.valid, expected: true, field_name: 'new password saved'
  function signed = 'modules/user/commands/user/verify_password', email: email, password: 'New-password-2026!'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: signed.valid, expected: true, field_name: 'the new password is the one checked at sign-in'

  function _ = 'modules/support/commands/settings/set', key: 'email_api_base_url', value: null
%}
