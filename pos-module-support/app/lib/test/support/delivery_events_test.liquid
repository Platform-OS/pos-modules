{% doc %}
  @param {object} contract - The test contract object
{% enddoc %}
{% liquid
  function f = 'support_test_helpers/ticket_fixture', label: 'events'
  assign rows = []
  for i in (1..3)
    assign row = { "table": "modules/support/message", "properties": { "author_type": "agent", "visibility": "public", "kind": "message", "delivery_state": "sent" } }
    assign row.properties.ticket_id = f.ticket.id
    assign rows << row
  endfor
  graphql created = 'modules/support/records/create_many', records: rows
  assign first = created.records[0].id
  assign second = created.records[1].id
  assign third = created.records[2].id
  assign email = f.contact.emails.first

  assign batch = []
  assign e = { "event": "delivered" }
  assign e.support_message_id = first
  assign e.email = email
  assign batch << e
  assign e = { "event": "bounce", "type": "bounce", "reason": "550 mailbox unavailable" }
  assign e.support_message_id = second
  assign e.email = email
  assign batch << e
  assign e = { "event": "dropped", "reason": "Bounced Address" }
  assign e.support_message_id = third
  assign e.email = email
  assign batch << e
  assign e = { "event": "delivered", "email": "someone@example.com" }
  assign batch << e

  function events = 'modules/support/commands/email/providers/sendgrid/parse_events', events: batch
  function contract = 'modules/tests/assertions/equal', contract: contract, given: events.size, expected: 3, field_name: 'events without our id ignored'
  for event in events
    function _ = 'modules/support/commands/email/apply_event', event: event
  endfor

  graphql m = 'modules/support/messages/search', ticket_id: f.ticket.id, limit: 10
  assign states = {}
  for message in m.records.results
    assign states[message.id] = message.delivery_state
  endfor
  function contract = 'modules/tests/assertions/equal', contract: contract, given: states[first], expected: 'delivered', field_name: 'delivered'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: states[second], expected: 'bounced', field_name: 'bounced'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: states[third], expected: 'dropped', field_name: 'dropped'

  graphql c = 'modules/support/contacts/search', id: f.contact.id, limit: 1
  function contract = 'modules/tests/assertions/equal', contract: contract, given: c.records.results.first.bounced, expected: true, field_name: 'hard bounce flags contact'

  # a late "delivered" never undoes a bounce
  assign late = []
  assign e = { "event": "delivered" }
  assign e.support_message_id = second
  assign late << e
  function events = 'modules/support/commands/email/providers/sendgrid/parse_events', events: late
  function state = 'modules/support/commands/email/apply_event', event: events.first
  function contract = 'modules/tests/assertions/equal', contract: contract, given: state, expected: 'bounced', field_name: 'bounce kept'

  # the webhook queues batches (apply_events); a provider retry of the same
  # bounce changes nothing and logs no second failure
  assign again = []
  assign e = { "event": "bounce", "type": "bounce", "reason": "550 mailbox unavailable" }
  assign e.support_message_id = second
  assign e.email = email
  assign again << e
  function events = 'modules/support/commands/email/providers/sendgrid/parse_events', events: again
  assign events_json = events | json
  graphql before = 'modules/support/ticket_events/search', ticket_id: f.ticket.id, event_type: 'delivery_failed', actor_id: null, limit: 50
  function applied = 'modules/support/commands/email/apply_events', events_json: events_json
  function contract = 'modules/tests/assertions/equal', contract: contract, given: applied, expected: 1, field_name: 'batch job applies its events'
  graphql after = 'modules/support/ticket_events/search', ticket_id: f.ticket.id, event_type: 'delivery_failed', actor_id: null, limit: 50
  function contract = 'modules/tests/assertions/equal', contract: contract, given: after.records.total_entries, expected: before.records.total_entries, field_name: 'repeated bounce logs nothing new'

  # a second recipient (a CC) bouncing with the same reason: its own failure
  # row and its contact marked bounced, although the message state is unchanged
  assign cc_suffix = 8 | random_string | downcase
  assign cc_email = 'cc-bounce-' | append: cc_suffix | append: '@example.com'
  function cc_contact = 'modules/support/commands/contacts/find_or_create', email: cc_email, name: null
  assign cc_batch = []
  assign e = { "event": "bounce", "type": "bounce", "reason": "550 mailbox unavailable" }
  assign e.support_message_id = second
  assign e.email = cc_email
  assign cc_batch << e
  function events = 'modules/support/commands/email/providers/sendgrid/parse_events', events: cc_batch
  assign events_json = events | json
  function _ = 'modules/support/commands/email/apply_events', events_json: events_json
  graphql with_cc = 'modules/support/ticket_events/search', ticket_id: f.ticket.id, event_type: 'delivery_failed', actor_id: null, limit: 50
  assign added = with_cc.records.total_entries | minus: after.records.total_entries
  function contract = 'modules/tests/assertions/equal', contract: contract, given: added, expected: 1, field_name: 'second recipient with the same reason gets its own row'
  graphql c2 = 'modules/support/contacts/search', id: cc_contact.id, limit: 1
  function contract = 'modules/tests/assertions/equal', contract: contract, given: c2.records.results.first.bounced, expected: true, field_name: 'second recipient marked bounced'
  function _ = 'modules/support/commands/email/apply_events', events_json: events_json
  graphql cc_again = 'modules/support/ticket_events/search', ticket_id: f.ticket.id, event_type: 'delivery_failed', actor_id: null, limit: 50
  function contract = 'modules/tests/assertions/equal', contract: contract, given: cc_again.records.total_entries, expected: with_cc.records.total_entries, field_name: 'retried second-recipient bounce logs nothing new'

  # the webhook queues jobs of 100, at most 1000 events
  assign many = []
  for i in (1..250)
    assign e = { "message_ref": "0", "event": "deferred" }
    assign many << e
  endfor
  function jobs = 'modules/support/commands/email/queue_events', events: many
  function contract = 'modules/tests/assertions/equal', contract: contract, given: jobs, expected: 3, field_name: '250 events queue 3 jobs'
%}
