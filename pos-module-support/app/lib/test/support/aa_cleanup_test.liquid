{% doc %}
  Runs first (alphabetical order): removes what an earlier run left in the
  test fixtures department when it stopped before zz_cleanup, so every run
  starts from the same state.
  @param {object} contract - The test contract object
{% enddoc %}
{% liquid
  graphql d = 'modules/support/departments/search', inbound_local_part: 'testfixtures', limit: 1
  assign department_id = d.records.results.first.id
  if department_id
    # members an aborted test left active would take new fixture tickets
    graphql active = 'modules/support/team_members/search', state: 'active', limit: 200
    for member in active.records.results
      if member.department_ids contains department_id
        assign off = { "state": "disabled" }
        function off_props = 'modules/support/helpers/props', values: off
        # platformos-check-disable NestedGraphQLQuery
        graphql _ = 'modules/support/records/update', id: member.id, properties: off_props
        # platformos-check-enable NestedGraphQLQuery
      endif
    endfor
    function _ = 'modules/support/commands/team_members/forget'
    graphql cleaned = 'support_test_helpers/cleanup', department_id: department_id
    assign scope = []
    assign scope << department_id
    function _ = 'modules/support/commands/ticket_stats/recount', department_ids: scope, pairs: null
    graphql left = 'modules/support/tickets/search', department_ids: scope, limit: 1
    function contract = 'modules/tests/assertions/equal', contract: contract, given: left.records.total_entries, expected: 0, field_name: 'leftover fixture tickets removed'
  else
    function contract = 'modules/tests/assertions/true', contract: contract, value: true, field_name: 'nothing left over', object: null
  endif
%}
