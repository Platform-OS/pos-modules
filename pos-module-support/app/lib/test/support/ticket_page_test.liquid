{% doc %}
  @param {object} contract - The test contract object
{% enddoc %}
{%- capture composer_text -%}
Line a & b
see https://example.com/x
{%- endcapture -%}
{%- capture composer_html -%}
<p>Line a &amp; b<br />
see <a href="https://example.com/x">https://example.com/x</a></p>
{%- endcapture -%}
{% liquid
  function f = 'support_test_helpers/ticket_fixture', label: 'page'

  # GitHub link: wrong URL refused, issue URL links and sets Waiting on deploy
  function bad = 'modules/support/commands/escalation_links/create', ticket: f.ticket, url: 'https://example.com/issues/1', actor: f.actor
  function contract = 'modules/tests/assertions/equal', contract: contract, given: bad.valid, expected: false, field_name: 'non-GitHub url refused'
  # a second line must not slip through (^...$ matched any line)
  assign nl = '%0A' | url_decode
  assign smuggled = 'javascript:alert(1)' | append: nl | append: 'https://github.com/Platform-OS/pos-modules/issues/42'
  function bad_lines = 'modules/support/commands/escalation_links/create', ticket: f.ticket, url: smuggled, actor: f.actor
  function contract = 'modules/tests/assertions/equal', contract: contract, given: bad_lines.valid, expected: false, field_name: 'multi-line url refused'
  assign smuggled = 'https://github.com/Platform-OS/pos-modules/issues/42' | append: nl | append: 'javascript:alert(1)'
  function bad_lines = 'modules/support/commands/escalation_links/create', ticket: f.ticket, url: smuggled, actor: f.actor
  function contract = 'modules/tests/assertions/equal', contract: contract, given: bad_lines.valid, expected: false, field_name: 'url with a trailing line refused'
  function linked = 'modules/support/commands/escalation_links/create', ticket: f.ticket, url: 'https://github.com/Platform-OS/pos-modules/issues/42', actor: f.actor
  function contract = 'modules/tests/assertions/equal', contract: contract, given: linked.valid, expected: true, field_name: 'github url linked'
  function statuses = 'modules/support/queries/statuses/all'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: linked.ticket.status_id, expected: statuses.by_key.deploy.id, field_name: 'link sets waiting on deploy'
  graphql links = 'modules/support/escalation_links/search', ticket_id: f.ticket.id
  function contract = 'modules/tests/assertions/equal', contract: contract, given: links.records.results.first.issue_ref, expected: 'Platform-OS/pos-modules#42', field_name: 'issue ref stored'

  # saved reply: whitelisted variables only, other placeholders removed, values escaped
  # built from single braces: newer platformOS versions fill double braces inside a hash literal when it is assigned
  assign o = '{' | append: '{'
  assign c = '}' | append: '}'
  assign body = '<p>Hi ' | append: o | append: ' requester.first_name ' | append: c | append: ', ticket #' | append: o | append: 'ticket.number' | append: c | append: ' ' | append: o | append: ' context.constants ' | append: c | append: ' ' | append: o | append: ' brand.name ' | append: c | append: ' ' | append: o | append: ' agent.first_name ' | append: c | append: '</p>'
  assign reply = { "body_html": null }
  assign reply.body_html = body
  assign requester = { "name": "Ann <b>Example</b>" }
  assign ticket = { "number": 777, "subject": "S" }
  assign agent = { "first_name": "Sam" }
  assign brand = { "app_name": "Harbor" }
  function html = 'modules/support/commands/saved_replies/render', saved_reply: reply, ticket: ticket, requester: requester, agent: agent, brand: brand
  function contract = 'modules/tests/assertions/equal', contract: contract, given: html, expected: '<p>Hi Ann, ticket #777  Harbor Sam</p>', field_name: 'saved reply whitelist'
  assign requester = { "name": "<script>x</script> Smith" }
  function html = 'modules/support/commands/saved_replies/render', saved_reply: reply, ticket: ticket, requester: requester, agent: agent, brand: brand
  assign has_script = false
  if html contains '<script>'
    assign has_script = true
  endif
  function contract = 'modules/tests/assertions/equal', contract: contract, given: has_script, expected: false, field_name: 'saved reply values escaped'
  assign plain = { "body_html": "<p>Thanks, we are on it.</p>" }
  function html = 'modules/support/commands/saved_replies/render', saved_reply: plain, ticket: ticket, requester: requester, agent: agent, brand: brand
  function contract = 'modules/tests/assertions/equal', contract: contract, given: html, expected: '<p>Thanks, we are on it.</p>', field_name: 'saved reply without placeholders unchanged'

  # a note is never delivered as email
  function note = 'modules/support/commands/messages/create_note', ticket: f.ticket, body_html: '<p>secret</p>', mentioned_ids: null, actor: f.actor
  function sent = 'modules/support/commands/messages/deliver', message_id: note.message.id, attempt: 1, attachments: null
  function contract = 'modules/tests/assertions/equal', contract: contract, given: sent, expected: null, field_name: 'note not delivered'

  # composer text becomes escaped paragraphs with links
  function html = 'modules/support/helpers/text_to_html', text: composer_text
  function contract = 'modules/tests/assertions/equal', contract: contract, given: html, expected: composer_html, field_name: 'text to html'

  # a long conversation shows the newest 30 messages; "show earlier" loads all of them
  assign rows = []
  for i in (1..35)
    assign row = { "table": "modules/support/message", "properties": null }
    assign props = { "ticket_id": null, "author_type": "customer", "visibility": "public", "kind": "message", "body_text": null }
    assign props.ticket_id = f.ticket.id
    assign props.body_text = 'message ' | append: i
    assign row.properties = props
    assign rows << row
  endfor
  graphql _ = 'modules/support/records/create_many', records: rows
  graphql all = 'modules/support/messages/search', ticket_id: f.ticket.id, limit: 1
  assign total = all.records.total_entries
  function pd = 'modules/support/queries/tickets/page_data', ticket: f.ticket, member: f.actor.member, profile: null, all_messages: false
  function contract = 'modules/tests/assertions/equal', contract: contract, given: pd.messages.size, expected: 30, field_name: 'newest 30 messages shown'
  assign hidden = total | minus: 30
  function contract = 'modules/tests/assertions/equal', contract: contract, given: pd.earlier_messages, expected: hidden, field_name: 'earlier messages counted'
  function pd = 'modules/support/queries/tickets/page_data', ticket: f.ticket, member: f.actor.member, profile: null, all_messages: true
  function contract = 'modules/tests/assertions/equal', contract: contract, given: pd.messages.size, expected: total, field_name: 'show earlier loads every message'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: pd.earlier_messages, expected: 0, field_name: 'nothing hidden after show earlier'
%}
{%- liquid
  # the "Unverified sender" badge (PRD EM-10): shown when the checks failed,
  # not for a verified sender, not for older messages without a result
  assign unverified = { "id": "u1", "author_type": "customer", "body_text": "hi", "created_at": "2026-11-16T10:00:00Z", "auth_results": { "verified": false } }
  assign verified = { "id": "u2", "author_type": "customer", "body_text": "hi", "created_at": "2026-11-16T10:00:00Z", "auth_results": { "verified": true } }
  assign older = { "id": "u3", "author_type": "customer", "body_text": "hi", "created_at": "2026-11-16T10:00:00Z", "auth_results": {} }
  assign no_files = []
-%}
{%- capture shown_unverified -%}{% render 'modules/support/ticket/message_card', message: unverified, attachments: no_files, author: 'A', author_email: null, is_note: false %}{%- endcapture -%}
{%- capture shown_verified -%}{% render 'modules/support/ticket/message_card', message: verified, attachments: no_files, author: 'A', author_email: null, is_note: false %}{%- endcapture -%}
{%- capture shown_older -%}{% render 'modules/support/ticket/message_card', message: older, attachments: no_files, author: 'A', author_email: null, is_note: false %}{%- endcapture -%}
{%- liquid
  assign badge = 'pos-support-unverified'
  assign has_badge = false
  if shown_unverified contains badge
    assign has_badge = true
  endif
  function contract = 'modules/tests/assertions/true', contract: contract, value: has_badge, field_name: 'badge on an unverified sender', object: null
  assign wrong_badge = false
  if shown_verified contains badge or shown_older contains badge
    assign wrong_badge = true
  endif
  function contract = 'modules/tests/assertions/equal', contract: contract, given: wrong_badge, expected: false, field_name: 'no badge for verified or older messages'
  return contract
-%}
