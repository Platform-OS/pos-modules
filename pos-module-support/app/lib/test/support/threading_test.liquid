{% doc %}
  @param {object} contract - The test contract object
{% enddoc %}
{% liquid
  function _ = 'modules/support/commands/settings/set', key: 'inbound_domain', value: 'support-dev.platformos.com'
  function f = 'support_test_helpers/ticket_fixture', label: 'thread'
  assign ticket = f.ticket
  assign contact = f.contact

  # token match
  function address = 'modules/support/helpers/email_address', local_part: 'dob', number: ticket.number, address: null
  assign email = { "subject": "anything", "reference_ids": [], "to": [], "cc": [], "envelope_to": [] }
  assign email.envelope_to << address
  function m = 'modules/support/commands/inbound/match_ticket', email: email, contact: contact
  function contract = 'modules/tests/assertions/equal', contract: contract, given: m.reason, expected: 'token', field_name: 'token match reason'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: m.ticket.id, expected: ticket.id, field_name: 'token match ticket'

  # tampered token rejected
  assign tampered = 'dob+t.' | append: ticket.number | append: '.0000000000000000@support-dev.platformos.com'
  assign email = { "subject": "anything", "reference_ids": [], "to": [], "cc": [], "envelope_to": [] }
  assign email.envelope_to << tampered
  function m = 'modules/support/commands/inbound/match_ticket', email: email, contact: contact
  function contract = 'modules/tests/assertions/equal', contract: contract, given: m.reason, expected: 'new', field_name: 'tampered token rejected'

  # header match via In-Reply-To and via References only
  assign suffix = 8 | random_string
  assign our_id = '<support.thread.' | append: suffix | append: '@support-dev.platformos.com>'
  assign rows = []
  assign row = { "table": "modules/support/message", "properties": { "author_type": "agent", "visibility": "public", "kind": "message" } }
  assign row.properties.ticket_id = ticket.id
  assign row.properties.email_message_id = our_id
  assign rows << row
  graphql created = 'modules/support/records/create_many', records: rows
  assign email = { "subject": "Re: something", "reference_ids": [], "to": [], "cc": [], "envelope_to": ["dob@support-dev.platformos.com"] }
  assign email.in_reply_to = our_id
  function m = 'modules/support/commands/inbound/match_ticket', email: email, contact: contact
  function contract = 'modules/tests/assertions/equal', contract: contract, given: m.reason, expected: 'header', field_name: 'in-reply-to match'
  assign email = { "subject": "Re: something", "in_reply_to": "<unknown@example.com>", "to": [], "cc": [], "envelope_to": ["dob@support-dev.platformos.com"], "reference_ids": ["<older@example.com>"] }
  assign email.reference_ids << our_id
  function m = 'modules/support/commands/inbound/match_ticket', email: email, contact: contact
  function contract = 'modules/tests/assertions/equal', contract: contract, given: m.ticket.id, expected: ticket.id, field_name: 'references-only match'

  # a Message-ID found on more than three tickets is ignored
  assign shared = '<shared.' | append: suffix | append: '@example.com>'
  assign rows = []
  for i in (1..4)
    function other = 'support_test_helpers/ticket_fixture', label: 'shared'
    assign row = { "table": "modules/support/message", "properties": { "author_type": "customer", "visibility": "public", "kind": "message" } }
    assign row.properties.ticket_id = other.ticket.id
    assign row.properties.email_message_id = shared
    assign rows << row
  endfor
  graphql created = 'modules/support/records/create_many', records: rows
  assign email = { "subject": "Fwd: list", "reference_ids": [], "to": [], "cc": [], "envelope_to": ["dob@support-dev.platformos.com"] }
  assign email.in_reply_to = shared
  function m = 'modules/support/commands/inbound/match_ticket', email: email, contact: contact
  function contract = 'modules/tests/assertions/equal', contract: contract, given: m.reason, expected: 'new', field_name: 'message-id on many tickets ignored'

  # subject token: requester accepted, stranger rejected
  assign subject = 'Re: Fixture ticket [#' | append: ticket.number | append: ']'
  assign email = { "reference_ids": [], "to": [], "cc": [], "envelope_to": ["dob@support-dev.platformos.com"], "from": {} }
  assign email.subject = subject
  assign email.from.email = contact.emails.first
  # forged: the requester's address in From, but SPF fails and no DKIM
  assign email.auth = { "spf": "fail", "dkim": "none" }
  assign email.envelope_from = 'forger@evil.example'
  function m = 'modules/support/commands/inbound/match_ticket', email: email, contact: contact
  function contract = 'modules/tests/assertions/equal', contract: contract, given: m.reason, expected: 'new', field_name: 'subject refused when SPF/DKIM fail'
  # SPF pass for a different envelope domain is not enough either
  assign email.auth = { "spf": "pass", "dkim": "none" }
  function m = 'modules/support/commands/inbound/match_ticket', email: email, contact: contact
  function contract = 'modules/tests/assertions/equal', contract: contract, given: m.reason, expected: 'new', field_name: 'subject refused when SPF passes for another domain'
  # DKIM signed by the From domain
  assign from_domain = contact.emails.first | split: '@' | last
  assign email.auth.dkim = '{@' | append: from_domain | append: ' : pass}'
  function m = 'modules/support/commands/inbound/match_ticket', email: email, contact: contact
  function contract = 'modules/tests/assertions/equal', contract: contract, given: m.reason, expected: 'subject', field_name: 'subject accepted for requester'
  assign stranger_email = 'stranger-' | append: suffix | append: '@gmail.com'
  function stranger = 'modules/support/commands/contacts/find_or_create', email: stranger_email, name: null
  assign email.from.email = stranger_email
  # verified, but not a known sender of the ticket
  assign email.auth.dkim = '{@gmail.com : pass}'
  function m = 'modules/support/commands/inbound/match_ticket', email: email, contact: stranger
  function contract = 'modules/tests/assertions/equal', contract: contract, given: m.reason, expected: 'new', field_name: 'subject rejected for stranger'

  # sender_verified: aligned SPF or DKIM only
  assign v = { "from": { "email": "Ann@Example.com" }, "envelope_from": "bounce@mail.example.com", "auth": { "spf": "pass", "dkim": "none" } }
  function ok = 'modules/support/helpers/email/sender_verified', email: v
  function contract = 'modules/tests/assertions/equal', contract: contract, given: ok, expected: true, field_name: 'spf pass on a subdomain envelope verifies'
  assign v.envelope_from = 'bounce@badexample.com'
  function ok = 'modules/support/helpers/email/sender_verified', email: v
  function contract = 'modules/tests/assertions/equal', contract: contract, given: ok, expected: false, field_name: 'look-alike envelope domain does not verify'
  assign v.auth = { "spf": "softfail", "dkim": "{@evil.example : pass, @mail.example.com : pass}" }
  function ok = 'modules/support/helpers/email/sender_verified', email: v
  function contract = 'modules/tests/assertions/equal', contract: contract, given: ok, expected: true, field_name: 'dkim from a subdomain of the From domain verifies'
  assign v.auth = { "spf": null, "dkim": null }
  function ok = 'modules/support/helpers/email/sender_verified', email: v
  function contract = 'modules/tests/assertions/equal', contract: contract, given: ok, expected: false, field_name: 'no results do not verify'

  # merged ticket pointer followed
  function target = 'support_test_helpers/ticket_fixture', label: 'target'
  function merged = 'modules/support/commands/tickets/merge', source: ticket, target: target.ticket, actor: f.manager_actor
  function address = 'modules/support/helpers/email_address', local_part: 'dob', number: ticket.number, address: null
  assign email = { "subject": "anything", "reference_ids": [], "to": [], "cc": [], "envelope_to": [] }
  assign email.envelope_to << address
  function m = 'modules/support/commands/inbound/match_ticket', email: email, contact: contact
  function contract = 'modules/tests/assertions/equal', contract: contract, given: m.ticket.id, expected: target.ticket.id, field_name: 'merge pointer followed'

  # closed ticket gives a follow-up
  function closed = 'modules/support/commands/tickets/change_status', ticket: target.ticket, status_key: 'closed', actor: f.manager_actor
  function m = 'modules/support/commands/inbound/match_ticket', email: email, contact: contact
  function contract = 'modules/tests/assertions/equal', contract: contract, given: m.reason, expected: 'follow_up', field_name: 'closed gives follow-up'

  # a stranger matching only by a (guessable) header is not added as a CC;
  # one writing to the signed reply address is
  function _ = 'modules/support/commands/settings/set', key: 'email_provider', value: 'sendgrid'
  function g = 'support_test_helpers/ticket_fixture', label: 'guess'
  assign nl = '%0A' | url_decode
  assign guess_id = '<support.guess.' | append: suffix | append: '@support-dev.platformos.com>'
  assign rows = []
  assign row = { "table": "modules/support/message", "properties": { "author_type": "agent", "visibility": "public", "kind": "message" } }
  assign row.properties.ticket_id = g.ticket.id
  assign row.properties.email_message_id = guess_id
  assign rows << row
  graphql created = 'modules/support/records/create_many', records: rows
  assign stranger = 'stranger-' | append: suffix | append: '@elsewhere.example' | downcase
  assign raw = 'From: Stranger <' | append: stranger | append: '>' | append: nl | append: 'To: testfixtures@support-dev.platformos.com' | append: nl | append: 'Subject: Re: Fixture ticket' | append: nl | append: 'Message-ID: <stranger-' | append: suffix | append: '@elsewhere.example>' | append: nl | append: 'In-Reply-To: ' | append: guess_id | append: nl | append: nl | append: 'Send the invoice to me instead.' | append: nl
  function outcome = 'support_test_helpers/inbound_case', raw: raw, sender: stranger, to: null
  graphql p = 'modules/support/participants/search', ticket_id: g.ticket.id, email: stranger, role: null, limit: 1
  function contract = 'modules/tests/assertions/equal', contract: contract, given: p.records.total_entries, expected: 0, field_name: 'header-only stranger not added as cc'

  function token_address = 'modules/support/helpers/email_address', local_part: 'testfixtures', number: g.ticket.number, address: null
  assign colleague = 'colleague-' | append: suffix | append: '@elsewhere.example' | downcase
  assign raw = 'From: Colleague <' | append: colleague | append: '>' | append: nl | append: 'To: ' | append: token_address | append: nl | append: 'Subject: Re: Fixture ticket' | append: nl | append: 'Message-ID: <colleague-' | append: suffix | append: '@elsewhere.example>' | append: nl | append: nl | append: 'Adding myself.' | append: nl
  function outcome = 'support_test_helpers/inbound_case', raw: raw, sender: colleague, to: token_address
  graphql p = 'modules/support/participants/search', ticket_id: g.ticket.id, email: colleague, role: null, limit: 1
  function contract = 'modules/tests/assertions/equal', contract: contract, given: p.records.total_entries, expected: 1, field_name: 'reply-address sender added as cc'

  # two From lines: the first is shown, DKIM signed the last (a replayed,
  # signed mail with the victim's From added on top). Never verified, never
  # threaded by subject tag or headers.
  function requester_of_g = 'modules/support/queries/contacts/find', id: g.ticket.requester_id
  assign victim = requester_of_g.emails.first
  assign victim_domain = victim | split: '@' | last
  assign attacker = 'attacker-' | append: suffix | append: '@' | append: victim_domain
  assign raw = 'From: Victim <' | append: victim | append: '>' | append: nl | append: 'From: Attacker <' | append: attacker | append: '>' | append: nl | append: 'To: testfixtures@support-dev.platformos.com' | append: nl | append: 'Subject: Re: Fixture ticket [#' | append: g.ticket.number | append: ']' | append: nl | append: 'Message-ID: <two-from-' | append: suffix | append: '@elsewhere.example>' | append: nl | append: 'In-Reply-To: ' | append: guess_id | append: nl | append: nl | append: 'Send the invoice elsewhere.' | append: nl
  assign envelope = '{"to":["testfixtures@support-dev.platformos.com"],"from":"' | append: attacker | append: '"}'
  assign dkim = '{@' | append: victim_domain | append: ' : pass}'
  assign adapter_params = { "SPF": "pass" }
  assign adapter_params.email = raw
  assign adapter_params.envelope = envelope
  assign adapter_params.dkim = dkim
  function parsed = 'modules/support/commands/email/providers/sendgrid/parse_inbound', params: adapter_params
  function contract = 'modules/tests/assertions/equal', contract: contract, given: parsed.from_count, expected: 2, field_name: 'two From lines counted'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: parsed.from.email, expected: victim, field_name: 'first From is the shown sender'
  function two_from_verified = 'modules/support/helpers/email/sender_verified', email: parsed
  function contract = 'modules/tests/assertions/equal', contract: contract, given: two_from_verified, expected: false, field_name: 'two From lines are never verified'
  function m = 'modules/support/commands/inbound/match_ticket', email: parsed, contact: requester_of_g
  function contract = 'modules/tests/assertions/equal', contract: contract, given: m.reason, expected: 'new', field_name: 'two From lines thread by neither subject tag nor headers'
%}
