diff -ruN a/public/graphql/agents/setting_create.graphql b/public/graphql/agents/setting_create.graphql
--- a/public/graphql/agents/setting_create.graphql	1970-01-01 01:00:00.000000000 +0100
+++ b/public/graphql/agents/setting_create.graphql	2026-11-18 20:04:39.355962451 +0100
@@ -0,0 +1,13 @@
+mutation setting_create($user_id: String!, $client_id: String!, $disabled_tools: [String!]!) {
+  record: record_create(record: {
+    table: "modules/mcp/mcp_agent_setting"
+    properties: [
+      { name: "user_id", value: $user_id }
+      { name: "client_id", value: $client_id }
+      { name: "disabled_tools", value_array: $disabled_tools }
+    ]
+  }) {
+    id
+    disabled_tools: property_array(name: "disabled_tools")
+  }
+}
diff -ruN a/public/graphql/agents/settings_for_user.graphql b/public/graphql/agents/settings_for_user.graphql
--- a/public/graphql/agents/settings_for_user.graphql	1970-01-01 01:00:00.000000000 +0100
+++ b/public/graphql/agents/settings_for_user.graphql	2026-11-18 20:04:34.713982759 +0100
@@ -0,0 +1,24 @@
+query settings_for_user($user_id: String!, $client_id: String) {
+  # Every agent setting a person holds, or just one agent's when client_id is
+  # given. Scoped by user_id in the filter, so a caller can never read another
+  # person's agent settings even by guessing a client_id.
+  records(
+    per_page: 200
+    filter: {
+      table: { value: "modules/mcp/mcp_agent_setting" }
+      properties: [
+        { name: "user_id", value: $user_id }
+        { name: "client_id", value: $client_id }
+      ]
+    }
+    sort: [{ properties: { name: "client_id", order: ASC } }]
+  ) {
+    total_entries
+    results {
+      id
+      user_id: property(name: "user_id")
+      client_id: property(name: "client_id")
+      disabled_tools: property_array(name: "disabled_tools")
+    }
+  }
+}
diff -ruN a/public/graphql/agents/setting_update.graphql b/public/graphql/agents/setting_update.graphql
--- a/public/graphql/agents/setting_update.graphql	1970-01-01 01:00:00.000000000 +0100
+++ b/public/graphql/agents/setting_update.graphql	2026-11-18 20:04:48.268923645 +0100
@@ -0,0 +1,12 @@
+mutation setting_update($id: ID!, $disabled_tools: [String!]!) {
+  # `table` is given because record_update is keyed by id alone and platformOS
+  # does not refuse an id belonging to another table. Pass only an id read from
+  # modules/mcp/mcp_agent_setting (agents/settings_for_user), never a request param.
+  record: record_update(id: $id, record: {
+    table: "modules/mcp/mcp_agent_setting"
+    properties: [{ name: "disabled_tools", value_array: $disabled_tools }]
+  }) {
+    id
+    disabled_tools: property_array(name: "disabled_tools")
+  }
+}
diff -ruN a/public/graphql/agents/tokens_for_user.graphql b/public/graphql/agents/tokens_for_user.graphql
--- a/public/graphql/agents/tokens_for_user.graphql	1970-01-01 01:00:00.000000000 +0100
+++ b/public/graphql/agents/tokens_for_user.graphql	2026-11-18 20:04:56.460888195 +0100
@@ -0,0 +1,28 @@
+query tokens_for_user($user_id: String!) {
+  # A person's tokens, with the fields needed to group them into agents and to
+  # tell a usable token from a dead one. tokens/for_user is the operator
+  # console's narrower selection; this one adds client_id, last_used_at,
+  # allowed_tools and the refresh expiry.
+  records(
+    per_page: 200
+    filter: {
+      table: { value: "modules/mcp/mcp_token" }
+      properties: [{ name: "user_id", value: $user_id }]
+    }
+    sort: [{ id: { order: DESC } }]
+  ) {
+    total_entries
+    results {
+      id
+      created_at
+      user_id: property(name: "user_id")
+      label: property(name: "label")
+      status: property(name: "status")
+      kind: property(name: "kind")
+      client_id: property(name: "client_id")
+      last_used_at: property(name: "last_used_at")
+      allowed_tools: property_array(name: "allowed_tools")
+      refresh_expires_at: property_int(name: "refresh_expires_at")
+    }
+  }
+}
