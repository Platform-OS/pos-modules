diff -ruN a/public/lib/helpers/identity/agent_key.liquid b/public/lib/helpers/identity/agent_key.liquid
--- a/public/lib/helpers/identity/agent_key.liquid	1970-01-01 01:00:00.000000000 +0100
+++ b/public/lib/helpers/identity/agent_key.liquid	2026-11-18 20:04:22.347037199 +0100
@@ -0,0 +1,22 @@
+{%- comment -%}
+  The stable identity of the AGENT a token belongs to — the one definition.
+
+  A person's choices about an assistant (which tools it may use) are stored
+  against this key, and the call path checks against it. If the key were derived
+  in two places they could drift, and a switched-off tool would silently work
+  again, so both the panel and `identity/resolve_principal` call this.
+
+  The OAuth `client_id` when the token has one: it survives a refresh, where the
+  token row's digests rotate and a per-token choice would be lost. Otherwise the
+  human label, so two manual keys a person labelled the same way are one
+  assistant. Otherwise the principal itself, for an unlabelled manual token.
+
+  @param {object} token - an mcp_token row (needs client_id, label, user_id)
+  @return {string} the agent key, never blank for a token bound to a user
+{%- endcomment -%}
+{% liquid
+  assign fallback = 'user:' | append: token.user_id
+  assign key = token.label | default: fallback
+  assign key = token.client_id | default: key
+  return key
+%}
diff -ruN a/public/lib/queries/agents/for_user.liquid b/public/lib/queries/agents/for_user.liquid
--- a/public/lib/queries/agents/for_user.liquid	1970-01-01 01:00:00.000000000 +0100
+++ b/public/lib/queries/agents/for_user.liquid	2026-11-18 20:05:56.506634330 +0100
@@ -0,0 +1,92 @@
+{%- comment -%}
+  A person's agents, grouped from their tokens — what an app needs to draw a
+  panel without re-deriving any of it from the token table (TASK-57).
+
+  An agent is one or more tokens sharing an agent key
+  (helpers/identity/agent_key): every OAuth token of one client is the same
+  assistant, and so are two manual keys a person labelled the same way.
+
+  Only USABLE tokens count toward an agent. A revoked or suspended token is not
+  an assistant any more, and an OAuth grant whose refresh token has expired
+  cannot come back, so an agent with none left is not listed at all — the panel
+  shows what is connected now, not a history.
+
+  `status` is 'connected' once one of the agent's tokens has made a request, and
+  'waiting' until then, which is the difference between a key someone pasted
+  into a client and one they only generated.
+
+  @param {string} user_id - the person
+  @return {array} [{ client_id, name, kind, tokens, token_ids, last_used_at,
+                     status, disabled_tools }], newest agent first
+{%- endcomment -%}
+{% liquid
+  assign agents = []
+  if user_id == blank
+    return agents
+  endif
+
+  assign uid = user_id | append: ''
+  assign now_s = 'now' | to_time | strftime: '%s' | plus: 0
+  graphql found = 'modules/mcp/agents/tokens_for_user', user_id: uid
+  graphql settings = 'modules/mcp/agents/settings_for_user', user_id: uid
+  assign disabled_by_agent = {}
+  for row in settings.records.results
+    assign disabled_by_agent[row.client_id] = row.disabled_tools
+  endfor
+
+  assign none = []
+  assign order = []
+  assign by_key = {}
+  for token in found.records.results
+    unless token.status == 'active'
+      continue
+    endunless
+    if token.kind == 'oauth'
+      assign refresh_expires_at = token.refresh_expires_at | plus: 0
+      if refresh_expires_at <= now_s
+        continue
+      endif
+    endif
+
+    function key = 'modules/mcp/helpers/identity/agent_key', token: token
+    assign agent = by_key[key]
+    if agent == blank
+      # built inside the loop: a hash assigned once outside is shared by
+      # reference and every agent would end up the same one
+      assign agent = { "client_id": null, "tokens": 0 }
+      assign agent['client_id'] = key
+      assign agent['name'] = token.label | default: key
+      assign agent['kind'] = 'token'
+      if token.kind == 'oauth'
+        assign agent['kind'] = 'app'
+      endif
+      assign agent['token_ids'] = []
+      assign agent['last_used_at'] = null
+      assign disabled = disabled_by_agent[key]
+      assign agent['disabled_tools'] = disabled | default: none
+      assign order = order | array_add: key
+    endif
+    assign agent['tokens'] = agent.tokens | plus: 1
+    assign agent['token_ids'] = agent.token_ids | array_add: token.id
+    # the newest stamp wins. Compared only when both are present: a comparison
+    # against a missing stamp is not a comparison, it is a silent false
+    if token.last_used_at != blank
+      if agent.last_used_at == blank
+        assign agent['last_used_at'] = token.last_used_at
+      elsif token.last_used_at > agent.last_used_at
+        assign agent['last_used_at'] = token.last_used_at
+      endif
+    endif
+    assign by_key[key] = agent
+  endfor
+
+  for key in order
+    assign agent = by_key[key]
+    assign agent['status'] = 'waiting'
+    if agent.last_used_at != blank
+      assign agent['status'] = 'connected'
+    endif
+    assign agents = agents | array_add: agent
+  endfor
+  return agents
+%}
diff -ruN a/public/lib/queries/agents/tool_enabled.liquid b/public/lib/queries/agents/tool_enabled.liquid
--- a/public/lib/queries/agents/tool_enabled.liquid	1970-01-01 01:00:00.000000000 +0100
+++ b/public/lib/queries/agents/tool_enabled.liquid	2026-11-18 20:05:24.123769962 +0100
@@ -0,0 +1,56 @@
+{%- comment -%}
+  Has the person left this tool switched on for this agent? (TASK-57)
+
+  The decision that makes a per-agent switch real: it is consulted on the
+  execution path, not only where a list is built, so a tool a person switched
+  off cannot be called even by an agent that knows its name.
+
+  NO ROW MEANS EVERY TOOL. The stored value is the set that is switched OFF, so
+  a tool added to the registry after the person last visited their panel is
+  available rather than silently missing (see docs per-agent-tools-design).
+
+  This is on the hot path — once per tools/call, and once per tool in a
+  principal-scoped tools/list — so the person's whole set is read in ONE query
+  and memoised per request in context.exports, the pattern helpers/config and
+  queries/registry/load already use. commands/agents/set_tools clears the memo,
+  so a request that changes a switch sees its own change.
+
+  Blank user or agent key identifies nobody and therefore matches no stored
+  choice; the caller's own access rules still govern the call, which is the real
+  gate. An unknown tool name is not this query's business — the registry
+  decides what exists.
+
+  @param {string} user_id   - the principal's user id
+  @param {string} client_id - the agent key (helpers/identity/agent_key)
+  @param {string} tool_name - the tool being listed or called
+  @return {boolean} false only when the person switched this tool off
+{%- endcomment -%}
+{% liquid
+  if user_id == blank or client_id == blank or tool_name == blank
+    return true
+  endif
+
+  assign memo_key = user_id | append: '|' | append: client_id
+  # platformos-check-disable UnknownProperty
+  assign by_agent = context.exports.mcp_agent_settings.by_agent | default: {}
+  # platformos-check-enable UnknownProperty
+  # The memo holds a hash, not the array itself: "nothing switched off" is an
+  # empty array, which is indistinguishable from a memo miss, and an agent with
+  # no row would be re-queried once per tool.
+  assign entry = by_agent[memo_key]
+
+  if entry == blank
+    graphql res = 'modules/mcp/agents/settings_for_user', user_id: user_id, client_id: client_id
+    assign row = res.records.results.first
+    assign none = []
+    assign entry = { "disabled": null }
+    assign entry['disabled'] = row.disabled_tools | default: none
+    assign by_agent[memo_key] = entry
+    export by_agent, namespace: 'mcp_agent_settings'
+  endif
+
+  if entry.disabled contains tool_name
+    return false
+  endif
+  return true
+%}
diff -ruN a/public/lib/queries/approval/enforced.liquid b/public/lib/queries/approval/enforced.liquid
--- a/public/lib/queries/approval/enforced.liquid	1970-01-01 01:00:00.000000000 +0100
+++ b/public/lib/queries/approval/enforced.liquid	2026-11-18 20:37:21.565959057 +0100
@@ -0,0 +1,47 @@
+{%- comment -%}
+  Is the human-in-the-loop gate enforced for this call? (spec §9.6)
+
+  Two sources, in order:
+
+  1. The app's approval partial (config.approval_partial, default
+     'mcp/approval'), when it exists. An app that lets its own admins turn the
+     gate on and off keeps that switch in its own settings and answers here, so
+     the engine never has to be told to read an app's table.
+  2. config.approval_enforced, the instance-wide default, for an app that
+     provides no partial.
+
+  FAIL-SAFE. Only an explicit `false` from either source turns the gate off. A
+  missing partial, one that errors, and any other answer all leave it ON: the
+  wrong direction to fail here is to execute something nobody agreed to.
+
+  Read per request, never from the registry cache: the built registry is cached
+  for up to five minutes, so a manifest deciding this for itself would keep
+  executing ungated for minutes after an operator turned the gate back on.
+
+  @param {object} cfg - the resolved config (helpers/config)
+  @return {boolean} true when a requires_approval tool must wait for a person
+{%- endcomment -%}
+{% liquid
+  assign partial = cfg.approval_partial | default: 'mcp/approval'
+  assign answer = null
+  try
+    function answer = partial
+  catch e
+    unless e.message contains "can't find partial"
+      log e.message, type: 'mcp.approval_partial_error'
+    endunless
+    assign answer = null
+  endtry
+
+  if answer.enforced == false
+    return false
+  endif
+  if answer.enforced == true
+    return true
+  endif
+
+  if cfg.approval_enforced == false
+    return false
+  endif
+  return true
+%}
