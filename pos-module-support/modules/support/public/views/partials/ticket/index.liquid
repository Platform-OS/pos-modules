{% doc %}
  Ticket page (05 §3): header, conversation with the composer, properties pane.
  @param {object} data - From queries/tickets/page_data
{% enddoc %}
{% liquid
  assign ticket = data.ticket
  assign status = data.statuses.by_id[ticket.status_id]
  assign action = '/support-desk/tickets/' | append: ticket.id
  assign update_action = action | append: '/update'
  assign message_action = action | append: '/messages'
  assign department = null
  for d in data.departments
    if d.id == ticket.department_id
      assign department = d
    endif
  endfor
  assign from_address = department.from_address | default: department.public_address
  assign requester_email = data.requester.emails.first
%}
<div class="pos-support-ticket" data-support-live data-support-ticket="{{ ticket.id }}" data-support-me="{{ data.me }}" data-support-viewing="{{ 'modules/support/live.viewing' | t }}" data-support-replying="{{ 'modules/support/live.replying' | t }}" data-support-assigned-to-you="{{ 'modules/support/live.assigned_to_you' | t }}">
  <header class="pos-support-ticket-head">
    <nav class="pos-support-crumbs" aria-label="{{ 'modules/support/ticket.breadcrumb' | t }}">
      <a href="/support-desk">{% render 'modules/support/icon', name: 'arrow-left', size: 'sm' %}{{ 'modules/support/ticket.back' | t }}</a>
      <span aria-hidden="true">/</span>
      <span class="pos-support-number">#{{ ticket.number }}</span>
    </nav>
    <div class="pos-support-ticket-title">
      {% render 'modules/support/badges/priority', priority: ticket.priority %}
      <h1 class="pos-support-title">{{ ticket.subject }}</h1>
    </div>
    <p class="pos-support-ticket-badges">
      {% render 'modules/support/badges/status', status: status %}
      {% if department %}<span class="pos-tag" title="{{ department.name }}">{% render 'modules/support/icon', name: 'building-2', size: 'sm' %}{{ department.name }}</span>{% endif %}
      {% if ticket.needs_reply %}<span class="pos-support-needs-reply">{{ 'modules/support/queue.needs_reply' | t }}</span>{% endif %}
      {% if ticket.merged_into_id %}<span class="pos-tag">{% render 'modules/support/icon', name: 'git-merge', size: 'sm' %}{{ 'modules/support/ticket.merged' | t }}</span>{% endif %}
      {% if ticket.follow_up_of_id %}<a href="/support-desk/tickets/{{ ticket.follow_up_of_id }}">{{ 'modules/support/ticket.follow_up_of' | t }}</a>{% endif %}
      {% if ticket.snooze_until != blank %}<span class="pos-tag">{% render 'modules/support/icon', name: 'alarm-clock', size: 'sm' %}{{ 'modules/support/ticket.snoozed' | t }}</span>{% endif %}
      <span>{{ 'modules/support/ticket.opened' | t }} {% render 'modules/support/time', time: ticket.created_at, style: 'relative' %} · {{ data.requester.name | default: requester_email }}</span>
    </p>
    <p class="pos-support-presence" data-support-presence aria-live="polite" hidden></p>
  </header>

  <div class="pos-support-ticket-layout">
    <div class="pos-support-ticket-main">
      <section class="pos-support-thread" aria-label="{{ 'modules/support/ticket.conversation' | t }}">
        {% for message in data.messages %}
          {% render 'modules/support/ticket/message', message: message, attachments: data.attachments_by_message[message.id], requester: data.requester, profiles: data.profiles %}
        {% endfor %}
      </section>

      {% if ticket.merged_into_id == blank %}
        {% render 'modules/support/ticket/composer', data: data, action: action, message_action: message_action, department: department, from_address: from_address, requester_email: requester_email %}
      {% endif %}
    </div>

    {% render 'modules/support/ticket/side', data: data, ticket: ticket, status: status, update_action: update_action %}
  </div>
</div>
<script defer src="{{ 'modules/support/js/pos-support-ticket.js' | asset_url }}"></script>
<script type="module" src="{{ 'modules/support/js/pos-support-live.js' | asset_url }}"></script>
