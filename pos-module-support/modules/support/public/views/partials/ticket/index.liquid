{% doc %}
  Ticket page (05 §3): header, thread, composer and sidebar.
  @param {object} data - From queries/tickets/page_data
{% enddoc %}
{% liquid
  assign ticket = data.ticket
  assign status = data.statuses.by_id[ticket.status_id]
  assign action = '/support-desk/tickets/' | append: ticket.id
  assign update_action = action | append: '/update'
  assign message_action = action | append: '/messages'
%}
<div class="pos-support-ticket" data-support-live data-support-ticket="{{ ticket.id }}" data-support-me="{{ data.me }}" data-support-viewing="{{ 'modules/support/live.viewing' | t }}" data-support-replying="{{ 'modules/support/live.replying' | t }}" data-support-assigned-to-you="{{ 'modules/support/live.assigned_to_you' | t }}">
  <header class="pos-support-ticket-head">
    <p class="pos-supplementary"><a href="/support-desk">{{ 'modules/support/ticket.back' | t }}</a> · #{{ ticket.number }}</p>
    <h1 class="pos-heading-2">{{ ticket.subject }}</h1>
    <p class="pos-support-ticket-badges">
      {% render 'modules/support/badges/priority', priority: ticket.priority %}
      {% render 'modules/support/badges/status', status: status %}
      {% if ticket.needs_reply %}<span class="pos-support-needs-reply">{{ 'modules/support/queue.needs_reply' | t }}</span>{% endif %}
      {% if ticket.merged_into_id %}<span class="pos-supplementary">{{ 'modules/support/ticket.merged' | t }}</span>{% endif %}
      {% if ticket.follow_up_of_id %}<a class="pos-supplementary" href="/support-desk/tickets/{{ ticket.follow_up_of_id }}">{{ 'modules/support/ticket.follow_up_of' | t }}</a>{% endif %}
    </p>
    <p class="pos-supplementary pos-support-presence" data-support-presence aria-live="polite" hidden></p>
  </header>

  <div class="pos-support-ticket-layout">
    <div class="pos-support-ticket-main">
      <section class="pos-support-thread" aria-label="{{ 'modules/support/ticket.conversation' | t }}">
        {% for message in data.messages %}
          {% render 'modules/support/ticket/message', message: message, attachments: data.attachments_by_message[message.id], requester: data.requester, profiles: data.profiles %}
        {% endfor %}
      </section>

      {% if ticket.merged_into_id == blank %}
        <section class="pos-card pos-support-composer" aria-labelledby="pos-support-composer-title">
          <h2 id="pos-support-composer-title" class="pos-heading-3">{{ 'modules/support/ticket.respond' | t }}</h2>
          <form action="{{ message_action }}" method="post" class="pos-form" data-support-composer>
            <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
            <div class="pos-support-new-message" data-support-new-message role="alert" hidden>
              <p>{{ 'modules/support/live.new_message' | t }} <a href="{{ action }}">{{ 'modules/support/live.refresh' | t }}</a></p>
              <label><input type="checkbox" name="acknowledged" value="1"> {{ 'modules/support/live.acknowledge' | t }}</label>
            </div>
            <fieldset class="pos-support-composer-modes">
              <legend class="pos-support-sr-only">{{ 'modules/support/ticket.mode' | t }}</legend>
              <label><input type="radio" name="mode" value="reply" checked> {{ 'modules/support/ticket.reply' | t }}</label>
              <label><input type="radio" name="mode" value="note"> {{ 'modules/support/ticket.note' | t }}</label>
            </fieldset>
            {% if data.saved_replies.size > 0 %}
              <fieldset>
                <label for="pos-support-saved">{{ 'modules/support/ticket.saved_replies' | t }}</label>
                <select id="pos-support-saved" data-support-saved>
                  <option value="">{{ 'modules/support/ticket.choose_saved' | t }}</option>
                  {% for reply in data.saved_replies %}<option value="{{ reply.id }}" data-text="{{ reply.html | strip_html | strip }}">{{ reply.title }}</option>{% endfor %}
                </select>
              </fieldset>
            {% endif %}
            <fieldset>
              <label for="pos-support-body">{{ 'modules/support/ticket.message' | t }}</label>
              <textarea id="pos-support-body" name="body" rows="7" required></textarea>
            </fieldset>
            <fieldset data-support-reply-only>
              <label for="pos-support-cc">{{ 'modules/support/ticket.cc' | t }}</label>
              <input type="text" id="pos-support-cc" name="cc" placeholder="{{ 'modules/support/ticket.cc_placeholder' | t }}" autocomplete="off">
            </fieldset>
            <fieldset data-support-reply-only>
              <label for="pos-support-files">{{ 'modules/support/ticket.attach' | t }}</label>
              <input type="file" id="pos-support-files" multiple data-support-files aria-describedby="pos-support-files-help">
              <p id="pos-support-files-help" class="pos-supplementary">{{ 'modules/support/ticket.attach_help' | t }}</p>
              <div data-support-files-fields></div>
            </fieldset>
            <fieldset data-support-reply-only>
              <label for="pos-support-then">{{ 'modules/support/ticket.then' | t }}</label>
              <select id="pos-support-then" name="then_status">
                <option value="">{{ 'modules/support/ticket.then_keep' | t }}</option>
                {% for s in data.statuses.list %}{% if s.category != 'new' and s.active %}<option value="{{ s.key }}" {% if s.key == 'progress' %}selected{% endif %}>{{ s.label }}</option>{% endif %}{% endfor %}
              </select>
            </fieldset>
            <button type="submit" class="pos-button pos-button-primary">{{ 'modules/support/ticket.send' | t }}</button>
          </form>
        </section>
      {% endif %}
    </div>

    <aside class="pos-support-ticket-side" aria-label="{{ 'modules/support/ticket.details' | t }}">
      <section class="pos-card">
        <h2 class="pos-heading-3">{{ 'modules/support/ticket.details' | t }}</h2>
        <form action="{{ update_action }}" method="post" class="pos-form">
          <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
          <input type="hidden" name="change" value="properties">
          <fieldset>
            <label for="pos-support-side-status">{{ 'modules/support/queue.status' | t }}</label>
            <select id="pos-support-side-status" name="status_key">
              {% for s in data.statuses.list %}{% if s.active %}<option value="{{ s.key }}" {% if s.id == ticket.status_id %}selected{% endif %}>{{ s.label }}</option>{% endif %}{% endfor %}
            </select>
          </fieldset>
          <fieldset>
            <label for="pos-support-side-priority">{{ 'modules/support/queue.priority' | t }}</label>
            <select id="pos-support-side-priority" name="priority">
              {% assign priorities = "p0,p1,p2,p3" | split: ',' %}
              {% for p in priorities %}<option value="{{ p }}" {% if ticket.priority == p %}selected{% endif %}>{{ p | upcase }}</option>{% endfor %}
            </select>
          </fieldset>
          <fieldset>
            <label for="pos-support-side-assignee">{{ 'modules/support/queue.assignee' | t }}</label>
            <select id="pos-support-side-assignee" name="assignee_id">
              <option value="">{{ 'modules/support/ticket.unassigned' | t }}</option>
              {% for m in data.members %}<option value="{{ m.profile_id }}" {% if m.profile_id == ticket.assignee_id %}selected{% endif %}>{{ m.name }}</option>{% endfor %}
            </select>
          </fieldset>
          <fieldset>
            <label for="pos-support-side-department">{{ 'modules/support/queue.department' | t }}</label>
            <select id="pos-support-side-department" name="department_id">
              {% for d in data.departments %}{% if d.active or d.id == ticket.department_id %}<option value="{{ d.id }}" {% if d.id == ticket.department_id %}selected{% endif %}>{{ d.name }}</option>{% endif %}{% endfor %}
            </select>
          </fieldset>
          <fieldset>
            <label for="pos-support-side-tags">{{ 'modules/support/ticket.tags' | t }}</label>
            <input type="text" id="pos-support-side-tags" name="tags" value="{{ ticket.tags | join: ', ' }}">
          </fieldset>
          <button type="submit" class="pos-button">{{ 'modules/support/ticket.save' | t }}</button>
        </form>
      </section>

      <section class="pos-card">
        <h2 class="pos-heading-3">{{ 'modules/support/ticket.sla' | t }}</h2>
        <p class="pos-support-sla-{{ ticket.sla_state | default: 'none' }}">{{ ticket.sla_state | default: 'none' | prepend: 'modules/support/sla.' | t }}</p>
        {% if ticket.sla_first_reply_due_at and ticket.first_replied_at == blank %}<p class="pos-supplementary">{{ 'modules/support/ticket.first_reply_due' | t }} {{ ticket.sla_first_reply_due_at | l: 'long' }}</p>{% endif %}
        {% if ticket.sla_resolution_due_at %}<p class="pos-supplementary">{{ 'modules/support/ticket.resolution_due' | t }} {{ ticket.sla_resolution_due_at | l: 'long' }}</p>{% endif %}
      </section>

      <section class="pos-card">
        <h2 class="pos-heading-3">{{ 'modules/support/ticket.requester' | t }}</h2>
        <p><strong>{{ data.requester.name }}</strong><br>{{ data.requester.emails | join: ', ' }}</p>
        {% if data.organization %}<p>{{ data.organization.name }}</p>{% endif %}
        {% if data.participants.size > 0 %}
          <p class="pos-supplementary">{{ 'modules/support/ticket.cc' | t }}: {{ data.participants | map: 'email' | join: ', ' }}</p>
        {% endif %}
        {% if data.other_tickets.size > 0 %}
          <h3 class="pos-heading-4">{{ 'modules/support/ticket.other_tickets' | t }}</h3>
          <ul class="pos-support-plain-list">
            {% for other in data.other_tickets %}<li><a href="/support-desk/tickets/{{ other.id }}">#{{ other.number }} {{ other.subject }}</a></li>{% endfor %}
          </ul>
        {% endif %}
      </section>

      <section class="pos-card">
        <h2 class="pos-heading-3">{{ 'modules/support/ticket.engineering' | t }}</h2>
        {% for link in data.links %}
          <p><a href="{{ link.issue_url }}" target="_blank" rel="noopener noreferrer">{{ link.issue_ref }}</a></p>
        {% endfor %}
        <form action="{{ update_action }}" method="post" class="pos-form">
          <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
          <input type="hidden" name="change" value="link">
          <label for="pos-support-issue-url">{{ 'modules/support/ticket.issue_url' | t }}</label>
          <input type="url" id="pos-support-issue-url" name="issue_url" placeholder="https://github.com/owner/repo/issues/123" required>
          <button type="submit" class="pos-button">{{ 'modules/support/ticket.link' | t }}</button>
        </form>
      </section>

      {% if data.can_manage %}
        <section class="pos-card">
          <h2 class="pos-heading-3">{{ 'modules/support/ticket.merge' | t }}</h2>
          {% if ticket.merged_into_id %}
            <form action="{{ update_action }}" method="post">
              <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
              <input type="hidden" name="change" value="unmerge">
              <button type="submit" class="pos-button">{{ 'modules/support/ticket.unmerge' | t }}</button>
            </form>
          {% else %}
            <form action="{{ update_action }}" method="post" class="pos-form">
              <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
              <input type="hidden" name="change" value="merge">
              <label for="pos-support-merge-target">{{ 'modules/support/ticket.merge_into' | t }}</label>
              <input type="text" id="pos-support-merge-target" name="target_number" placeholder="#1234" required>
              <button type="submit" class="pos-button">{{ 'modules/support/ticket.merge' | t }}</button>
            </form>
          {% endif %}
        </section>
      {% endif %}

      <section class="pos-card">
        <h2 class="pos-heading-3">{{ 'modules/support/ticket.activity' | t }}</h2>
        <ol class="pos-support-plain-list pos-support-activity">
          {% for event in data.events %}
            {% liquid
              assign who = 'modules/support/ticket.system' | t
              if event.actor_type == 'user'
                assign actor_profile = data.profiles[event.actor_id]
                assign who = actor_profile.name | default: actor_profile.first_name | default: actor_profile.email
              elsif event.actor_type == 'customer'
                assign who = data.requester.name
              endif
              assign event_key = 'modules/support/activity.' | append: event.event_type
            %}
            <li><span>{{ who }}</span> {{ event_key | t: from: event.from_value, to: event.to_value }} <time class="pos-supplementary" datetime="{{ event.created_at }}">{{ event.created_at | l: 'long' }}</time></li>
          {% endfor %}
        </ol>
      </section>
    </aside>
  </div>
</div>
<script defer src="{{ 'modules/support/js/pos-support-ticket.js' | asset_url }}"></script>
<script type="module" src="{{ 'modules/support/js/pos-support-live.js' | asset_url }}"></script>
