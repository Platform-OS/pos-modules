{% doc %}
  The card of one timeline message: author line, body, delivery problem and
  attachments. Rendered directly (never through capture + html_safe, which
  turns escaped text back into markup).
  @param {object} message - Message record
  @param {object[]} [attachments] - Its attachments
  @param {string} author - Display name of the author
  @param {string} [author_email] - Author's address
  @param {boolean} is_note - Internal note
{% enddoc %}
{%- capture nl %}
{% endcapture -%}
<div class="pos-support-message-card">
  <header class="pos-support-message-head">
    <strong id="message-{{ message.id }}-author">{{ author }}</strong>
    {% if author_email != blank and author_email != author %}<span class="pos-support-muted">{{ author_email }}</span>{% endif %}
    {% if is_note %}
      <span class="pos-support-message-meta">{% render 'modules/support/icon', name: 'lock', size: 'sm' %}{{ 'modules/support/ticket.internal_note' | t }}</span>
    {% elsif message.author_type == 'customer' %}
      <span class="pos-support-message-meta">{% render 'modules/support/icon', name: 'arrow-down-left', size: 'sm' %}{{ 'modules/support/ticket.received' | t }}</span>
    {% else %}
      <span class="pos-support-message-meta pos-support-delivery pos-support-delivery-{{ message.delivery_state }}">{% render 'modules/support/icon', name: 'arrow-up-right', size: 'sm' %}{{ 'modules/support/ticket.delivery_' | append: message.delivery_state | t }}</span>
    {% endif %}
    {% render 'modules/support/time', time: message.created_at, style: 'datetime' %}
  </header>
  {% if message.author_type == 'customer' %}
    {%- liquid
      # each line is printed with {{ }}, which escapes it once; escape before that showed entities as text
      assign text = message.body_stripped | default: message.body_text | default: '' | replace_regex: '\r', ''
      assign lines = text | split: nl
    -%}
    <div class="pos-support-message-body">{% for line in lines %}{{ line }}{% unless forloop.last %}<br>{% endunless %}{% endfor %}</div>
    {% if message.body_html != blank %}
      {%- liquid
        # inline (cid:) images were stored as links to the desk's attachment page,
        # which needs the session; the sandboxed frame has none, so they point
        # at the file's short-lived signed URL instead
        assign original_html = message.body_html
        for attachment in attachments
          if attachment.file.url != blank
            assign local_url = '/support-desk/attachments/' | append: attachment.id
            assign quoted = '"' | append: local_url | append: '"'
            assign signed = '"' | append: attachment.file.url | append: '"'
            assign original_html = original_html | replace: quoted, signed
            assign quoted = "'" | append: local_url | append: "'"
            assign signed = "'" | append: attachment.file.url | append: "'"
            assign original_html = original_html | replace: quoted, signed
          endif
        endfor
      -%}
      <details class="pos-support-original">
        <summary>{{ 'modules/support/ticket.show_original' | t }}</summary>
        <iframe class="pos-support-html-frame" sandbox="allow-popups" referrerpolicy="no-referrer" title="{{ 'modules/support/ticket.original_title' | t }}" srcdoc="<base target='_blank'>{{ original_html }}"></iframe>
      </details>
    {% elsif message.body_stripped != blank and message.body_text != blank and message.body_stripped != message.body_text %}
      {%- comment -%} a plain-text email: the quoted history cut from the body stays readable here {%- endcomment -%}
      {%- assign full_lines = message.body_text | replace_regex: '\r', '' | split: nl -%}
      <details class="pos-support-original">
        <summary>{{ 'modules/support/ticket.show_full_email' | t }}</summary>
        <div class="pos-support-message-body pos-support-muted">{% for line in full_lines %}{{ line }}{% unless forloop.last %}<br>{% endunless %}{% endfor %}</div>
      </details>
    {% endif %}
  {% else %}
    <div class="pos-support-message-body">{{ message.body_html | sanitize }}</div>
  {% endif %}
  {% if message.delivery_state == 'failed' %}
    {% function delivery_error = 'modules/support/helpers/email/delivery_error', error: message.delivery_error %}
    <p class="pos-support-error">{{ 'modules/support/ticket.not_delivered' | t }} {{ delivery_error }}</p>
    {% unless attachments.size > 0 %}
      <form action="/support-desk/tickets/{{ message.ticket_id }}/update" method="post" class="pos-support-inline-form">
        <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
        <input type="hidden" name="change" value="retry">
        <input type="hidden" name="message_id" value="{{ message.id }}">
        <button type="submit" class="pos-button pos-button-small">{% render 'modules/support/icon', name: 'send', size: 'sm' %}{{ 'modules/support/ticket.retry' | t }}</button>
      </form>
    {% else %}
      <p class="pos-supplementary">{{ 'modules/support/ticket.retry_with_files' | t }}</p>
    {% endunless %}
  {% endif %}
  {% if attachments.size > 0 %}
    <ul class="pos-support-attachments" aria-label="{{ 'modules/support/ticket.attachments' | t }}">
      {% for attachment in attachments %}
        {% liquid
          function size_label = 'modules/support/helpers/filesize', bytes: attachment.size
        %}
        {% if attachment.file.url == blank %}
          <li class="pos-support-attachment-lost">{% render 'modules/support/icon', name: 'triangle-alert', size: 'sm' %}{{ attachment.filename }} <span>{{ size_label }} · {% if message.author_type == 'customer' %}{{ 'modules/support/ticket.attachment_not_stored' | t }}{% else %}{{ 'modules/support/ticket.own_attachment_not_stored' | t }}{% endif %}</span></li>
        {% else %}
          <li><a href="/support-desk/attachments/{{ attachment.id }}" rel="noopener">{% render 'modules/support/icon', name: 'paperclip', size: 'sm' %}{{ attachment.filename }} <span class="pos-support-muted">{{ size_label }}</span></a></li>
        {% endif %}
      {% endfor %}
    </ul>
  {% endif %}
</div>
