{% doc %}
  The card of one timeline message: author line, body, delivery problem and
  attachments. Rendered directly (never through capture + html_safe, which
  turns escaped text back into markup).
  @param {object} message - Message record
  @param {object[]} [attachments] - Its attachments
  @param {string} author - Display name of the author
  @param {string} [author_email] - Author's address
  @param {boolean} is_note - Internal note
{% enddoc %}
<div class="pos-support-message-card">
  <header class="pos-support-message-head">
    <strong id="message-{{ message.id }}-author">{{ author }}</strong>
    {% if author_email != blank and author_email != author %}<span class="pos-support-muted">{{ author_email }}</span>{% endif %}
    {% if is_note %}
      <span class="pos-support-message-meta">{% render 'modules/support/icon', name: 'lock', size: 'sm' %}{{ 'modules/support/ticket.internal_note' | t }}</span>
    {% elsif message.author_type == 'customer' %}
      <span class="pos-support-message-meta">{% render 'modules/support/icon', name: 'arrow-down-left', size: 'sm' %}{{ 'modules/support/ticket.received' | t }}</span>
    {% else %}
      <span class="pos-support-message-meta pos-support-delivery pos-support-delivery-{{ message.delivery_state }}">{% render 'modules/support/icon', name: 'arrow-up-right', size: 'sm' %}{{ 'modules/support/ticket.delivery_' | append: message.delivery_state | t }}</span>
    {% endif %}
    {% render 'modules/support/time', time: message.created_at, style: 'datetime' %}
  </header>
  {% if message.author_type == 'customer' %}
    <div class="pos-support-message-body">{{ message.body_stripped | default: message.body_text | escape | newline_to_br }}</div>
    {% if message.body_html != blank %}
      <details class="pos-support-original">
        <summary>{{ 'modules/support/ticket.show_original' | t }}</summary>
        <iframe class="pos-support-html-frame" sandbox="allow-popups" referrerpolicy="no-referrer" title="{{ 'modules/support/ticket.original_title' | t }}" srcdoc="<base target='_blank'>{{ message.body_html }}"></iframe>
      </details>
    {% endif %}
  {% else %}
    <div class="pos-support-message-body">{{ message.body_html | sanitize }}</div>
  {% endif %}
  {% if message.delivery_state == 'failed' %}
    <p class="pos-support-error">{{ 'modules/support/ticket.not_delivered' | t }} {{ message.delivery_error }}</p>
  {% endif %}
  {% if attachments.size > 0 %}
    <ul class="pos-support-attachments" aria-label="{{ 'modules/support/ticket.attachments' | t }}">
      {% for attachment in attachments %}
        <li><a href="/support-desk/attachments/{{ attachment.id }}" rel="noopener">{% render 'modules/support/icon', name: 'paperclip', size: 'sm' %}{{ attachment.filename }} <span class="pos-support-muted">{{ attachment.size | divided_by: 1024 }} KB</span></a></li>
      {% endfor %}
    </ul>
  {% endif %}
</div>
