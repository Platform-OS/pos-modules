{% doc %}
  Team email (invite, added, access requested, access decided). Inline CSS.
  @param {object} brand - From helpers/branding
  @param {string} heading - Heading line
  @param {string} body - Paragraph
  @param {string} [link] - Button URL
  @param {string} [link_label] - Button text
{% enddoc %}
<!DOCTYPE html>
<html lang="en">
  <body style="margin:0;padding:16px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.5;color:#1f2328;">
    <p style="margin:0 0 4px;color:#6b7280;font-size:12px;">{{ brand.app_name }}</p>
    <h1 style="margin:0 0 8px;font-size:18px;">{{ heading }}</h1>
    <p style="margin:0 0 16px;">{{ body }}</p>
    {% if link %}<p style="margin:0;"><a href="{{ link }}" style="display:inline-block;padding:8px 14px;border-radius:6px;background:{{ brand.theme_color | default: '#1f6feb' }};color:#ffffff;text-decoration:none;">{{ link_label }}</a></p>{% endif %}
  </body>
</html>
