{% doc %}
  @param {boolean} [failed] - Whether the last attempt failed
  @param {string} [email] - The email to prefill
{% enddoc %}
<section class="pos-support-gate" aria-labelledby="pos-support-sign-in-title">
  <div>
    <h1 id="pos-support-sign-in-title" class="pos-support-title">{{ 'modules/support/sign_in.title' | t }}</h1>
    <p class="pos-support-page-lede">{{ 'modules/support/sign_in.lede' | t }}</p>
  </div>
  {% if failed %}
    <p class="pos-support-callout pos-support-callout-danger" role="alert">{% render 'modules/support/icon', name: 'triangle-alert', size: null %}{{ 'modules/support/sign_in.invalid' | t }}</p>
  {% endif %}
  <form action="/support-desk/sign-in" method="post" class="pos-form">
    <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
    <fieldset>
      <label for="pos-support-email">{{ 'modules/support/sign_in.email' | t }}</label>
      <input type="email" name="email" id="pos-support-email" value="{{ email }}" autocomplete="username" spellcheck="false" required>
    </fieldset>
    <fieldset>
      <span class="pos-support-label-row">
        <label for="pos-support-password">{{ 'modules/support/sign_in.password' | t }}</label>
        <a href="/passwords/reset">{{ 'modules/support/sign_in.forgot' | t }}</a>
      </span>
      <input type="password" name="password" id="pos-support-password" autocomplete="current-password" required>
    </fieldset>
    <button type="submit" class="pos-button pos-button-primary">{{ 'modules/support/sign_in.submit' | t }}</button>
  </form>
</section>
