{% doc %}
  "Forgot your password?" form, or the confirmation after it was sent.
  @param {boolean} [sent] - The form was submitted
{% enddoc %}
<section class="pos-support-gate" aria-labelledby="pos-support-password-title">
  <div>
    <h1 id="pos-support-password-title" class="pos-support-title">{{ 'modules/support/password.title' | t }}</h1>
    {% unless sent %}<p class="pos-support-page-lede">{{ 'modules/support/password.lede' | t }}</p>{% endunless %}
  </div>
  {% if sent %}
    <p class="pos-support-callout" role="status">{% render 'modules/support/icon', name: 'mail', size: null %}{{ 'modules/support/password.sent' | t }}</p>
  {% else %}
    <form action="/support-desk/password" method="post" class="pos-form">
      <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
      <fieldset>
        <label for="pos-support-password-email">{{ 'modules/support/sign_in.email' | t }}</label>
        <input type="email" name="email" id="pos-support-password-email" autocomplete="username" spellcheck="false" required>
      </fieldset>
      <button type="submit" class="pos-button pos-button-primary">{{ 'modules/support/password.submit' | t }}</button>
    </form>
  {% endif %}
  <p><a href="/support-desk/sign-in">{{ 'modules/support/password.back' | t }}</a></p>
</section>
