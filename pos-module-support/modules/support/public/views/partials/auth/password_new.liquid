{% doc %}
  New-password form from a reset link, or the expired-link message.
  @param {boolean} valid - The link is usable
  @param {string} [error] - Translation key of a form error
{% enddoc %}
<section class="pos-support-gate" aria-labelledby="pos-support-password-new-title">
  {% if valid %}
    <div>
      <h1 id="pos-support-password-new-title" class="pos-support-title">{{ 'modules/support/password.new_title' | t }}</h1>
    </div>
    {% if error %}<p class="pos-support-callout pos-support-callout-danger" role="alert">{% render 'modules/support/icon', name: 'triangle-alert', size: null %}{{ error | t }}</p>{% endif %}
    <form action="/support-desk/password/new" method="post" class="pos-form">
      <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
      <fieldset>
        <label for="pos-support-new-password">{{ 'modules/support/password.new_password' | t }}</label>
        <input type="password" name="password" id="pos-support-new-password" minlength="12" autocomplete="new-password" required aria-describedby="pos-support-new-password-help">
        <p id="pos-support-new-password-help" class="pos-supplementary">{{ 'modules/support/team.password_help' | t }}</p>
      </fieldset>
      <fieldset>
        <label for="pos-support-new-password-confirm">{{ 'modules/support/password.confirm' | t }}</label>
        <input type="password" name="password_confirmation" id="pos-support-new-password-confirm" minlength="12" autocomplete="new-password" required>
      </fieldset>
      <button type="submit" class="pos-button pos-button-primary">{{ 'modules/support/password.save' | t }}</button>
    </form>
  {% else %}
    <div>
      <h1 id="pos-support-password-new-title" class="pos-support-title">{{ 'modules/support/password.expired_title' | t }}</h1>
      <p class="pos-support-page-lede">{{ 'modules/support/password.expired' | t }}</p>
    </div>
    <p><a class="pos-button pos-button-primary" href="/support-desk/password">{{ 'modules/support/password.again' | t }}</a></p>
  {% endif %}
</section>
