{% doc %}
  Settings sub-navigation.
  @param {string} current - Current section key
{% enddoc %}
{% assign sections = "departments,statuses,sla,saved-replies,assignment,team,blocklist,email,branding,integrations" | split: ',' %}
<nav class="pos-support-subnav" aria-label="{{ 'modules/support/settings.title' | t }}">
  {% for section in sections %}
    {% assign key = section | replace: '-', '_' %}
    <a href="/support-desk/settings/{{ section }}" {% if current == section %}aria-current="page"{% endif %}>{{ 'modules/support/settings.sections.' | append: key | t }}</a>
  {% endfor %}
</nav>
