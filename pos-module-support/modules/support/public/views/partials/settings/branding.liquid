{% doc %}
  Settings → Branding (08 §5): where the brand comes from, a preview and
  the overrides.
  @param {object} data - From queries/settings/section_data
{% enddoc %}
{% liquid
  assign brand = data.brand
  assign o = data.override
  assign theme_mode = o.theme_mode | default: 'auto'
  # appearance has its own control, so it does not count as a branding override
  assign appearance_keys = ["theme_mode"]
  assign brand_override = o | hash_except: appearance_keys
  assign using_host = true
  if brand_override.size > 0
    assign using_host = false
  endif
  assign host_keys = data.host_brand | hash_keys | join: ', '
  assign override_keys = brand_override | hash_keys | join: ', '
  assign modes = "auto,light,dark" | split: ','
  assign status = { "label": null, "color": "open" }
  assign status.label = 'modules/support/settings.preview_status' | t
%}
{% render 'modules/support/settings/nav', current: 'branding' %}
<div class="pos-support-steps">
  <h1 class="pos-heading-2">{{ 'modules/support/settings.sections.branding' | t }}</h1>

  <section class="pos-card pos-support-step" aria-labelledby="br-sources">
    <h2 id="br-sources" class="pos-heading-3">{{ 'modules/support/settings.brand_sources' | t }}</h2>
    <ul class="pos-support-plain-list">
      <li>{% if data.host_theme %}✓ {{ 'modules/support/settings.host_theme_found' | t }}{% else %}– {{ 'modules/support/settings.host_theme_missing' | t }}{% endif %}</li>
      <li>{% if data.host_brand.size > 0 %}✓ {{ 'modules/support/settings.host_hook_found' | t: keys: host_keys }}{% else %}– {{ 'modules/support/settings.host_hook_missing' | t }}{% endif %}</li>
      <li>{% if using_host %}– {{ 'modules/support/settings.no_overrides' | t }}{% else %}✓ {{ 'modules/support/settings.overrides_found' | t: keys: override_keys }}{% endif %}</li>
    </ul>
  </section>

  <section class="pos-card pos-support-step" aria-labelledby="br-preview">
    <h2 id="br-preview" class="pos-heading-3">{{ 'modules/support/settings.preview' | t }}</h2>
    <div class="pos-support-brand-preview">
      <div class="pos-support-rail pos-support-brand-preview-rail">
        <span class="pos-support-brand">
          {% if brand.logo_url %}<img class="pos-support-brand-logo" src="{{ brand.logo_url }}" alt="" width="128" height="32">{% else %}<span class="pos-support-brand-monogram" aria-hidden="true">{{ brand.initial }}</span>{% endif %}
          <span class="pos-support-brand-name">{{ brand.app_name }}</span>
        </span>
      </div>
      <div class="pos-support-brand-preview-body">
        <p><button type="button" class="pos-button pos-button-primary">{{ 'modules/support/settings.preview_button' | t }}</button> <a href="#br-preview">{{ 'modules/support/settings.preview_link' | t }}</a> {% render 'modules/support/badges/status', status: status %}</p>
        <p class="pos-supplementary">{{ 'modules/support/settings.preview_from' | t: name: brand.support_email_name }}</p>
      </div>
    </div>
  </section>

  <section class="pos-card pos-support-step" aria-labelledby="br-overrides">
    <h2 id="br-overrides" class="pos-heading-3">{{ 'modules/support/settings.overrides' | t }}</h2>
    <form action="/support-desk/settings/save" method="post" class="pos-form pos-support-settings-form">
      <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
      <input type="hidden" name="section" value="branding">
      <fieldset><label><input type="checkbox" name="use_host" value="true" {% if using_host %}checked{% endif %}> {{ 'modules/support/settings.use_host' | t }}</label></fieldset>
      <fieldset><label for="br-name">{{ 'modules/support/settings.app_name' | t }}</label><input id="br-name" name="app_name" value="{{ o.app_name }}" placeholder="{{ brand.app_name }}"></fieldset>
      <fieldset><label for="br-short">{{ 'modules/support/settings.short_name' | t }}</label><input id="br-short" name="short_name" value="{{ o.short_name }}" placeholder="{{ brand.short_name }}"></fieldset>
      <fieldset><label for="br-email-name">{{ 'modules/support/settings.email_name' | t }}</label><input id="br-email-name" name="support_email_name" value="{{ o.support_email_name }}" placeholder="{{ brand.support_email_name }}"></fieldset>
      <fieldset><label for="br-theme">{{ 'modules/support/settings.theme_color' | t }}</label><input id="br-theme" name="theme_color" value="{{ o.theme_color }}" placeholder="#1d4f91" pattern="#[0-9a-fA-F]{6}"></fieldset>
      <fieldset><label for="br-logo">{{ 'modules/support/settings.logo_url' | t }}</label><input id="br-logo" type="url" name="logo_url" value="{{ o.logo_url }}" placeholder="https://"></fieldset>
      <fieldset><label for="br-icon">{{ 'modules/support/settings.icon_url' | t }}</label><input id="br-icon" type="url" name="icon_url" value="{{ o.icon_url }}" placeholder="https://"></fieldset>
      <button type="submit" class="pos-button pos-button-primary">{{ 'modules/support/settings.save' | t }}</button>
    </form>
  </section>

  <section class="pos-card pos-support-step" aria-labelledby="br-appearance">
    <h2 id="br-appearance" class="pos-heading-3">{{ 'modules/support/settings.appearance' | t }}</h2>
    <p class="pos-supplementary">{{ 'modules/support/settings.appearance_help' | t }}</p>
    <form action="/support-desk/settings/save" method="post" class="pos-support-inline-form">
      <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
      <input type="hidden" name="section" value="branding">
      <input type="hidden" name="only" value="theme_mode">
      <fieldset class="pos-support-segmented">
        <legend class="pos-support-sr-only">{{ 'modules/support/settings.theme_mode' | t }}</legend>
        {% for m in modes %}<label><input type="radio" name="theme_mode" value="{{ m }}" {% if theme_mode == m %}checked{% endif %}>{{ 'modules/support/settings.mode_' | append: m | t }}</label>{% endfor %}
      </fieldset>
      <button type="submit" class="pos-button pos-button-primary" data-support-appearance-save>{{ 'modules/support/settings.save' | t }}</button>
    </form>
  </section>
</div>
