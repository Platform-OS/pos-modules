{% doc %}
  @param {object} [member] - The disabled or invited membership, if any
  @param {object} current_profile - The signed-in profile
{% enddoc %}
<section class="pos-card pos-support-gate" aria-labelledby="pos-support-no-access-title">
  <h1 id="pos-support-no-access-title" class="pos-heading-2">{{ 'modules/support/no_access.title' | t }}</h1>
  {% if member.state == 'disabled' %}
    <p>{{ 'modules/support/no_access.disabled' | t }}</p>
  {% elsif member.state == 'invited' %}
    <p>{{ 'modules/support/no_access.invited' | t }}</p>
  {% else %}
    <p>{{ 'modules/support/no_access.body' | t: email: current_profile.email }}</p>
  {% endif %}
</section>
