{% doc %}
  A board card with a "Move to" form that works without JavaScript; with
  JavaScript the form shows only while the card has keyboard focus.
  @param {object} ticket - Ticket record
  @param {object} lookup - From queries/tickets/lookup
  @param {object[]} statuses - Statuses offered in "Move to"
  @param {string} [group] - status (default) | priority: what "Move to" changes
{% enddoc %}
{% liquid
  assign requester = lookup.contacts[ticket.requester_id]
  assign assignee = lookup.profiles[ticket.assignee_id]
  assign department = lookup.departments[ticket.department_id]
  assign status = lookup.statuses[ticket.status_id]
  assign created = ticket.created_at | to_time | strftime: '%s'
  assign assignee_name = assignee.name | default: assignee.first_name | default: assignee.email
  assign at_risk = false
  if ticket.sla_state == 'overdue' or ticket.sla_state == 'due_soon'
    assign at_risk = true
  endif
%}
<article class="pos-support-card" draggable="true" data-ticket-id="{{ ticket.id }}" data-status-key="{{ status.key }}" data-priority="{{ ticket.priority }}" data-created="{{ created }}" aria-labelledby="card-{{ ticket.id }}">
  <p class="pos-support-card-meta">
    {% render 'modules/support/badges/priority', priority: ticket.priority %}
    <span class="pos-support-number">#{{ ticket.number }}</span>
    {% if at_risk %}
      {% render 'modules/support/badges/sla', state: ticket.sla_state %}
    {% elsif assignee %}
      {% render 'modules/support/avatar', name: assignee_name, email: assignee.email, size: 'xs', labelled: true %}
    {% endif %}
  </p>
  <h3 id="card-{{ ticket.id }}" class="pos-support-card-title"><a href="/support-desk/tickets/{{ ticket.id }}">{{ ticket.subject }}</a></h3>
  <p class="pos-support-card-meta">
    <span class="pos-tag" title="{{ department.name }}">{{ department.short_code | default: department.name }}</span>
    <span class="pos-support-card-requester">{{ requester.name | default: requester.emails.first }}</span>
    {% if at_risk and assignee %}{% render 'modules/support/avatar', name: assignee_name, email: assignee.email, size: 'xs', labelled: true %}{% endif %}
  </p>
  <form action="/support-desk/board/move" method="post" class="pos-support-move">
    <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
    <input type="hidden" name="ticket_id" value="{{ ticket.id }}">
    <label for="move-{{ ticket.id }}" class="pos-support-sr-only">{{ 'modules/support/board.move_to' | t }} #{{ ticket.number }}</label>
    {% if group == 'priority' %}
      {% assign priorities = "p0,p1,p2,p3" | split: ',' %}
      <select id="move-{{ ticket.id }}" name="priority">
        {% for p in priorities %}<option value="{{ p }}" {% if ticket.priority == p %}selected{% endif %}>{{ 'modules/support/priorities.' | append: p | t }}</option>{% endfor %}
      </select>
    {% else %}
      <select id="move-{{ ticket.id }}" name="status_key">
        {% for s in statuses %}{% if s.category != 'new' %}<option value="{{ s.key }}" {% if s.id == ticket.status_id %}selected{% endif %}>{{ s.label }}</option>{% endif %}{% endfor %}
      </select>
    {% endif %}
    <button type="submit" class="pos-button pos-button-small">{{ 'modules/support/board.move' | t }}</button>
  </form>
</article>
