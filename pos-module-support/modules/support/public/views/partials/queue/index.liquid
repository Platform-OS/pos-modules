{% doc %}
  Queue list (05 §3): header, filters, bulk form and the tickets in swim
  lanes, one per priority or status, each with a count and a toggle.
  @param {object} page_data - From helpers/queue_page
  @param {object} member - The signed-in team_member
  @param {string} return_to - Current URL, for the bulk form redirect
{% enddoc %}
{% liquid
  assign groups = page_data.groups
  assign link_query = page_data.query | append: '&group=' | append: page_data.group
  assign priorities = "p0,p1,p2,p3" | split: ','
  assign filters = page_data.filters
  assign filtered = false
  if filters.q != blank or filters.priority != blank or filters.status_key != blank or filters.assignee_id != blank
    assign filtered = true
  endif
%}
<div class="pos-support-queue" data-support-live data-support-group="{{ page_data.group }}" data-support-departments="{{ page_data.live_departments }}" data-support-me="{{ member.profile_id }}" data-support-first-page="true" data-support-assigned-to-you="{{ 'modules/support/live.assigned_to_you' | t }}" data-support-bulk-done="{{ 'modules/support/live.bulk_done' | t }}" data-support-bulk-failed="{{ 'modules/support/live.bulk_failed' | t }}">
  {% render 'modules/support/queue/head', page_data: page_data, member: member %}

  {% if groups.total == 0 %}
    {% liquid
      if filtered
        assign empty_title = 'modules/support/queue.empty_search' | t
        assign empty_text = 'modules/support/queue.empty_search_help' | t
        assign empty_url = '/support-desk?view=' | append: page_data.view
        assign empty_action = 'modules/support/queue.clear' | t
        assign empty_icon = 'search'
      else
        assign empty_title = 'modules/support/queue.empty' | t
        assign empty_text = 'modules/support/queue.empty_help' | t
        assign empty_url = null
        assign empty_action = null
        assign empty_icon = 'circle-check'
      endif
    %}
    <div class="pos-support-table-wrap">
      {% render 'modules/support/empty', icon: empty_icon, title: empty_title, text: empty_text, action_url: empty_url, action_label: empty_action %}
    </div>
  {% else %}
    <form method="post" action="/support-desk/tickets/bulk" class="pos-support-bulk-form pos-form" data-selected-template="{{ 'modules/support/queue.selected_template' | t }}" data-started-text="{{ 'modules/support/queue.bulk_started' | t }}" data-failed-text="{{ 'modules/support/queue.bulk_failed_request' | t }}">
      <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
      <input type="hidden" name="return_to" value="{{ return_to }}">
      <div class="pos-support-bulk-bar" role="group" aria-label="{{ 'modules/support/queue.bulk' | t }}" data-support-bulk-bar>
        <span class="pos-support-bulk-count" data-support-bulk-count aria-live="polite"></span>
        <label for="pos-support-bulk-assignee" class="pos-support-sr-only">{{ 'modules/support/queue.assignee' | t }}</label>
        <select id="pos-support-bulk-assignee" name="bulk_assignee">
          <option value="">{{ 'modules/support/queue.bulk_assignee' | t }}</option>
          <option value="me">{{ 'modules/support/queue.assign_me' | t }}</option>
          {% if page_data.can_manage %}
            <option value="none">{{ 'modules/support/queue.unassign' | t }}</option>
            {% for m in page_data.members %}{% if m.profile_id != member.profile_id %}<option value="{{ m.profile_id }}">{{ m.name }}</option>{% endif %}{% endfor %}
          {% endif %}
        </select>
        <label for="pos-support-bulk-status" class="pos-support-sr-only">{{ 'modules/support/queue.status' | t }}</label>
        <select id="pos-support-bulk-status" name="bulk_status">
          <option value="">{{ 'modules/support/queue.bulk_status' | t }}</option>
          {% for s in page_data.statuses %}{% if s.category != 'new' %}<option value="{{ s.key }}">{{ s.label }}</option>{% endif %}{% endfor %}
        </select>
        <label for="pos-support-bulk-priority" class="pos-support-sr-only">{{ 'modules/support/queue.priority' | t }}</label>
        <select id="pos-support-bulk-priority" name="bulk_priority">
          <option value="">{{ 'modules/support/queue.bulk_priority' | t }}</option>
          {% for p in priorities %}<option value="{{ p }}">{{ 'modules/support/priorities.' | append: p | t }}</option>{% endfor %}
        </select>
        <button type="submit" class="pos-button pos-button-primary">{{ 'modules/support/queue.bulk_apply' | t }}</button>
        <span class="pos-support-bulk-spacer"></span>
        <button type="submit" class="pos-button pos-button-danger" name="bulk_spam" value="1" data-support-confirm="{{ 'modules/support/queue.bulk_spam_confirm' | t }}">{% render 'modules/support/icon', name: 'ban', size: 'sm' %}{{ 'modules/support/blocklist.mark_spam' | t }}</button>
      </div>

      <div class="pos-support-table-wrap">
        <table class="pos-table pos-support-table">
          <colgroup>
            <col class="pos-support-col-select"><col class="pos-support-col-priority"><col class="pos-support-col-number"><col><col class="pos-support-col-requester"><col class="pos-support-col-department"><col class="pos-support-col-status"><col class="pos-support-col-assignee"><col class="pos-support-col-sla"><col class="pos-support-col-activity">
          </colgroup>
          <thead>
            <tr>
              <th scope="col"><span class="pos-support-sr-only">{{ 'modules/support/queue.select' | t }}</span></th>
              <th scope="col"><span class="pos-support-sr-only">{{ 'modules/support/queue.col_priority' | t }}</span></th>
              <th scope="col">#</th>
              <th scope="col">{{ 'modules/support/queue.col_subject' | t }}</th>
              <th scope="col">{{ 'modules/support/queue.col_requester' | t }}</th>
              <th scope="col">{{ 'modules/support/queue.col_department' | t }}</th>
              <th scope="col">{{ 'modules/support/queue.col_status' | t }}</th>
              <th scope="col">{{ 'modules/support/queue.col_assignee' | t }}</th>
              <th scope="col">{{ 'modules/support/queue.col_sla' | t }}</th>
              <th scope="col">{{ 'modules/support/queue.col_activity' | t }}</th>
            </tr>
          </thead>
          {% for group in groups.groups %}
            {% if group.total == 0 %}{% continue %}{% endif %}
            <tbody class="pos-support-lane" data-lane="{{ group.key }}">
              <tr class="pos-support-lane-head">
                <th colspan="10" scope="colgroup">
                  <button type="button" class="pos-support-lane-toggle" aria-expanded="true" data-support-lane-toggle>
                    {% render 'modules/support/icon', name: 'chevron-down', size: 'sm' %}
                    {% if group.priority %}
                      {% render 'modules/support/badges/priority', priority: group.priority %}
                      <span>{{ 'modules/support/priorities.name_' | append: group.priority | t }}</span>
                    {% else %}
                      {% render 'modules/support/badges/status', status: group.status %}
                    {% endif %}
                    <span class="pos-support-count-chip">{{ group.total }}</span>
                  </button>
                </th>
              </tr>
              {% for ticket in group.tickets %}
                {% render 'modules/support/queue/row', ticket: ticket, lookup: groups.lookup, link_query: link_query %}
              {% endfor %}
              {% if group.expanded and group.pages > 1 %}
                {% assign lane_url = '/support-desk?' | append: page_data.query | append: '&expand=' | append: group.key | append: '&lane_page=' %}
                <tr class="pos-support-lane-more">
                  <td colspan="10">
                    <nav class="pos-support-lane-pager" aria-label="{{ 'modules/support/queue.pages' | t }}">
                      <span class="pos-support-tnum">{{ 'modules/support/queue.range' | t: first: group.first, last: group.last, total: group.total }}</span>
                      {% if group.page > 1 %}<a href="{{ lane_url }}{{ group.page | minus: 1 }}" rel="prev">{{ 'modules/support/queue.previous' | t }}</a>{% endif %}
                      {% if group.page < group.pages %}<a href="{{ lane_url }}{{ group.page | plus: 1 }}" rel="next">{{ 'modules/support/queue.next' | t }}</a>{% endif %}
                    </nav>
                  </td>
                </tr>
              {% elsif group.expanded == false and group.total > group.tickets.size %}
                <tr class="pos-support-lane-more">
                  <td colspan="10"><a href="/support-desk?{{ page_data.query }}&expand={{ group.key }}&lane_page=1">{{ 'modules/support/queue.show_all' | t: count: group.total }}</a></td>
                </tr>
              {% endif %}
            </tbody>
          {% endfor %}
        </table>
      </div>
    </form>

    <div class="pos-support-pagination">
      <span class="pos-support-tnum">{{ 'modules/support/queue.total' | t: total: groups.total }}</span>
      <span class="pos-support-shortcuts">{{ 'modules/support/queue.shortcuts_html' | t }}</span>
    </div>
  {% endif %}
</div>
<script defer src="{{ 'modules/support/js/pos-support-queue.js' | asset_url }}"></script>
<script type="module" src="{{ 'modules/support/js/pos-support-live.js' | asset_url }}"></script>
