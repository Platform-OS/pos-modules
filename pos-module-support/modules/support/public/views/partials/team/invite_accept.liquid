{% doc %}
  Invite landing page (D-25): set a password and join (new account), join
  while signed in (existing account), or the generic "no longer valid"
  message for any problem.
  @param {boolean} valid - The link is usable
  @param {string} [invite_id] - The invite
  @param {string} [token] - Token from the link
  @param {string} [error] - Translation key of a form error
  @param {boolean} [used] - The link was already used (right token)
  @param {boolean} [existing] - The address already had an account
  @param {boolean} [sign_in_needed] - Existing account, not signed in to it
  @param {string} [invite_email] - The invited address
  @param {string} [signed_in_email] - The address of whoever is signed in, if anyone
{% enddoc %}
<section class="pos-card pos-support-gate" aria-labelledby="inv-title">
  {% if valid %}
    <h1 id="inv-title" class="pos-heading-2">{{ 'modules/support/team.invite_title' | t }}</h1>
    {% if error %}<p class="pos-support-error" role="alert">{{ error | t }}</p>{% endif %}
    {% if existing and sign_in_needed %}
      {% if signed_in_email != blank %}
        <p>{{ 'modules/support/team.invite_other_account' | t: email: signed_in_email, invited: invite_email }}</p>
        <form action="/sessions" method="post">
          <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
          <input type="hidden" name="_method" value="delete">
          <input type="hidden" name="redirect_to" value="/support-desk/sign-in">
          <button type="submit" class="pos-button pos-button-primary">{% render 'modules/support/icon', name: 'log-out', size: 'sm' %}{{ 'modules/support/shell.sign_out' | t }}</button>
        </form>
      {% else %}
        <p>{{ 'modules/support/team.invite_sign_in_help' | t: invited: invite_email }}</p>
        <p><a class="pos-button pos-button-primary" href="/support-desk/sign-in">{{ 'modules/support/team.sign_in' | t }}</a></p>
      {% endif %}
    {% elsif existing %}
      <p>{{ 'modules/support/team.invite_join_help' | t: invited: invite_email }}</p>
      <form action="/support-desk/invites/{{ invite_id }}" method="post" class="pos-form pos-support-settings-form">
        <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
        <input type="hidden" name="token" value="{{ token }}">
        <button type="submit" class="pos-button pos-button-primary">{{ 'modules/support/team.join' | t }}</button>
      </form>
    {% else %}
      <form action="/support-desk/invites/{{ invite_id }}" method="post" class="pos-form pos-support-settings-form">
        <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
        <input type="hidden" name="token" value="{{ token }}">
        <fieldset><label for="inv-name">{{ 'modules/support/team.your_name' | t }}</label><input id="inv-name" name="name" autocomplete="name" required></fieldset>
        <fieldset><label for="inv-password">{{ 'modules/support/team.choose_password' | t }}</label><input id="inv-password" type="password" name="password" minlength="12" autocomplete="new-password" required aria-describedby="inv-help"><p id="inv-help" class="pos-supplementary">{{ 'modules/support/team.password_help' | t }}</p></fieldset>
        <button type="submit" class="pos-button pos-button-primary">{{ 'modules/support/team.join' | t }}</button>
      </form>
    {% endif %}
  {% elsif used %}
    <h1 id="inv-title" class="pos-heading-2">{{ 'modules/support/team.invite_used' | t }}</h1>
    <p>{{ 'modules/support/team.invite_used_help' | t }}</p>
    <p><a class="pos-button pos-button-primary" href="/support-desk/sign-in">{{ 'modules/support/team.sign_in' | t }}</a></p>
  {% else %}
    <h1 id="inv-title" class="pos-heading-2">{{ 'modules/support/team.invite_invalid' | t }}</h1>
    <p>{{ 'modules/support/team.invite_invalid_help' | t }}</p>
  {% endif %}
</section>
