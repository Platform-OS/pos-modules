{% doc %}
  One row of the Settings → Team table.
  @param {object} member - The team_member
  @param {object} [person] - Its profile; none when the user was deleted
  @param {object[]} departments - All departments
{% enddoc %}
{% assign source_key = 'modules/support/team.sources.' | append: member.source %}
{% assign other_source = 'modules/support/team.sources.other' | t %}
{% if person %}
  {% function availability = 'modules/support/helpers/team/effective_availability', member: member, at: null %}
  <tr>
    <td>{{ person.name | default: person.email }}<br><span class="pos-supplementary">{{ person.email }}{% if member.job_title != blank %} · {{ member.job_title }}{% endif %}</span></td>
    <td>{{ 'modules/support/team.roles.' | append: member.role | t }}{% if member.on_duty_manager %} · {{ 'modules/support/team.on_duty' | t }}{% endif %}</td>
    <td>{% if member.role == 'admin' %}{{ 'modules/support/settings.all_departments' | t }}{% elsif member.role == 'agent' and member.department_ids == blank %}<span class="pos-tag">{{ 'modules/support/team.no_departments' | t }}</span>{% else %}{% for d in departments %}{% if member.department_ids contains d.id %}<span class="pos-tag">{{ d.short_code | default: d.name }}</span> {% endif %}{% endfor %}{% endif %}</td>
    <td>{{ 'modules/support/team.states.' | append: member.state | t }}</td>
    <td>{% if member.state == 'active' %}<span class="pos-support-presence-dot pos-support-presence-{{ availability }}"></span> {{ 'modules/support/availability.' | append: availability | t }}{% endif %}</td>
    <td>{{ source_key | t: default: other_source }}</td>
    <td><a href="/support-desk/settings/team?edit={{ member.id }}#tm-edit-section">{{ 'modules/support/settings.edit' | t }}</a> · <a href="/support-desk/settings/agents/{{ member.profile_id }}">{{ 'modules/support/team.alerts' | t }}</a></td>
  </tr>
{% else %}
  {% comment %} the user behind this membership was deleted: listed so it can be disabled {% endcomment %}
  <tr>
    <td><span class="pos-support-muted">{{ 'modules/support/team.deleted_user' | t }}</span></td>
    <td>{{ 'modules/support/team.roles.' | append: member.role | t }}</td>
    <td></td>
    <td>{{ 'modules/support/team.states.' | append: member.state | t }}</td>
    <td></td>
    <td>{{ source_key | t: default: other_source }}</td>
    <td><a href="/support-desk/settings/team?edit={{ member.id }}#tm-edit-section">{{ 'modules/support/settings.edit' | t }}</a></td>
  </tr>
{% endif %}
