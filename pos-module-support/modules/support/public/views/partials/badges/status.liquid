{% doc %}
  Status pill: semantic token per colour key plus an icon and text (never colour alone).
  @param {object} status - Status record (label, color)
{% enddoc %}
{% liquid
  assign color = status.color | default: 'open'
  assign icons = { "new": "sparkles", "open": "circle-dot", "pending": "clock", "onhold": "circle-pause", "onhold-eng": "rocket", "solved": "circle-check", "closed": "archive" }
%}
<span class="pos-support-badge pos-support-status pos-support-status-{{ color }}">{% render 'modules/support/icon', name: icons[color], size: null %}{{ status.label | default: '—' }}</span>
