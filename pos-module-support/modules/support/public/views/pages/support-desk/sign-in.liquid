---
slug: support-desk/sign-in
layout: modules/support/support
---
{% liquid
  function current_profile = 'modules/user/helpers/current_profile'
  if current_profile.user
    redirect_to '/support-desk'
    break
  endif

  assign reset = false
  if context.params.reset == '1'
    assign reset = true
  endif
  render 'modules/support/auth/sign_in', failed: false, email: null, locked: false, reset: reset
%}
