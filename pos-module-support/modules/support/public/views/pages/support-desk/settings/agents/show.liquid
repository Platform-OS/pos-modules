---
slug: support-desk/settings/agents/:profile_id
layout: modules/support/support
metadata:
  permission: support.team.manage
---
{% liquid
  # platformos-check-disable ConvertIncludeToRender, UnreachableCode
  include 'modules/support/helpers/require_member', permission: context.page.metadata.permission, ticket: null
  # platformos-check-enable ConvertIncludeToRender, UnreachableCode

  function member = 'modules/support/queries/team_members/find', profile_id: context.params.profile_id
  if member == blank
    response_status 404
    render 'modules/support/forbidden'
    break
  endif
  function availability = 'modules/support/helpers/team/effective_availability', member: member, at: null
  assign action = '/support-desk/settings/agents/' | append: member.profile_id
  assign ids = []
  assign ids << member.profile_id
  graphql p = 'modules/user/profiles/search', ids: ids, limit: 1
  assign person = p.records.results.first
  assign deleted = 'modules/support/team.deleted_user' | t
  assign name = person.name | default: person.email | default: deleted
  assign title = 'modules/support/profile.agent_title' | t: name: name
  export title, namespace: 'support_page'
  render 'modules/support/profile/index', member: member, subscriptions: null, effective: availability, editable: false, action: action, heading: title
%}
