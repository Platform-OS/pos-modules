---
slug: support-desk/board
layout: modules/support/support
metadata:
  permission: support.tickets.read
---
{% liquid
  # Direct link to the board of a view (All open by default). The queue page
  # shows the same board when the agent chooses the board layout.
  # platformos-check-disable ConvertIncludeToRender, UnreachableCode
  include 'modules/support/helpers/require_member', permission: context.page.metadata.permission, ticket: null
  # platformos-check-enable ConvertIncludeToRender, UnreachableCode

  assign member = context.exports.support.support_member
  function page_data = 'modules/support/helpers/queue_page', member: member, params: context.params, layout: 'board'

  assign nav = { "view": null, "counts": null, "departments": null, "filters": null }
  assign nav.view = page_data.view
  assign nav.counts = page_data.counts
  assign nav.departments = page_data.department_counts
  assign nav.filters = page_data.filters
  export nav, namespace: 'support_nav'
  assign title = 'modules/support/board.title' | t
  export title, namespace: 'support_page'

  render 'modules/support/board/index', page_data: page_data, member: member
%}
