---
slug: support-desk/assistants
layout: modules/support/support
metadata:
  permission: support.tickets.read
---
{% liquid
  # platformos-check-disable ConvertIncludeToRender, UnreachableCode
  include 'modules/support/helpers/require_member', permission: context.page.metadata.permission, ticket: null
  # platformos-check-enable ConvertIncludeToRender, UnreachableCode

  assign profile = context.exports.support.current_profile
  function data = 'modules/support/queries/mcp/panel_data', user_id: profile.user.id
  unless data.available
    # this desk has no MCP integration, so the page does not exist for it
    response_status 404
    render 'modules/support/forbidden'
    break
  endunless

  # the key of an assistant connected a moment ago, handed over in the session
  # by assistants/connect: it is shown once and never stored anywhere
  function fresh = 'modules/core/commands/session/get', key: 'support_assistant_key', clear: true

  # the desk-wide approval gate, and whether this member may change it
  assign member = context.exports.support.support_member
  function gate = 'modules/support/mcp/approval'
  function can_set_approval = 'modules/support/queries/team/can', member: member, do: 'support.settings.manage'

  assign title = 'modules/support/assistants.title' | t
  export title, namespace: 'support_page'
  render 'modules/support/assistants/index', assistants: data.assistants, tools: data.tools, fresh: fresh, require_approval: gate.enforced, can_set_approval: can_set_approval
%}
