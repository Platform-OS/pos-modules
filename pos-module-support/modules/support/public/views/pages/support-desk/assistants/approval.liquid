---
slug: support-desk/assistants/approval
method: post
layout: ''
metadata:
  permission: support.settings.manage
---
{% liquid
  # Which assistant actions need a person's approval. Desk-wide, so it takes
  # the settings permission: an agent manages their own assistants, an admin
  # decides what has to be agreed to before it happens.
  #
  # One change per control:
  #   change=all                every action
  #   change=tool, tool=<name>  one action
  # platformos-check-disable ConvertIncludeToRender, UnreachableCode
  include 'modules/support/helpers/require_member', permission: context.page.metadata.permission, ticket: null
  # platformos-check-enable ConvertIncludeToRender, UnreachableCode

  unless context.csrf_request_valid
    response_status 422
    render 'modules/support/forbidden'
    break
  endunless

  function available = 'modules/support/queries/mcp/available'
  unless available
    response_status 404
    render 'modules/support/forbidden'
    break
  endunless

  # `value` is the position the control is being moved to
  assign wants_approval = false
  if context.params.value == 'true'
    assign wants_approval = true
  endif

  function result = 'modules/support/commands/mcp/set_approval', change: context.params.change, tool: context.params.tool, value: wants_approval
  unless result.valid
    response_status 422
    render 'modules/support/forbidden'
    break
  endunless

  if context.params.change == 'all'
    if wants_approval
      function _ = 'modules/user/helpers/flash', notice: 'modules/support/assistants.approval_on', error: null, info: null, force_clear: null
    else
      function _ = 'modules/user/helpers/flash', notice: 'modules/support/assistants.approval_off', error: null, info: null, force_clear: null
    endif
  elsif wants_approval
    function _ = 'modules/user/helpers/flash', notice: 'modules/support/assistants.approval_tool_on', error: null, info: null, force_clear: null
  else
    function _ = 'modules/user/helpers/flash', notice: 'modules/support/assistants.approval_tool_off', error: null, info: null, force_clear: null
  endif
  redirect_to '/support-desk/assistants'
%}
