---
slug: support-desk/tickets/bulk
method: post
layout: ''
metadata:
  permission: support.tickets.reply
---
{% liquid
  # Bulk change from the queue. The change runs in background jobs of 20
  # tickets, so the page answers at once; the queue script posts with
  # respond=json and stays on the page, where the member's profile room
  # reports each chunk. Without JavaScript: a redirect with a flash message.
  # platformos-check-disable ConvertIncludeToRender, UnreachableCode
  include 'modules/support/helpers/require_member', permission: context.page.metadata.permission, ticket: null
  # platformos-check-enable ConvertIncludeToRender, UnreachableCode

  function form = 'modules/support/helpers/text_params', params: context.params, names: 'respond,return_to,bulk_assignee,bulk_status,bulk_priority,bulk_spam'
  assign wants_json = false
  if form.respond == 'json'
    assign wants_json = true
  endif
  assign target = form.return_to | default: '/support-desk'
  assign internal = target | matches: '^/support-desk(?:[/?#]|$)'
  assign backslash = '%5C' | url_decode
  if internal == false or target contains backslash
    assign target = '/support-desk'
  endif

  # ids: only numeric record ids from an ids[] list
  assign error = null
  assign ids = []
  assign posted_ids = context.params.ids
  if posted_ids.first != null
    for id in posted_ids
      assign text = id | append: ''
      assign numeric = text | matches: '^[0-9]+$'
      if text == id and numeric
        assign ids << id
      endif
    endfor
  endif
  assign ids = ids | uniq
  unless context.csrf_request_valid
    assign error = 'modules/support/queue.bulk_expired'
  endunless
  if error == blank and ids.size > 200
    assign error = 'modules/support/queue.bulk_too_many'
  endif

  assign body = { "ok": false, "error": null, "batch": null, "chunks": 0, "count": 0 }
  if error == blank and ids.size > 0
    assign member = context.exports.support.support_member
    assign spam = false
    assign assignee = form.bulk_assignee
    assign status_key = form.bulk_status
    assign priority = form.bulk_priority
    if form.bulk_spam == '1'
      assign spam = true
      assign assignee = null
      assign status_key = null
      assign priority = null
    endif
    assign batch = 16 | random_string
    assign chunks = ids.size | plus: 19 | divided_by: 20
    assign last = chunks | minus: 1
    for n in (0..last)
      assign offset = n | times: 20
      assign chunk = ids | slice: offset, 20
      background _ = 'modules/support/commands/tickets/bulk_job', source_name: 'support_bulk', priority: 'high', ids: chunk, assignee: assignee, status_key: status_key, ticket_priority: priority, spam: spam, profile_id: member.profile_id, batch: batch, chunks: chunks
    endfor
    assign body.ok = true
    assign body.batch = batch
    assign body.chunks = chunks
    assign body.count = ids.size
  endif

  if wants_json
    response_headers '{"Content-Type": "application/json"}'
    if error
      response_status 422
      assign body.error = error | t
    endif
    echo body | json | html_safe
    break
  endif
  unless context.csrf_request_valid
    response_status 422
    render 'modules/support/forbidden'
    break
  endunless
  if error
    function _ = 'modules/user/helpers/flash', error: error, notice: null, info: null, force_clear: null
  elsif body.ok
    function _ = 'modules/user/helpers/flash', info: 'modules/support/queue.bulk_started', notice: null, error: null, force_clear: null
  endif
  redirect_to target
%}
