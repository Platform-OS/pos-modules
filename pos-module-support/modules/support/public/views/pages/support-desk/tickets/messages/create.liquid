---
slug: support-desk/tickets/:id/messages
method: post
layout: ''
metadata:
  permission: support.tickets.reply
---
{% liquid
  # platformos-check-disable ConvertIncludeToRender, UnreachableCode
  include 'modules/support/helpers/require_member', permission: context.page.metadata.permission, ticket: null
  # platformos-check-enable ConvertIncludeToRender, UnreachableCode

  unless context.csrf_request_valid
    response_status 422
    render 'modules/support/forbidden'
    break
  endunless

  assign member = context.exports.support.support_member
  function ticket = 'modules/support/queries/tickets/find', id: context.params.id, number: null, member: member
  if ticket == blank
    response_status 404
    render 'modules/support/forbidden'
    break
  endif

  assign actor = { "type": "user" }
  assign actor.id = member.profile_id
  assign actor.member = member
  function form = 'modules/support/helpers/text_params', params: context.params, names: 'body,mode,cc,then_status'
  function body_html = 'modules/support/helpers/text_to_html', text: form.body
  if form.mode == 'note'
    function result = 'modules/support/commands/messages/create_note', ticket: ticket, body_html: body_html, mentioned_ids: null, actor: actor
  else
    assign cc_emails = form.cc | split: ','
    assign attachments = []
    # each attachment is a hash of three text fields; anything else is skipped
    for item in context.params.attachments
      function file = 'modules/support/helpers/text_params', params: item, names: 'filename,content_type,content_base64'
      if file.filename != blank and file.content_base64 != blank
        assign attachments << file
      endif
    endfor
    function result = 'modules/support/commands/messages/create_reply', ticket: ticket, body_html: body_html, cc_emails: cc_emails, then_status_key: form.then_status, attachments: attachments, actor: actor
  endif

  if result.valid
    function _ = 'modules/user/helpers/flash', notice: 'modules/support/ticket.sent', error: null, info: null, force_clear: null
  else
    assign error = result.errors.body | default: result.errors.attachments | default: 'modules/support/ticket.not_sent'
    function _ = 'modules/user/helpers/flash', error: error, notice: null, info: null, force_clear: null
  endif
  assign target = '/support-desk/tickets/' | append: ticket.id
  redirect_to target
%}
