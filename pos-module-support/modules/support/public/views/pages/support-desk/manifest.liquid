---
slug: support-desk/manifest.json
layout: ''
format: json
---
{% liquid
  # PWA manifest scoped to the desk (07 §4.1); brand from helpers/branding.
  function brand = 'modules/support/helpers/branding'
  assign icon_192 = 'modules/support/icons/icon-192.png' | asset_url
  assign icon_512 = 'modules/support/icons/icon-512.png' | asset_url
  assign manifest = { "id": "/support-desk", "scope": "/support-desk", "start_url": "/support-desk", "display": "standalone", "icons": [] }
  assign suffix = 'modules/support/pwa.suffix' | t
  assign manifest.name = brand.app_name | append: ' ' | append: suffix | strip
  assign manifest.short_name = brand.short_name | default: brand.app_name
  assign manifest.theme_color = brand.theme_color | default: '#175890'
  assign manifest.background_color = brand.background_color | default: '#ffffff'
  assign small = { "sizes": "192x192", "type": "image/png", "purpose": "any" }
  assign small.src = icon_192
  assign large = { "sizes": "512x512", "type": "image/png", "purpose": "any" }
  assign large.src = icon_512
  if brand.icon_url != blank
    assign host_icon = { "sizes": "512x512", "purpose": "any" }
    assign host_icon.src = brand.icon_url
    assign manifest.icons << host_icon
  endif
  assign manifest.icons << small
  assign manifest.icons << large
  echo manifest | json
%}
