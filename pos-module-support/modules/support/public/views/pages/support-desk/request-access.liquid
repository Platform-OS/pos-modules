---
slug: support-desk/request-access
method: post
layout: modules/support/support
---
{% liquid
  # "Request access" from the no-access page (D-24): signed-in non-members
  # only, so it cannot use the membership gate.
  unless context.csrf_request_valid
    response_status 422
    render 'modules/support/forbidden'
    break
  endunless
  function profile = 'modules/user/helpers/current_profile'
  if profile.user == null
    redirect_to '/support-desk/sign-in'
    break
  endif
  function result = 'modules/support/commands/team/request_access', profile: profile, note: context.params.note
  render 'modules/support/team/request_sent', result: result
%}
