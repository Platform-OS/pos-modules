---
slug: support-desk/approvals/count
layout: ''
format: json
metadata:
  permission: support.tickets.read
---
{% liquid
  # How many proposals are waiting for THIS member, for the pulsing count on the
  # Approvals rail entry. The desk shell renders the number when a page loads;
  # this is what keeps it current without the person reloading.
  #
  # The number is the member's own: queries/mcp/approvals applies department
  # scope and the agent-sees-only-their-own-tickets rule, so this endpoint
  # cannot be used to learn how busy another department is.
  # platformos-check-disable ConvertIncludeToRender, UnreachableCode
  include 'modules/support/helpers/require_member', permission: context.page.metadata.permission, ticket: null
  # platformos-check-enable ConvertIncludeToRender, UnreachableCode

  assign count = 0
  function available = 'modules/support/queries/mcp/available'
  if available
    assign member = context.exports.support.support_member
    function waiting = 'modules/support/queries/mcp/approvals', member: member
    assign count = waiting | size
  endif

  # The label is translated here rather than in the browser: the script would
  # otherwise have to carry the one/other wordings and pluralise them itself.
  assign body = { "waiting": 0 }
  assign body['waiting'] = count
  assign body['label'] = 'modules/support/approvals.waiting' | t: count: count
  echo body | json
%}
