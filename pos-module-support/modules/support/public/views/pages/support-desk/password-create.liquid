---
slug: support-desk/password
method: post
layout: modules/support/support
---
{% liquid
  unless context.csrf_request_valid
    response_status 422
    render 'modules/support/auth/password_request', sent: false
    break
  endunless
  function form = 'modules/support/helpers/text_params', params: context.params, names: 'email'
  function _ = 'modules/support/commands/auth/send_password_link', email: form.email, hcaptcha_params: context.params
  # the same confirmation whether or not the address has an account
  render 'modules/support/auth/password_request', sent: true
%}
