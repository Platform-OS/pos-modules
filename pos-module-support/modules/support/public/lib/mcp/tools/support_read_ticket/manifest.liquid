    "description": "Read one support ticket by its number: its properties and the conversation, newest fifty messages, oldest first. Internal notes are included and are marked internal; everything else was sent to or by the customer. Read-only. A ticket in a department the connected team member may not read is reported as not found.",
    "input_schema": {"type":"object","additionalProperties":false,"required":["number"],"properties":{"number":{"type":"integer","minimum":1,"description":"the ticket number, as shown in the desk and in search results"}}},
