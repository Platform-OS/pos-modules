{% doc %}
  Sends one provider-neutral message through the adapter named by the
  email_provider setting (04 §0). Returns { ok, status, provider_message_id, error }.
  On a non-production instance the recipient guard may rewrite the recipients
  or refuse the send (#135).
  @param {boolean} [setup_test] - passed to the guard: true only for the
    Settings -> Email setup's test message (#135)
  @param {object} message - { from{email,name}, reply_to, to[{email,name}], cc[], subject, text, html, headers{}, attachments[], tag, custom_args{} }
{% enddoc %}
{% liquid
  assign result = { "ok": false, "status": 0, "provider_message_id": null, "error": null }

  function settings = 'modules/support/helpers/settings'
  assign provider = settings.email_provider
  if provider == blank
    assign result.error = 'email_provider_not_configured'
    return result
  endif

  if message.from.email == blank or message.to.size == 0 or message.subject == blank
    assign result.error = 'invalid_message'
    return result
  endif

  function guard = 'modules/support/helpers/email/recipient_guard', message: message, setup_test: setup_test
  if guard.action == 'block'
    assign result.error = 'non_production_recipient_blocked'
    log message.to, type: 'support.email_blocked_non_production'
    return result
  endif

  assign adapter = 'modules/support/commands/email/providers/' | append: provider | append: '/send'
  function result = adapter, message: guard.message
  return result
%}
