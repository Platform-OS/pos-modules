{% doc %}
  Runs one Settings → Email setup step (04 §0.1) and stores the outcome in
  the email_status setting. Constants are written last in the request,
  because constant_set can hide other constants for the rest of it.
  Returns { ok, notice, error }.
  @param {string} step - key | check | domain | inbound | test | check_inbound | events | rotate | enable | disable
  @param {object} params - The posted form
  @param {object} current_profile - The admin running the step
{% enddoc %}
{% liquid
  function settings = 'modules/support/helpers/settings'
  assign status = settings.email_status | default: {}
  assign result = { "ok": false, "notice": null, "error": null }
  assign provider = settings.email_provider
  assign providers = ["sendgrid"]
  if step != 'key' and provider == blank
    assign result.error = 'modules/support/settings_email.errors.provider'
    return result
  endif
  assign adapter = 'modules/support/commands/email/providers/' | append: provider

  case step
  when 'key'
    unless providers contains params.provider
      assign result.error = 'modules/support/settings_email.errors.provider'
      return result
    endunless
    assign key = params.api_key | strip
    if key.size < 20
      assign result.error = 'modules/support/settings_email.errors.key'
      return result
    endif
    function _ = 'modules/support/commands/settings/set', key: 'email_provider', value: params.provider
    assign region = params.region | default: 'global'
    function _ = 'modules/support/commands/settings/set', key: 'email_region', value: region
    assign status.key_ok = null
    assign status.key_last4 = key | slice: -4, 4
    function _ = 'modules/support/commands/settings/set', key: 'email_status', value: status
    graphql c = 'modules/support/constants/set', name: 'modules/support/EMAIL_API_KEY', value: key
    assign result.ok = true
    assign result.notice = 'modules/support/settings_email.notices.key_saved'

  when 'check'
    assign path = adapter | append: '/check'
    function checked = path
    assign status.key_ok = checked.ok
    assign status.problems = checked.problems
    assign status.domains = checked.domains
    assign status.checked_at = 'now' | to_time
    function _ = 'modules/support/commands/settings/set', key: 'email_status', value: status
    assign result.ok = checked.ok
    if checked.ok
      assign result.notice = 'modules/support/settings_email.notices.key_ok'
    else
      assign result.error = 'modules/support/settings_email.errors.check'
    endif

  when 'domain'
    assign domain = params.sending_domain | downcase | strip
    assign known = status.domains | map: 'domain'
    unless known contains domain
      assign result.error = 'modules/support/settings_email.errors.domain'
      return result
    endunless
    function _ = 'modules/support/commands/settings/set', key: 'sending_domain', value: domain
    assign result.ok = true
    assign result.notice = 'modules/support/settings_email.notices.domain_saved'

  when 'inbound'
    assign hostname = params.inbound_domain | downcase | strip
    assign sending = settings.sending_domain | prepend: '.'
    assign start = 0 | minus: sending.size
    assign tail = hostname | slice: start, sending.size
    if hostname == blank or settings.sending_domain == blank or tail != sending
      assign result.error = 'modules/support/settings_email.errors.inbound_domain'
      return result
    endif
    assign secret = context.constants['modules/support/INBOUND_SECRET']
    assign new_secret = false
    if secret == blank
      assign secret = 32 | random_string | append: 'x' | compute_hmac: 'support-inbound' | slice: 0, 48
      assign new_secret = true
    endif
    assign url = 'https://' | append: context.location.host | append: '/api/support/inbound/' | append: provider | append: '/' | append: secret
    assign path = adapter | append: '/create_inbound'
    function created = path, hostname: hostname, url: url
    function _ = 'modules/support/commands/settings/set', key: 'inbound_domain', value: hostname
    assign status.inbound_created = created.ok
    assign status.inbound_error = created.error
    function _ = 'modules/support/commands/settings/set', key: 'email_status', value: status
    if new_secret
      graphql c = 'modules/support/constants/set', name: 'modules/support/INBOUND_SECRET', value: secret
    endif
    assign result.ok = created.ok
    if created.ok
      assign result.notice = 'modules/support/settings_email.notices.inbound_created'
    else
      assign result.error = 'modules/support/settings_email.errors.inbound_create'
    endif

  when 'test'
    graphql r = 'modules/support/records/find_by', table: 'modules/support/department', name: 'is_default', value: 'true'
    assign department = r.records.results.first.properties
    assign from_address = department.from_address
    if from_address == blank
      assign from_address = 'support@' | append: settings.sending_domain
    endif
    function brand = 'modules/support/helpers/branding'
    assign from = { "email": null, "name": null }
    assign from.email = from_address
    assign from.name = department.from_name | default: brand.support_email_name
    assign to = []
    assign recipient = { "email": null }
    assign recipient.email = current_profile.email | default: current_profile.user.email
    assign to << recipient
    assign subject = 'modules/support/settings_email.test_subject' | t: brand: brand.app_name
    assign text = 'modules/support/settings_email.test_body' | t
    assign message = { "html": null, "headers": {} }
    assign message.from = from
    assign message.to = to
    assign message.subject = subject
    assign message.text = text
    function sent = 'modules/support/commands/email/send', message: message
    assign status.test_ok = sent.ok
    assign status.test_error = sent.error
    assign status.test_sent_at = 'now' | to_time
    function _ = 'modules/support/commands/settings/set', key: 'email_status', value: status
    assign result.ok = sent.ok
    if sent.ok
      assign result.notice = 'modules/support/settings_email.notices.test_sent'
    else
      assign result.error = 'modules/support/settings_email.errors.test'
    endif

  when 'check_inbound'
    if settings.inbound_domain == blank
      assign result.error = 'modules/support/settings_email.errors.inbound_domain'
      return result
    endif
    assign token = 10 | random_string | downcase
    assign check_address = 'check-' | append: token | append: '@' | append: settings.inbound_domain
    assign from_address = 'support@' | append: settings.sending_domain
    assign from = { "email": null, "name": "Support check" }
    assign from.email = from_address
    assign to = []
    assign recipient = { "email": null }
    assign recipient.email = check_address
    assign to << recipient
    assign message = { "subject": "Inbound check", "text": "Inbound check from the support desk setup.", "html": null, "headers": {} }
    assign message.from = from
    assign message.to = to
    assign status.inbound_checked = false
    assign status.inbound_check_sent_at = 'now' | to_time
    function _ = 'modules/support/commands/settings/set', key: 'email_status', value: status
    function sent = 'modules/support/commands/email/send', message: message
    assign result.ok = sent.ok
    if sent.ok
      assign result.notice = 'modules/support/settings_email.notices.inbound_check_sent'
    else
      assign result.error = 'modules/support/settings_email.errors.test'
    endif

  when 'events'
    assign secret = context.constants['modules/support/EVENTS_SECRET']
    assign new_secret = false
    if secret == blank
      assign seed = 32 | random_string
      assign secret = seed | compute_hmac: 'support-events' | slice: 0, 48
      assign new_secret = true
    endif
    assign url = 'https://' | append: context.location.host | append: '/api/support/email-events/' | append: provider | append: '/' | append: secret
    assign path = adapter | append: '/save_events_webhook'
    function saved = path, url: url, webhook_id: settings.event_webhook_id
    if saved.ok
      function _ = 'modules/support/commands/settings/set', key: 'event_webhook_id', value: saved.id
    endif
    assign status.events_ok = saved.ok
    assign status.events_error = saved.error
    function _ = 'modules/support/commands/settings/set', key: 'email_status', value: status
    if new_secret
      graphql c = 'modules/support/constants/set', name: 'modules/support/EVENTS_SECRET', value: secret
    endif
    assign result.ok = saved.ok
    if saved.ok
      assign result.notice = 'modules/support/settings_email.notices.events_saved'
    else
      assign result.error = 'modules/support/settings_email.errors.events'
    endif

  when 'rotate'
    assign current = context.constants['modules/support/INBOUND_SECRET']
    if settings.inbound_domain == blank or current == blank
      assign result.error = 'modules/support/settings_email.errors.rotate_setup'
      return result
    endif
    assign seed = 32 | random_string
    assign new_secret = seed | compute_hmac: current | slice: 0, 48
    assign expires = 'now' | add_to_time: 24, 'h' | strftime: '%Y-%m-%dT%H:%M:%SZ'
    function _ = 'modules/support/commands/settings/set', key: 'previous_inbound_secret', value: current
    function _ = 'modules/support/commands/settings/set', key: 'previous_secret_expires_at', value: expires
    assign url = 'https://' | append: context.location.host | append: '/api/support/inbound/' | append: provider | append: '/' | append: new_secret
    assign path = adapter | append: '/create_inbound'
    function updated = path, hostname: settings.inbound_domain, url: url
    assign status.rotated_at = 'now' | to_time
    assign status.rotation_provider_updated = updated.ok
    if updated.ok
      assign status.rotation_pending_url = null
    else
      assign status.rotation_pending_url = url
    endif
    function _ = 'modules/support/commands/settings/set', key: 'email_status', value: status
    assign provider_note = 'provider_updated'
    unless updated.ok
      assign provider_note = 'provider_not_updated'
    endunless
    function _ = 'modules/support/commands/ticket_events/log', ticket_id: null, actor_type: 'user', actor_id: current_profile.id, event_type: 'team_secret_rotated', from_value: null, to_value: null, reason: provider_note
    graphql c = 'modules/support/constants/set', name: 'modules/support/INBOUND_SECRET', value: new_secret
    assign result.ok = true
    if updated.ok
      assign result.notice = 'modules/support/settings_email.notices.rotated'
    else
      assign result.notice = 'modules/support/settings_email.notices.rotated_manual'
    endif

  when 'enable'
    if status.test_ok != true or status.inbound_checked != true
      assign result.error = 'modules/support/settings_email.errors.enable'
      return result
    endif
    assign status.enabled = true
    function _ = 'modules/support/commands/settings/set', key: 'email_status', value: status
    assign result.ok = true
    assign result.notice = 'modules/support/settings_email.notices.enabled'

  when 'disable'
    assign status.enabled = false
    function _ = 'modules/support/commands/settings/set', key: 'email_status', value: status
    assign result.ok = true
    assign result.notice = 'modules/support/settings_email.notices.disabled'

  else
    assign result.error = 'modules/support/settings_email.errors.step'
  endcase
  return result
%}
