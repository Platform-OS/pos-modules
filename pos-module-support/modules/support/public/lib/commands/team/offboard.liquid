{% doc %}
  After a member is disabled: re-assigns their open tickets by least-loaded
  assignment and removes their push subscriptions.
  @param {object} member - The disabled team_member
{% enddoc %}
{% liquid
  assign open_categories = ["new", "open", "pending", "on_hold"]
  graphql t = 'modules/support/tickets/search', assignee_id: member.profile_id, categories: open_categories, limit: 100
  assign actor = { "type": "system", "id": null, "member": null }
  assign reason = 'modules/support/team.reassigned_disabled' | t
  for ticket in t.records.results
    function _ = 'modules/support/commands/tickets/assign', ticket: ticket, assignee_id: null, reason: reason, actor: actor
    function _ = 'modules/support/commands/assignment/auto_assign', ticket_id: ticket.id
  endfor

  function profile = 'modules/user/queries/profiles/find', id: member.profile_id, user_id: null, uuid: null, first_name: null, last_name: null
  if profile.user_id != blank
    function subscriptions = 'modules/push_notifications/queries/subscriptions/search', user_id: profile.user_id, user_ids: null, active: null, limit: 50, page: 1
    for subscription in subscriptions.results
      function _ = 'modules/push_notifications/commands/subscriptions/delete', id: subscription.id, endpoint: null
    endfor
  endif
  return t.records.total_entries
%}
