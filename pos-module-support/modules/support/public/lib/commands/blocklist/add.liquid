{% doc %}
  Blocks an address ("x@y.com") or a domain ("y.com", subdomains included)
  (D-27). A free-mail domain needs confirm_free_mail. Adding a pattern that
  is already blocked returns the existing row.
  Returns { valid, error, record }.
  @param {string} pattern - Address or domain as typed
  @param {string} [reason] - Shown in Settings → Blocklist
  @param {string} source - manual | spam_mark
  @param {string} [ticket_id] - The ticket marked as spam
  @param {string} [actor_id] - Profile id of the member
  @param {boolean} [confirm_free_mail] - Confirms blocking a free-mail domain
{% enddoc %}
{% liquid
  assign result = { "valid": false, "error": null, "record": null }
  assign pattern = pattern | downcase | strip
  assign first = pattern | slice: 0
  if first == '@'
    assign pattern = pattern | remove_first: '@'
  endif
  assign kind = 'domain'
  if pattern contains '@'
    assign kind = 'address'
    assign ok = pattern | matches: '^[^@\s]+@[a-z0-9-]+(\.[a-z0-9-]+)+$'
  else
    assign ok = pattern | matches: '^[a-z0-9-]+(\.[a-z0-9-]+)+$'
  endif
  unless ok
    assign result.error = 'modules/support/blocklist.errors.pattern'
    return result
  endunless
  if kind == 'domain' and source == 'spam_mark'
    assign result.error = 'modules/support/blocklist.errors.pattern'
    return result
  endif
  if kind == 'domain' and confirm_free_mail != true
    function settings = 'modules/support/helpers/settings'
    if settings.free_mail_domains contains pattern
      assign result.error = 'modules/support/blocklist.errors.free_mail'
      return result
    endif
  endif

  assign patterns = []
  assign patterns << pattern
  graphql existing = 'modules/support/blocked_senders/search', patterns: patterns, limit: 1
  if existing.records.results.size > 0
    assign result.valid = true
    assign result.record = existing.records.results.first
    return result
  endif
  assign reason = reason | strip | truncate: 200, ''
  graphql created = 'modules/support/blocked_senders/create', pattern: pattern, kind: kind, reason: reason, source: source, ticket_id: ticket_id, created_by_id: actor_id
  assign result.valid = true
  assign result.record = created.record
  return result
%}
