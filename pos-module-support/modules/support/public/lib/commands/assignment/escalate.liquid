{% doc %}
  Escalation job for a ticket nobody could take (06 §4). Exits when the
  ticket was assigned or closed meanwhile. alert: publishes
  support_ticket_unassigned for the managers' alert. assign_on_duty: assigns
  the on-duty manager, else alerts again.
  @param {string} ticket_id - The ticket
  @param {string} stage - alert | assign_on_duty
{% enddoc %}
{% liquid
  function ticket = 'modules/support/queries/tickets/find', id: ticket_id, number: null, member: null
  assign closed_categories = ["solved", "closed"]
  if ticket == blank or ticket.assignee_id != blank or closed_categories contains ticket.category
    return null
  endif

  if stage == 'assign_on_duty'
    function on_duty = 'modules/support/queries/team_members/on_duty'
    if on_duty
      assign actor = { "type": "system", "id": null, "member": null }
      assign reason = 'modules/support/assignment.on_duty' | t
      function assigned = 'modules/support/commands/tickets/assign', ticket: ticket, assignee_id: on_duty.profile_id, reason: reason, actor: actor
      if assigned.valid
        return 'assigned'
      endif
    endif
  endif

  function _ = 'modules/support/commands/ticket_events/log', ticket_id: ticket.id, actor_type: 'system', actor_id: null, event_type: 'escalated', from_value: null, to_value: stage, reason: null
  assign payload = { "ticket_id": null, "stage": null }
  assign payload.ticket_id = ticket.id
  assign payload.stage = stage
  function _ = 'modules/core/commands/events/publish', type: 'support_ticket_unassigned', object: payload, delay: null, max_attempts: null
  return 'alerted'
%}
