{% doc %}
  Creates a ticket (05 §1): next number, status New, default priority p2,
  search_text, audit row and support_ticket_created.
  Build/Check/Execute: create/build, create/check, create/execute.
  Returns the ticket (valid true), or the object with valid false and errors.
  @param {object} object - { subject, department_id, requester_id, organization_id?, channel, priority?, follow_up_of_id?, actor_type, actor_id, auto_reply? }
{% enddoc %}
{% liquid
  function object = 'modules/support/commands/tickets/create/build', object: object
  function object = 'modules/support/commands/tickets/create/check', object: object
  unless object.valid
    return object
  endunless
  function ticket = 'modules/support/commands/tickets/create/execute', object: object
  return ticket
%}
