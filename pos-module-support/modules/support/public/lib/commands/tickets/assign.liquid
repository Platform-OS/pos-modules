{% doc %}
  Assigns a ticket (05 §1). Refuses an assignee who is not an active member
  serving the ticket's department; an agent may take a ticket or give up
  their own unless they hold support.tickets.manage.all
  (queries/tickets/assignee_error). A blank assignee unassigns.
  Build/Check/Execute: assign/build, assign/check, assign/execute.
  Returns { valid, errors, ticket, warning }.
  @param {object} ticket - Ticket loaded through queries/tickets/find
  @param {string} [assignee_id] - Profile id, blank to unassign
  @param {string} [reason] - Shown in the activity log, default "manual"
  @param {object} actor - { type, id, member }
{% enddoc %}
{% liquid
  assign result = { "valid": false, "errors": {}, "ticket": null, "warning": null }
  function object = 'modules/support/commands/tickets/assign/build', ticket: ticket, assignee_id: assignee_id, reason: reason, actor: actor
  function object = 'modules/support/commands/tickets/assign/check', object: object
  unless object.valid
    assign result.errors = object.errors
    return result
  endunless
  function saved = 'modules/support/commands/tickets/assign/execute', object: object
  assign result.valid = true
  assign result.ticket = saved
  return result
%}
