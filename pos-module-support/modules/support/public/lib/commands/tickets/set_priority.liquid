{% doc %}
  Changes priority (05 §1); SLA deadlines are recomputed by the SLA engine
  on support_ticket_priority_changed.
  @param {object} ticket - Ticket loaded through queries/tickets/find
  @param {string} priority - p0 | p1 | p2 | p3
  @param {object} actor - { type, id, member }
{% enddoc %}
{% liquid
  assign result = { "valid": false, "errors": {}, "ticket": null }
  assign priorities = ["p0", "p1", "p2", "p3"]
  unless priorities contains priority
    assign result.errors.priority = 'modules/support/tickets.errors.priority'
    return result
  endunless
  if priority == ticket.priority
    assign result.valid = true
    assign result.ticket = ticket
    return result
  endif

  assign values = { "priority": null }
  assign values.priority = priority
  function saved = 'modules/support/commands/tickets/save', ticket: ticket, values: values
  function _ = 'modules/support/commands/ticket_events/log', ticket_id: ticket.id, actor_type: actor.type, actor_id: actor.id, event_type: 'priority_changed', from_value: ticket.priority, to_value: priority, reason: null
  assign payload = { "ticket_id": null, "actor_id": null, "to_value": null }
  assign payload.ticket_id = ticket.id
  assign payload.actor_id = actor.id
  assign payload.to_value = priority
  function _ = 'modules/core/commands/events/publish', type: 'support_ticket_priority_changed', object: payload, delay: null, max_attempts: null

  assign result.valid = true
  assign result.ticket = saved
  return result
%}
