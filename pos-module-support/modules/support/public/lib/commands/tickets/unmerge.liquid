{% doc %}
  Reverses a merge within 30 days: moves the source's messages back and
  reopens the source in In progress.
  Check/Execute: unmerge/check, unmerge/execute (the input needs no building).
  Returns { valid, errors, ticket }.
  @param {object} source - The merged ticket, loaded through queries/tickets/find
  @param {object} actor - { type, id, member }
{% enddoc %}
{% liquid
  assign result = { "valid": false, "errors": {}, "ticket": null }
  assign object = { "source": null, "actor": null }
  assign object.source = source
  assign object.actor = actor
  function object = 'modules/support/commands/tickets/unmerge/check', object: object
  unless object.valid
    assign result.errors = object.errors
    return result
  endunless
  function saved = 'modules/support/commands/tickets/unmerge/execute', object: object
  assign result.valid = true
  assign result.ticket = saved
  return result
%}
