{% doc %}
  Merges one contact into another (CO-2): the source's tickets, customer
  messages and CC rows move to the target, its addresses are added to the
  target's, and the source is deleted. Returns { valid, error, target }.
  @param {object} source - Contact to merge away
  @param {object} target - Contact that stays
{% enddoc %}
{% liquid
  assign result = { "valid": false, "error": null, "target": null }
  if source.id == blank or target.id == blank or source.id == target.id
    assign result.error = 'modules/support/contacts.errors.merge_self'
    return result
  endif

  graphql moved = 'modules/support/contacts/merge_move', source_id: source.id, target_id: target.id
  assign emails = target.emails | concat: source.emails | uniq
  assign values = { "emails": null }
  assign values.emails = emails
  if target.organization_id == blank and source.organization_id != blank
    assign values.organization_id = source.organization_id
  endif
  if target.phone == blank and source.phone != blank
    assign values.phone = source.phone
  endif
  function props = 'modules/support/helpers/props', values: values
  graphql u = 'modules/support/records/update', id: target.id, properties: props
  graphql d = 'modules/support/contacts/delete', id: source.id

  assign moved_count = moved.tickets.count | append: ''
  function _ = 'modules/support/commands/ticket_events/log', ticket_id: null, actor_type: 'system', actor_id: null, event_type: 'contacts_merged', from_value: source.id, to_value: target.id, reason: moved_count
  assign result.valid = true
  assign result.target = target | hash_merge: values
  return result
%}
