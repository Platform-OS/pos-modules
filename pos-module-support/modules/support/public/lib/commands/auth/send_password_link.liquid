{% doc %}
  "Forgot your password?" on the desk: emails a one-hour reset link that opens
  the desk's own form (/support-desk/password/new), sent through the desk's
  email provider like every other desk email. An unknown address sends
  nothing; the caller shows the same confirmation either way, so the page
  never tells whether an account exists. Returns true when a link was sent.
  @param {string} email - The address typed on the form
  @param {object} hcaptcha_params - Request params (pos-module-user checks hCaptcha when it is on)
{% enddoc %}
{% liquid
  assign address = email | strip | downcase
  if address == blank
    return false
  endif
  function link = 'modules/user/commands/authentication_links/create', email: address, host: context.location.host, hcaptcha_params: hcaptcha_params, valid_for: null
  unless link.valid
    return false
  endunless

  function settings = 'modules/support/helpers/settings'
  assign encoded_email = address | url_encode
  assign url = settings.base_url | append: '/support-desk/password/new?token=' | append: link.token | append: '&email=' | append: encoded_email
  function brand = 'modules/support/helpers/branding'
  assign heading = 'modules/support/password.email_heading' | t: brand: brand.app_name
  assign body = 'modules/support/password.email_body' | t
  assign label = 'modules/support/password.email_button' | t
  capture html
    render 'modules/support/emails/team', brand: brand, heading: heading, body: body, link: url, link_label: label
  endcapture
  function _ = 'modules/support/commands/email/send_simple', to_email: address, to_name: null, subject: heading, html: html, text: url
  return true
%}
