{% doc %}
  Sets a new password from the desk's reset form. The desk asks for at least
  12 characters, as on an invitation; pos-module-user's own checks (match,
  complexity) run as well. Does not sign the person in: they sign in on the
  desk's sign-in page, where two-factor authentication still applies.
  Returns { valid, error } with a translation key in error.
  @param {string} user_id - The account the reset link was for
  @param {string} password - New password
  @param {string} password_confirmation - The same password again
{% enddoc %}
{% liquid
  assign result = { "valid": false, "error": null }
  if user_id == blank
    assign result.error = 'modules/support/password.expired'
    return result
  endif
  if password.size < 12
    assign result.error = 'modules/support/team.errors.password'
    return result
  endif
  if password != password_confirmation
    assign result.error = 'modules/support/password.mismatch'
    return result
  endif
  assign input = { "user_id": null, "password": null, "password_confirmation": null }
  assign input.user_id = user_id
  assign input.password = password
  assign input.password_confirmation = password_confirmation
  function object = 'modules/user/commands/passwords/create', object: input
  unless object.valid
    assign result.error = 'modules/support/password.rejected'
    return result
  endunless
  assign result.valid = true
  return result
%}
