{% doc %}
  Public agent reply (05 §1): stores the message as queued, updates the
  ticket (first_replied_at once, needs_reply off, last_agent_reply_at),
  optionally changes status, then delivers the email in the background.
  Build/Check/Execute: create_reply/build, check, execute.
  Returns { valid, errors, message, ticket }.
  @param {object} ticket - Ticket loaded through queries/tickets/find
  @param {string} body_html - Reply HTML from the composer
  @param {string[]} [cc_emails] - Extra recipients
  @param {string} [then_status_key] - Status after sending
  @param {object[]} [attachments] - [{ filename, content_type, content_base64 }], 10 MB in total
  @param {object} actor - { type, id, member }
{% enddoc %}
{% liquid
  assign result = { "valid": false, "errors": {}, "message": null, "ticket": null }
  function object = 'modules/support/commands/messages/create_reply/build', ticket: ticket, body_html: body_html, cc_emails: cc_emails, then_status_key: then_status_key, attachments: attachments, actor: actor
  function object = 'modules/support/commands/messages/create_reply/check', object: object
  unless object.valid
    assign result.errors = object.errors
    return result
  endunless
  function done = 'modules/support/commands/messages/create_reply/execute', object: object
  assign result.valid = true
  assign result.message = done.message
  assign result.ticket = done.ticket
  return result
%}
