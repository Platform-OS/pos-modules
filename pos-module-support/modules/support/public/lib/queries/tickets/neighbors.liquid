{% doc %}
  Position of a ticket in the queue page it was opened from, and the
  tickets before and after it, so the ticket page can offer previous/next.
  Returns null when the request carries no queue view.
  @param {object} member - The acting team_member
  @param {object} params - Request params: view, q, priority, status_key, department_id, assignee_id, sort, page
  @param {string} ticket_id - The ticket shown
{% enddoc %}
{% liquid
  assign views = "mine,needs_reply,unassigned,all_open,waiting,awaiting_confirmation,sla_at_risk,deploy,closed" | split: ','
  unless views contains params.view
    return null
  endunless

  assign filters = { "department_id": null, "priority": null, "status_key": null, "assignee_id": null, "organization_id": null, "q": null }
  assign filters.department_id = params.department_id
  assign filters.priority = params.priority
  assign filters.status_key = params.status_key
  assign filters.q = params.q | strip
  assign filters.assignee_id = params.assignee_id
  assign sorts = "sla,priority,newest,oldest,activity" | split: ','
  if sorts contains params.sort
    assign filters.sort = params.sort
  endif
  assign page = params.page | default: 1 | plus: 0 | at_least: 1
  assign per_page = 50
  assign groupings = ["priority", "status"]
  if groupings contains params.group
    # the list in swim lanes: the order is lane by lane, as shown
    assign page = 1
    function grouped = 'modules/support/queries/tickets/groups', member: member, view: params.view, filters: filters, by: params.group, layout: 'list', expand: null, expand_page: null
    assign ids = []
    for group in grouped.groups
      assign ids = ids | concat: group.tickets
    endfor
    assign ids = ids | map: 'id'
    assign data = { "total_entries": null }
    assign data.total_entries = grouped.total
  else
    function data = 'modules/support/queries/tickets/search', member: member, view: params.view, filters: filters, page: page, per_page: per_page, skip_lookup: true, include_waiting: false
    assign ids = data.results | map: 'id'
  endif

  assign index = -1
  for id in ids
    if id == ticket_id
      assign index = forloop.index0
    endif
  endfor
  if index < 0
    return null
  endif

  assign query = { "view": null, "q": null, "priority": null, "status_key": null, "department_id": null, "assignee_id": null, "sort": null, "group": null, "page": null }
  if groupings contains params.group
    assign query.group = params.group
  endif
  assign query.assignee_id = filters.assignee_id
  assign query.sort = filters.sort
  assign query.view = params.view
  assign query.q = filters.q
  assign query.priority = filters.priority
  assign query.status_key = filters.status_key
  assign query.department_id = filters.department_id
  assign query.page = page
  assign result = { "position": null, "total": null, "prev_id": null, "next_id": null, "query": null, "view": null }
  assign result.query = query | www_form_encode
  assign result.view = params.view
  assign result.total = data.total_entries
  assign result.position = page | minus: 1 | times: per_page | plus: index | plus: 1
  if index > 0
    assign prev_index = index | minus: 1
    assign result.prev_id = ids[prev_index]
  endif
  assign last = ids.size | minus: 1
  if index < last
    assign next_index = index | plus: 1
    assign result.next_id = ids[next_index]
  endif
  return result
%}
