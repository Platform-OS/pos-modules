{% doc %}
  Departments for the rail, each with the number of tickets it has in the
  current view and filters, plus the total for "All departments".
  Returns { all, departments: [{ id, name, short_code, count }] }.
  @param {object} member - The acting team_member
  @param {string} view - Queue view key
  @param {object} filters - Current filters; department_id is ignored
  @param {boolean} include_waiting - Same meaning as in queries/tickets/search (the board of All open)
{% enddoc %}
{% liquid
  function permissions = 'modules/support/queries/team/role_permissions'
  assign all_departments = false
  if permissions[member.role] contains 'support.tickets.manage.all'
    assign all_departments = true
  endif
  graphql d = 'modules/support/departments/search', limit: 100

  assign counting = filters | hash_merge: {}
  assign counting.department_id = null
  function everything = 'modules/support/queries/tickets/search', member: member, view: view, filters: counting, page: 1, per_page: 1, skip_lookup: true, include_waiting: include_waiting

  assign result = { "all": 0, "departments": [] }
  assign result.all = everything.total_entries
  for department in d.records.results
    unless department.active
      continue
    endunless
    unless all_departments or member.department_ids contains department.id
      continue
    endunless
    assign counting.department_id = department.id
    function page = 'modules/support/queries/tickets/search', member: member, view: view, filters: counting, page: 1, per_page: 1, skip_lookup: true, include_waiting: include_waiting
    assign item = { "id": null, "name": null, "short_code": null, "count": 0 }
    assign item.id = department.id
    assign item.name = department.name
    assign item.short_code = department.short_code
    assign item.count = page.total_entries
    assign result.departments << item
  endfor
  return result
%}
