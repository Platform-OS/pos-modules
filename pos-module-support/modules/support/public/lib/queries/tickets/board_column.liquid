{% doc %}
  One board column (D-26): tickets in a status within the member's scope,
  ordered P0 → P3, then newest first. Returns { status, tickets, total }.
  @param {object} status - Status record
  @param {string[]} [scope] - Department ids, null for all
  @param {object} filters - { priority, assignee_id, q }
  @param {number} [limit] - Cards to load, default 50
{% enddoc %}
{% liquid
  assign limit = limit | default: 50 | at_most: 200
  assign ids = []
  assign ids << status.id
  assign sort = [{ "properties": { "name": "priority", "order": "ASC" } }, { "created_at": { "order": "DESC" } }]
  graphql r = 'modules/support/tickets/search', status_ids: ids, department_ids: scope, priority: filters.priority, assignee_id: filters.assignee_id, query: filters.q, limit: limit, sort: sort
  assign column = { "status": null, "tickets": [], "total": 0 }
  assign column.status = status
  assign column.tickets = r.records.results
  assign column.total = r.records.total_entries
  return column
%}
