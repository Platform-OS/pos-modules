{% doc %}
  The board (05 §2, D-26): a column per active status in status order;
  closed-category columns only when show_closed. Returns
  { columns, lookup, filters, show_closed }.
  @param {object} member - The acting team_member
  @param {object} filters - { department_id, priority, assignee_id, q }
  @param {boolean} [show_closed] - Include Closed and Spam
  @param {string} [expand_status] - Status key whose column loads 200 cards
{% enddoc %}
{% liquid
  function scope = 'modules/support/queries/tickets/scope', member: member, department_id: filters.department_id
  function statuses = 'modules/support/queries/statuses/all'
  assign priorities = ["p0", "p1", "p2", "p3"]
  unless priorities contains filters.priority
    assign filters.priority = null
  endunless

  assign board = { "columns": [], "show_closed": false }
  assign board.show_closed = show_closed
  assign all_tickets = []
  for status in statuses.list
    if status.active == false
      continue
    endif
    if status.category == 'closed' and show_closed != true
      continue
    endif
    assign limit = 50
    if expand_status == status.key
      assign limit = 200
    endif
    function column = 'modules/support/queries/tickets/board_column', status: status, scope: scope, filters: filters, limit: limit
    assign board.columns << column
    assign all_tickets = all_tickets | concat: column.tickets
  endfor
  function lookup = 'modules/support/queries/tickets/lookup', tickets: all_tickets
  assign board.lookup = lookup
  assign board.filters = filters
  return board
%}
