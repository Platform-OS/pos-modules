{% doc %}
  Whether a secret from the inbound webhook URL is accepted (04 §0.2,
  D-28): the current INBOUND_SECRET, or the previous one until
  previous_secret_expires_at. Compared as HMAC digests.
  @param {string} [given] - Secret from the URL
  @param {string} [current] - Current secret, default the constant
  @param {object} [settings] - From helpers/settings, default loaded
{% enddoc %}
{% liquid
  assign current = current | default: context.constants['modules/support/INBOUND_SECRET']
  assign given = given | append: ''
  if current == blank or given == blank
    return false
  endif
  assign given_digest = given | compute_hmac: current
  assign current_digest = current | compute_hmac: current
  if given_digest == current_digest
    return true
  endif

  if settings == blank
    function settings = 'modules/support/helpers/settings'
  endif
  assign previous = settings.previous_inbound_secret
  if previous == blank or settings.previous_secret_expires_at == blank
    return false
  endif
  assign expires = settings.previous_secret_expires_at | to_time
  assign now = 'now' | to_time
  if expires <= now
    return false
  endif
  assign previous_digest = previous | compute_hmac: current
  if given_digest == previous_digest
    return true
  endif
  return false
%}
