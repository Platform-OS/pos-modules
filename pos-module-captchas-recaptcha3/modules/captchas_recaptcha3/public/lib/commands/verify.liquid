{% doc %}
  @description Verify command for Google reCAPTCHA v3: POST the token to siteverify via
    api_call_send, then apply the v3 score/action checks (helpers/score_check). Passes only
    when the provider reports success, the score meets the threshold, and (if expected_action
    is given) the action matches. Part of the captchas provider contract — dispatched by
    modules/captchas/commands/captcha/verify/execute.
  @param {object} object - validated object: { secret, token, remote_ip, errors, min_score, expected_action }.
    min_score defaults to 0.5; expected_action is optional.
  @returns {object} object with success (boolean), score (number), action (string), response (hash),
    valid, and errors (translated messages, via modules/captchas/helpers/add_error).
{% enddoc %}
{% liquid
  assign payload = { "secret": object.secret, "token": object.token, "remote_ip": object.remote_ip }

  graphql result = 'modules/captchas_recaptcha3/api_call/send', data: payload, name: 'modules/captchas_recaptcha3/siteverify'

  assign call = result.api_call_send

  if call.errors != blank
    function updated_errors = 'modules/captchas/helpers/add_error', errors: object.errors, field_name: 'captcha', key: 'modules/captchas/errors.request_failed'
    assign object.errors = updated_errors
    assign object.success = false
    assign object.valid = false
    return object
  endif

  assign status = call.response.status
  if status != 200
    function updated_errors = 'modules/captchas/helpers/add_error', errors: object.errors, field_name: 'captcha', key: 'modules/captchas/errors.request_failed'
    assign object.errors = updated_errors
    assign object.success = false
    assign object.valid = false
    return object
  endif

  # A 200 with a non-JSON body (provider outage, proxy error page) must fail closed as
  # request_failed rather than blow up in parse_json or turn into a misleading
  # verification_failed on a nil body.
  assign raw_body = call.response.body | strip
  assign first_char = raw_body | slice: 0, 1
  if first_char != '{'
    function updated_errors = 'modules/captchas/helpers/add_error', errors: object.errors, field_name: 'captcha', key: 'modules/captchas/errors.request_failed'
    assign object.errors = updated_errors
    assign object.success = false
    assign object.valid = false
    return object
  endif
  assign body = raw_body | parse_json

  assign object.response = body
  assign object.success = body.success
  assign object.score = body.score
  assign object.action = body.action

  function score_result = 'modules/captchas_recaptcha3/helpers/score_check', body: body, min_score: object.min_score, expected_action: object.expected_action, errors: object.errors
  assign object.valid = score_result.valid
  assign object.errors = score_result.errors

  return object
%}
