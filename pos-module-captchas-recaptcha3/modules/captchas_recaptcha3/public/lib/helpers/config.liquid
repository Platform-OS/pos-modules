{% doc %}
  @description Provider config for Google reCAPTCHA v3. Part of the captchas provider
    contract: returns a hash with at least response_field — the form field the widget
    writes the token into (the hidden input the v3 script injects).
  @returns {object} config hash: { response_field }
{% enddoc %}
{% liquid
  assign config = '{"response_field": "g-recaptcha-response"}' | parse_json
  return config
%}
