{% doc %}
  @param object {object} - email payload (email, sign_up_url)
  @param site_name {string} - site name shown in subject line
  @param from {string} - sender email address
{% enddoc %}
{% liquid
  assign subject = 'modules/user_invites/emails.invitation_subject' | t: site_name: site_name
  assign object = {
    "to": object.email,
    "from": from,
    "subject": subject,
    "partial": "modules/user_invites/emails/user_invites/user_invite",
    "layout": context.constants.USER_INVITES_MAILER_LAYOUT,
    "data": {
      "sign_up_url": object.sign_up_url,
      "email": object.email
    }
  }

  function object = 'modules/core/commands/email/send', object: object
  return object
%}
