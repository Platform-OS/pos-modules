{% comment %}
  @prompt: Renders the "invitations queued" confirmation after a send.
           Required: sent_count (integer)
{% endcomment %}
<div class="container">
  <h2 class="pb-4 font-extrabold text-3xl">{{ 'modules/user_invites/admin.invite_users.queued_heading' | t }}</h2>
  <p class="mb-4">
    {{ 'modules/user_invites/admin.invite_users.queued_message' | t: count: sent_count }}
  </p>
  <a href="/admin/community/invite_users" class="underline">{{ 'modules/user_invites/admin.invite_users.back_to_list' | t }}</a>
</div>
