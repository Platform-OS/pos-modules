{% comment %}
  Unit test (no network): the provider contract surface of captchas_recaptcha.
  config must expose reCAPTCHA's default response field, and the provider.name translation
  (the abstraction's installation probe) must resolve.
{% endcomment %}
{% liquid
  function config = 'modules/captchas_recaptcha/helpers/config'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: config.response_field, expected: 'g-recaptcha-response', field_name: 'response_field'

  assign probe = 'modules/captchas_recaptcha/provider.name' | t: default: ''
  function contract = 'modules/tests/assertions/equal', contract: contract, given: probe, expected: 'Google reCAPTCHA v2', field_name: 'provider_name_probe'

  function available = 'modules/captchas/helpers/provider_available', provider: 'recaptcha'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: available, expected: true, field_name: 'provider_available'
%}
